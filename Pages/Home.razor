    /// <summary>
    /// Déplace l'onglet glissé à la position de l'onglet cible lorsqu'on relâche la souris.
    /// </summary>
    private void OnTabDrop(FactoryTab targetTab)
    {
        if (_draggedTab != null && _draggedTab != targetTab)
        {
            int oldIndex = Tabs.IndexOf(_draggedTab);
            int newIndex = Tabs.IndexOf(targetTab);

            if (oldIndex >= 0 && newIndex >= 0)
            {
                Tabs.RemoveAt(oldIndex);
                Tabs.Insert(newIndex, _draggedTab);
                FlowEngine.RegisterTabs(Tabs);
            }
        }

        _draggedTab = null;
        _dragOverTab = null;
        StateHasChanged();
    }

