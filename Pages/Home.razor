@page "/"
@inject HttpClient Http
@inject ResourceService ResourceService
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@using System.Text.Json

@implements IDisposable
@using Blazor.Diagrams
@using Blazor.Diagrams.Options
@using Blazor.Diagrams.Core.Anchors
@using Blazor.Diagrams.Core.Behaviors
@using Blazor.Diagrams.Core.Models
@using Blazor.Diagrams.Core.Models.Base
@using Blazor.Diagrams.Core.Geometry
@using Blazor.Diagrams.Components

@using CaptainArchitect.Models
@using CaptainArchitect.Components
@using CaptainArchitect.Services


<!-- Conteneur plein écran sombre sans marge ni débordement -->
<!-- Conteneur principal décalé de 48px pour ne pas passer sous MudAppBar -->
<div class="d-flex w-100 position-relative"
     style="height: calc(100vh - 48px); margin-top: 48px; background-color: #1e1e1e; overflow: hidden;">

    <!-- Bouton flottant pour ouvrir le tiroir si replié -->
    @if (!_drawerOpen)
    {
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       OnClick="@ToggleDrawer"
                       Class="drawer-toggle-btn"
                       Title="Ouvrir le catalogue" />
    }

    <!-- Tiroir latéral rétractable MudBlazor -->
    <MudDrawer @bind-Open="@_drawerOpen"
               ClipMode="DrawerClipMode.Never"
               Elevation="4"
               Variant="@DrawerVariant.Responsive"
               Width="340px"
               Class="pa-3 bg-dark-drawer d-flex flex-column h-100"
               Style="border-right: 1px solid #333; z-index: 200;">

        <!-- 1. ZONE FIXE DU HAUT DU TIROIR -->
        <div style="flex-shrink: 0;">

            <!-- En-tête : Titre + Bouton de fermeture -->
            <div class="d-flex align-center justify-space-between mb-2">
                <MudText Typo="Typo.subtitle1" Class="fw-bold" Style="color: #e4e4e7;">Recipe Catalog</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                               Size="MudBlazor.Size.Small"
                               Color="Color.Default"
                               OnClick="@ToggleDrawer"
                               Title="Fermer le panneau" />
            </div>

            <!-- Barre d'outils Fichier compacte et harmonisée -->
            <div class="toolbar-box mb-3 d-flex align-center justify-space-between px-2 py-1">

                <!-- 1. Bouton Sauvegarder -->
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           Size="MudBlazor.Size.Small"
                           Class="tool-btn"
                           OnClick="SaveDiagram">
                    Save
                </MudButton>

                <!-- 2. Bouton Charger : InputFile natif masqué + Bouton label propre -->
                <InputFile id="fileInputLoader" OnChange="LoadDiagram" accept=".json" style="display: none;" />

                <MudButton HtmlTag="label"
                           Variant="Variant.Outlined"
                           Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.FolderOpen"
                           Size="MudBlazor.Size.Small"
                           Class="tool-btn"
                           for="fileInputLoader">
                    Load
                </MudButton>

                <!-- 3. Bouton Nouveau projet (réinitialise toute l'usine après confirmation) -->
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.NoteAdd"
                           Size="MudBlazor.Size.Small"
                           Class="tool-btn"
                           OnClick="NewFactory">
                    New
                </MudButton>

                <!-- 4. Bouton Vider l'onglet actif -->
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteSweep"
                           Size="MudBlazor.Size.Small"
                           Class="tool-btn text-muted-hover"
                           OnClick="ClearDiagram">
                    Clear Tab
                </MudButton>

            </div>

            <!-- Menu pour ajouter un stockage avec filtre de recherche intégré -->
            <MudMenu Label="Add Storage"
                     StartIcon="@Icons.Material.Filled.Inventory2"
                     Variant="Variant.Filled"
                     Color="Color.Info"
                     Size="MudBlazor.Size.Small"
                     Dense="true"
                     MaxHeight="350"
                     Class="mb-2">

                <!-- 1. Champ de recherche épinglé en haut du menu -->
                <div class="px-2 pt-2 pb-1" @onclick:stopPropagation="true">
                    <MudTextField @bind-Value="_storageFilterText"
                                  Placeholder="Filter products..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  IconSize="MudBlazor.Size.Small"
                                  Immediate="true"
                                  Clearable="true"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </div>

                <MudDivider Class="my-1" />

                <!-- 2. Liste déroulante filtrée dynamiquement -->
                @if (FilteredStorageProducts.Any())
                {
                    @foreach (var prod in FilteredStorageProducts)
                    {
                        <MudMenuItem OnClick="@(() => AddStorageNode(prod.Id))">
                            <div class="d-flex align-center gap-2">
                                <ResourceBadge ProductId="@prod.Id" />
                                <span>@prod.Name</span>
                            </div>
                        </MudMenuItem>
                    }
                }
                else
                {
                    <!-- Message affiché si aucune ressource ne correspond -->
                    <div class="pa-2 text-center" style="color: #71717a; font-size: 0.8rem;">
                        No product found
                    </div>
                }
            </MudMenu>

            <!-- HISTORIQUE DES DERNIÈRES RECHERCHES -->
            @if (_recentProducts.Count > 0)
            {
                <div class="mb-2">

                    <!-- Titre compact pour l'historique -->
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1 fw-bold">
                        Search history :
                    </MudText>

                    <!-- Bandeau horizontal défilant avec les icônes (sans JS inline 'this') -->
                    <div class="d-flex align-center gap-1 overflow-x-auto pb-1 recent-search-bar">
                        
                        @foreach (var prod in _recentProducts)
                        {
                            <!-- 1. key force Blazor à recréer l'élément sans garder l'état d'erreur du précédent -->
                            <div @key="prod.Id"
                                 class="recent-item-badge"
                                 @onclick="@(() => SelectRecentProduct(prod))"
                                 title="@prod.Name">

                                @if (!_failedRecentImages.Contains(prod.Id))
                                {
                                    <img src="@GetProductImagePath(prod)"
                                         alt="@prod.Name"
                                         class="recent-item-icon"
                                         @onerror="@(() => MarkRecentImageFailed(prod.Id))" />
                                }
                                else
                                {
                                    <!-- Repli : affiche les 2-3 lettres si l'image est introuvable -->
                                    <span class="recent-item-fallback">
                                        @GetShortFallbackName(prod)
                                    </span>
                                }

                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Barre de recherche avec autocomplétion des produits -->
            <MudAutocomplete T="Product"
                             Placeholder="Find a product..."
                             SearchFunc="@SearchProducts"
                             ToStringFunc="@(p => p?.Name ?? string.Empty)"
                             Value="_selectedProduct"
                             ValueChanged="@OnProductSelected"
                             Clearable="true"
                             ResetValueOnEmptyText="true"
                             CoerceText="false"
                             CoerceValue="false"
                             Dense="true"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Adornment="Adornment.Start"
                             AdornmentIcon="@Icons.Material.Filled.Search"
                             MaxItems="300"
                             MaxHeight="300"
                             SelectValueOnTab="false"
                             @onkeyup="HandleSearchKeyDown"
                             Class="mb-2 search-autocomplete"
                             PopoverClass="autocomplete-popover-dark">

                <!-- Rendu personnalisé de chaque ligne dans la liste déroulante -->
                <ItemTemplate Context="prod">
                    <div class="d-flex align-center gap-2 py-1">

                        @if (!_failedRecentImages.Contains(prod.Id))
                        {
                            <img src="@GetProductImagePath(prod)"
                                 alt="@prod.Name"
                                 style="width: 24px; height: 24px; object-fit: contain; flex-shrink: 0;"
                                 @onerror="@(() => MarkRecentImageFailed(prod.Id))" />
                        }

                        <!-- Libellé du produit -->
                        <MudText Typo="Typo.body2">@prod.Name</MudText>

                    </div>
                </ItemTemplate>

                <!-- Message si aucun produit ne correspond à la saisie -->
                <NoItemsTemplate>
                    <MudText Typo="Typo.body2" Class="pa-2 text-muted">Aucun produit trouvé</MudText>
                </NoItemsTemplate>

            </MudAutocomplete>

            <!-- Filtres : Tout / Entrées / Sorties -->
            <MudToggleGroup T="ResourceFilterMode"
                            @bind-Value="_filterMode"
                            Color="Color.Primary"
                            CheckMark="false"
                            FixedContent="true"
                            Size="MudBlazor.Size.Small"
                            Class="mb-3 w-100 d-flex justify-center mode-toggle-group">
                <MudToggleItem Value="ResourceFilterMode.All" Text="All" Class="flex-grow-1 text-center" />
                <MudToggleItem Value="ResourceFilterMode.Input" Text="Input" Class="flex-grow-1 text-center" />
                <MudToggleItem Value="ResourceFilterMode.Output" Text="Output" Class="flex-grow-1 text-center" />
            </MudToggleGroup>

        </div>

        <!-- 2. ZONE SCROLLABLE DE LA LISTE DES RECETTES -->
        <div class="recipes-list flex-grow-1" style="overflow-y: auto; min-height: 0;">
            @if (FilteredRecipes != null)
            {
                <Virtualize Items="@FilteredRecipes.ToList()" Context="recipe">
                    <MudCard Class="mb-2 recipe-card" Outlined="true">
                        <MudCardContent Class="pa-2">

                            <div class="d-flex justify-space-between align-center">

                                <!-- Titre éclairci avec la classe recipe-title -->
                                <MudText Typo="Typo.subtitle2" Class="fw-bold recipe-title">@recipe.RecipeId</MudText>

                                <MudIconButton Icon="@Icons.Material.Filled.AddCircle"
                                               Color="Color.Primary"
                                               Size="MudBlazor.Size.Small"
                                               Title="Add to the diagram"
                                               OnClick="@(() => AddRecipeNode(recipe))" />
                            </div>

                            <!-- Entrées & Sorties -->
                            <div class="d-flex align-center gap-1 mt-1">

                                <!-- Libellé In: avec recipe-in-label -->
                                <MudText Typo="Typo.caption" Class="recipe-in-label me-1">In:</MudText>

                                @foreach (var input in recipe.Inputs)
                                {
                                    @if (!string.IsNullOrWhiteSpace(input.ProductId))
                                    {
                                        <ResourceBadge @key="@($"{recipe.RecipeId}_in_{input.ProductId}")"
                                                       ProductId="@input.ProductId" />
                                    }
                                }

                                <!-- Libellé Out: avec recipe-out-label -->
                                <MudText Typo="Typo.caption" Class="recipe-out-label ms-2 me-1">Out:</MudText>

                                @foreach (var output in recipe.Outputs)
                                {
                                    @if (!string.IsNullOrWhiteSpace(output.ProductId))
                                    {
                                        <ResourceBadge @key="@($"{recipe.RecipeId}_out_{output.ProductId}")"
                                                       ProductId="@output.ProductId" />
                                    }
                                }
                            </div>
                        </MudCardContent>
                    </MudCard>
                </Virtualize>
            }
            else
            {
                <MudProgressCircular Indeterminate="true" Size="MudBlazor.Size.Small" />
            }
        </div>

    </MudDrawer>


    <!-- =========================================================================
         ZONE PRINCIPALE À DROITE : BARRE D'ONGLETS EN HAUT + CANVAS EN DESSOUS
         ========================================================================= -->
    <div class="flex-grow-1 h-100 d-flex flex-column position-relative outline-none"
         style="background-color: #1a1a1a; min-width: 0; min-height: 0;"
         tabindex="0"
         @onkeydown="HandleKeyDown"
         @oncontextmenu:preventDefault="true">

        <!-- 1. BARRE D'ONGLETS D'USINE + PORTAILS INTER-ONGLETS (BUS) -->
        <!-- Décalée de 348px quand le tiroir est ouvert (340px) ou 54px quand il est fermé -->
        <div class="factory-tabs-bar d-flex align-center justify-space-between px-2 py-1"
             style="@(_drawerOpen ? "padding-left: 348px !important;" : "padding-left: 54px !important;")">

            <!-- Liste horizontale des onglets (réorganisable par glisser-déposer) -->
            <div class="d-flex align-center gap-1 flex-wrap" style="min-width: 0;">
                @foreach (var tab in Tabs)
                {
                    bool isActive = tab.Id == ActiveTab?.Id;
                    bool isDragging = _draggedTab?.Id == tab.Id;
                    bool isDragOver = _dragOverTab?.Id == tab.Id && _draggedTab?.Id != tab.Id;

                    <div @key="tab.Id"
                         draggable="true"
                         class="factory-tab-chip @(isActive ? "active" : "") @(isDragging ? "dragging" : "") @(isDragOver ? "drag-over" : "")"
                         title="Cliquer pour ouvrir • Glisser-déposer pour déplacer l'ordre"
                         @onclick="@(() => SelectTab(tab.Id))"
                         @ondragstart="@(() => OnTabDragStart(tab))"
                         @ondragover="@(() => OnTabDragOver(tab))"
                         @ondragover:preventDefault="true"
                         @ondrop="@(() => OnTabDrop(tab))"
                         @ondragend="OnTabDragEnd">

                         <!-- Icône de ressource si une icône a été choisie pour cet onglet -->
                        @if (!string.IsNullOrWhiteSpace(tab.IconProductId) && ProductDict.TryGetValue(tab.IconProductId, out var tabProd))
                        {
                            <img src="@GetProductImagePath(tabProd)"
                                 alt="@tab.Name"
                                 class="tab-resource-icon"
                                 draggable="false" />
                        }

                        <span class="tab-name">@tab.Name</span>

                        <!-- Bouton modifier le nom et l'icône de l'onglet -->
                        <button type="button"
                                draggable="false"
                                class="tab-action-btn edit"
                                title="Edit Tab Name & Icon"
                                @onclick="@(() => OpenEditTabModal(tab))"
                                @onclick:stopPropagation="true"
                                @ondragstart:stopPropagation="true">
                            ✎
                        </button>

                        <!-- Bouton supprimer l'onglet (affiché s'il y a au moins 2 onglets) -->
                        @if (Tabs.Count > 1)
                        {
                            <button type="button"
                                    draggable="false"
                                    class="tab-action-btn close"
                                    title="Delete Tab"
                                    @onclick="@(() => RemoveTab(tab))"
                                    @onclick:stopPropagation="true"
                                    @ondragstart:stopPropagation="true">
                                ✕
                            </button>
                        }

                    </div>
                }

                <!-- Bouton Ajouter un nouvel onglet -->
                <MudButton Variant="Variant.Text"
                           Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.Add"
                           Size="MudBlazor.Size.Small"
                           Class="tool-btn"
                           OnClick="AddNewTab">
                    Tab
                </MudButton>
            </div>

            <!-- Boutons Portails Bus (Export / Import entre onglets) -->
            <div class="d-flex align-center gap-2" style="flex-shrink: 0;">

                <!-- Menu Poser un Portail EXPORT -->
                <MudMenu Label="Export Bus"
                         StartIcon="@Icons.Material.Filled.Output"
                         Variant="Variant.Outlined"
                         Color="Color.Secondary"
                         Size="MudBlazor.Size.Small"
                         Dense="true"
                         MaxHeight="350">
                    <div class="px-2 pt-2 pb-1" @onclick:stopPropagation="true">
                        <MudTextField @bind-Value="_portalFilterText"
                                      Placeholder="Filtrer ressource..."
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      Clearable="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search" />
                    </div>
                    <MudDivider Class="my-1" />
                    @foreach (var prod in FilteredPortalProducts)
                    {
                        <MudMenuItem OnClick="@(() => AddExportPortalNode(prod.Id))">
                            <div class="d-flex align-center gap-2">
                                <ResourceBadge ProductId="@prod.Id" />
                                <span>@prod.Name</span>
                            </div>
                        </MudMenuItem>
                    }
                </MudMenu>

                <!-- Menu Poser un Portail IMPORT -->
                <MudMenu Label="Import Bus"
                         StartIcon="@Icons.Material.Filled.Input"
                         Variant="Variant.Filled"
                         Color="Color.Info"
                         Size="MudBlazor.Size.Small"
                         Dense="true"
                         MaxHeight="350">
                    @{
                        var allExports = GetAllExportPortals().ToList();
                    }
                    @if (allExports.Count == 0)
                    {
                        <MudMenuItem Disabled="true">Aucun Export créé dans les onglets</MudMenuItem>
                    }
                    else
                    {
                        @foreach (var item in allExports)
                        {
                            <MudMenuItem OnClick="@(() => AddImportPortalNode(item.Portal))">
                                <div class="d-flex align-center gap-2">
                                    <ResourceBadge ProductId="@item.Portal.ProductId" />
                                    <span><strong>[@item.TabName]</strong> @item.Portal.ChannelName (@item.Portal.TotalInputRate.ToString("0.#")/m)</span>
                                </div>
                            </MudMenuItem>
                        }
                    }
                </MudMenu>

            </div>
        </div>

        <!-- 2. ZONE DU CANVAS DE L'ONGLET ACTIF -->
        <div class="flex-grow-1 w-100 position-relative" style="min-height: 0; overflow: hidden;">
            @if (Diagram != null)
            {
                <CascadingValue Value="Diagram">
                    <CascadingValue Name="AllFactoryTabs" Value="Tabs">
                        <CascadingValue Name="SelectTabCallback" Value="EventCallback.Factory.Create<string>(this, SelectTab)">
                            <!-- @key force Blazor à remonter proprement le canvas lors d'un changement d'onglet -->
                            <DiagramCanvas @key="ActiveTab.Id" Class="diagram-container" />
                        </CascadingValue>
                    </CascadingValue>
                </CascadingValue>
            }

            <!-- Overlay d'avancement du chargement de la sauvegarde -->
            <MudOverlay Visible="@_isLoadingDiagram"
                        DarkBackground="true"
                        Absolute="true"
                        ZIndex="1000">
                <div class="d-flex flex-column align-center justify-center pa-6 rounded-lg"
                     style="background: #27272a; border: 1px solid #3f3f46; min-width: 320px; box-shadow: 0 10px 25px rgba(0,0,0,0.6);">

                    <MudProgressCircular Color="Color.Info"
                                         Size="MudBlazor.Size.Large"
                                         Indeterminate="@(_loadingProgress == 0)"
                                         Value="@_loadingProgress"
                                         Class="mb-4" />

                    <MudText Typo="Typo.h6" Class="mb-1" Style="color: #38bdf8; font-weight: 600;">
                        Loading the factory...
                    </MudText>

                    <MudText Typo="Typo.body2" Class="mb-3 text-secondary" Style="color: #a1a1aa;">
                        @_loadingStatusText
                    </MudText>

                    <MudProgressLinear Color="Color.Info"
                                       Value="@_loadingProgress"
                                       Rounded="true"
                                       Size="MudBlazor.Size.Medium"
                                       Style="width: 100%; height: 8px;" />

                    <MudText Typo="Typo.caption" Class="mt-2" Style="color: #71717a;">
                        @($"{_loadingProgress}%")
                    </MudText>
                </div>
            </MudOverlay>


            <!-- Fenêtre modale d'édition du nom et de l'icône d'un onglet -->
            <MudOverlay Visible="@_isEditingTab"
                        DarkBackground="true"
                        Absolute="true"
                        ZIndex="1100">
                <div class="pa-5 rounded-lg"
                     style="background: #27272a; border: 1px solid #3f3f46; width: 380px; max-width: 92vw; box-shadow: 0 12px 30px rgba(0,0,0,0.75); color: #f4f4f5;"
                     @onclick:stopPropagation="true"
                     @onkeydown:stopPropagation="true">

                    <!-- Titre de la fenêtre -->
                    <div class="d-flex align-center justify-space-between mb-3">
                        <MudText Typo="Typo.h6" Style="color: #38bdf8; font-weight: 600;">
                            Modifier l'onglet
                        </MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                       Size="MudBlazor.Size.Small"
                                       Color="Color.Default"
                                       OnClick="CancelEditTab" />
                    </div>

                    <!-- 1. Recherche d'une ressource pour choisir son icône et remplir le nom -->
                    <MudText Typo="Typo.caption" Style="color: #a1a1aa;" Class="d-block mb-1">
                        Choisir une ressource (remplit automatiquement le nom) :
                    </MudText>

                    <MudAutocomplete T="Product"
                                     Placeholder="Rechercher une ressource (ex: Iron, Steel)..."
                                     SearchFunc="@SearchTabIconProducts"
                                     ToStringFunc="@(p => p?.Name ?? string.Empty)"
                                     Value="_editingTabSelectedProduct"
                                     ValueChanged="@OnEditTabProductSelected"
                                     Clearable="true"
                                     ResetValueOnEmptyText="true"
                                     CoerceText="false"
                                     CoerceValue="false"
                                     Dense="true"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Adornment="Adornment.Start"
                                     AdornmentIcon="@Icons.Material.Filled.Search"
                                     MaxItems="300"
                                     MaxHeight="240"
                                     Class="mb-3 search-autocomplete"
                                     PopoverClass="autocomplete-popover-dark">

                        <!-- Ligne de suggestion avec l'icône et le nom de la ressource -->
                        <ItemTemplate Context="prod">
                            <div class="d-flex align-center gap-2 py-1">
                                <img src="@GetProductImagePath(prod)"
                                     alt="@prod.Name"
                                     style="width: 22px; height: 22px; object-fit: contain; flex-shrink: 0;" />
                                <MudText Typo="Typo.body2">@prod.Name</MudText>
                            </div>
                        </ItemTemplate>

                        <NoItemsTemplate>
                            <MudText Typo="Typo.body2" Class="pa-2 text-muted">Aucune ressource trouvée</MudText>
                        </NoItemsTemplate>
                    </MudAutocomplete>

                    <!-- 2. Champ texte du nom de l'onglet (pré-rempli par la ressource ou saisi librement) -->
                    <MudText Typo="Typo.caption" Style="color: #a1a1aa;" Class="d-block mb-1">
                        Nom de l'onglet :
                    </MudText>

                    <MudTextField @bind-Value="_editingTabName"
                                  Placeholder="Nom de l'onglet (ex: Iron, Steel, Oil)..."
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Class="mb-3 search-autocomplete"
                                  @onkeyup="HandleEditTabKeyUp" />

                    <!-- 3. Aperçu en direct de l'onglet avec son icône -->
                    <div class="d-flex align-center justify-space-between pa-2 mb-4 rounded"
                         style="background: #18181b; border: 1px solid #3f3f46;">
                        <div class="d-flex align-center gap-2">
                            <span style="font-size: 0.72rem; color: #71717a;">Aperçu :</span>
                            <div class="factory-tab-chip active" style="cursor: default;">
                                @if (!string.IsNullOrWhiteSpace(_editingTabIconProductId) && ProductDict.TryGetValue(_editingTabIconProductId, out var previewProd))
                                {
                                    <img src="@GetProductImagePath(previewProd)"
                                         alt="@previewProd.Name"
                                         class="tab-resource-icon" />
                                }
                                <span class="tab-name">@(string.IsNullOrWhiteSpace(_editingTabName) ? "Onglet" : _editingTabName)</span>
                            </div>
                        </div>

                        <!-- Bouton pour retirer l'icône si on veut un onglet uniquement textuel -->
                        @if (!string.IsNullOrWhiteSpace(_editingTabIconProductId))
                        {
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Warning"
                                       Size="MudBlazor.Size.Small"
                                       Style="font-size: 0.70rem; text-transform: none;"
                                       OnClick="ClearEditTabIcon">
                                Sans icône
                            </MudButton>
                        }
                    </div>

                    <!-- 4. Boutons d'action Annuler / Valider -->
                    <div class="d-flex justify-end gap-2">
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Default"
                                   Size="MudBlazor.Size.Small"
                                   OnClick="CancelEditTab">
                            Annuler
                        </MudButton>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Info"
                                   Size="MudBlazor.Size.Small"
                                   Disabled="@string.IsNullOrWhiteSpace(_editingTabName)"
                                   OnClick="ConfirmEditTab">
                            Valider
                        </MudButton>
                    </div>

                </div>
            </MudOverlay>


        </div>

    </div>
</div>


<style>
    /* Barre supérieure des onglets d'usine */
    .factory-tabs-bar {
        background: #141418;
        border-bottom: 1px solid #333;
        min-height: 40px;
        flex-shrink: 0;
        z-index: 50;
    }

    .factory-tab-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
