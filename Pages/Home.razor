    /// <summary>
    /// Duplique une machine ou un stockage sélectionné en conservant ses réglages,
    /// en décalant sa position et en recalculant les flux.
    /// </summary>
    /// <param name="originalNode">Le nœud source à dupliquer</param>
    public async Task DuplicateNode(NodeModel originalNode)
    {
        if (originalNode == null) return;

        // Décalage fixe de 35px en diagonale par rapport au nœud actuellement sélectionné
        const double cloneOffset = 35.0;

        var newPosition = new Blazor.Diagrams.Core.Geometry.Point(
            originalNode.Position.X + cloneOffset,
            originalNode.Position.Y + cloneOffset
        );

        NodeModel? newNode = null;

        // Cas 1 : Duplication d'une machine (MachineNodeModel)
        if (originalNode is MachineNodeModel machineSrc)
        {
            var machineClone = new MachineNodeModel(machineSrc.Recipe, newPosition)
            {
                Multiplier = machineSrc.Multiplier,
                IsPaused = machineSrc.IsPaused
            };

            // Restaure le bon niveau (Tier) de la machine
            if (!string.IsNullOrWhiteSpace(machineSrc.CurrentMachineId))
            {
                while (machineClone.CurrentMachineId != machineSrc.CurrentMachineId && machineClone.Upgrade()) { }
            }

            // Restaure l'ordre exact personnalisé des ports d'entrée et de sortie
            var orderedInputs = machineSrc.Recipe.Inputs.Select(i => i.ProductId).ToList();
            var orderedOutputs = machineSrc.Recipe.Outputs.Select(o => o.ProductId).ToList();
            machineClone.ApplyCustomPortOrder(orderedInputs, orderedOutputs);

            newNode = machineClone;
        }
        // Cas 2 : Duplication d'un stockage (StorageNodeModel)
        else if (originalNode is StorageNodeModel storageSrc)
        {
            var storageClone = new StorageNodeModel(storageSrc.ProductId, newPosition);
            newNode = storageClone;
        }

        if (newNode != null)
        {
            // Désélectionne tous les éléments actuellement actifs (y compris le nœud d'origine)
            Diagram.UnselectAll();

            // Ajoute le nœud au diagramme
            Diagram.Nodes.Add(newNode);

            // Force le cycle de rendu pour que Blazor peigne le DOM et monte les ports
            StateHasChanged();
            await Task.Yield();

            // Applique la sélection sur le nouveau nœud maintenant qu'il est présent dans le DOM
            Diagram.SelectModel(newNode, unselectOthers: true);

            // Rafraîchit géométriquement le nœud et le canvas
            newNode.Refresh();
            Diagram.Refresh();
            FlowEngine.RecalculateFlows(Diagram, ResourceService);

            Snackbar.Add("Duplicate item !", Severity.Info);
        }
    }


}