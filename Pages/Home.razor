@page "/"
@inject HttpClient Http
@inject ResourceService ResourceService
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@using System.Text.Json

@implements IDisposable
@using Blazor.Diagrams
@using Blazor.Diagrams.Options
@using Blazor.Diagrams.Core.Anchors;
@using Blazor.Diagrams.Core.Models;
@using Blazor.Diagrams.Core.Models.Base;
@using Blazor.Diagrams.Core.Geometry
@using Blazor.Diagrams.Components

@using CaptainArchitect.Models
@using CaptainArchitect.Components
@using CaptainArchitect.Services

<MudPaper Height="calc(100vh - 100px)" Width="100%" Class="relative overflow-hidden d-flex">

    <!-- Bouton pour ouvrir/fermer le tiroir latéral -->
    <MudIconButton Icon="@Icons.Material.Filled.Menu"
                   Color="Color.Inherit"
                   OnClick="@ToggleDrawer"
                   Class="drawer-toggle-btn" />


    <!-- Tiroir latéral rétractable MudBlazor -->
    <MudDrawer @bind-Open="@_drawerOpen"
               ClipMode="DrawerClipMode.Never"
               Elevation="3"
               Variant="@DrawerVariant.Responsive"
               Width="340px"
               Class="pa-3 bg-dark-drawer d-flex flex-column"
               Style="height: 100vh;">

             
               
        <!-- 1. ZONE FIXE DU HAUT (Titre + Recherche + Filtres) -->
        <div style="flex-shrink: 0;">
            <MudDrawerHeader Class="px-0 py-2">
                <MudText Typo="Typo.h6">Recettes COI</MudText>
            </MudDrawerHeader>



        <!-- Boutons Sauvegarde & Chargement -->
        <div class="d-flex align-center gap-2 mb-2">
            <!-- Bouton d'exportation / téléchargement JSON -->
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       StartIcon="@Icons.Material.Filled.Save" 
                       Size="MudBlazor.Size.Small"
                       OnClick="SaveDiagram">
                Sauvegarder
            </MudButton>

            <!-- Bouton d'importation depuis un fichier JSON -->
            <MudFileUpload T="IBrowserFile" 
                           FilesChanged="LoadDiagram" 
                           Accept=".json">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined" 
                               Color="Color.Secondary" 
                               StartIcon="@Icons.Material.Filled.FolderOpen" 
                               Size="MudBlazor.Size.Small">
                        Charger
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>

            <!-- Bouton pour vider le canvas -->
            <MudButton Variant="Variant.Text" 
                       Color="Color.Error" 
                       StartIcon="@Icons.Material.Filled.Clear" 
                       Size="MudBlazor.Size.Small"
                       OnClick="ClearDiagram">
                Nouveau
            </MudButton>
        </div>



            <!-- HISTORIQUE DES DERNIÈRES RECHERCHES -->
            @if (_recentProducts.Count > 0)
            {
                <div class="mb-2">
                    <!-- Titre compact pour l'historique -->
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1 fw-bold">
                        Dernières recherches :
                    </MudText>

                    <!-- Bandeau horizontal défilant avec les icônes -->
                    <div class="d-flex align-center gap-1 overflow-x-auto pb-1 recent-search-bar">
                        
                        @foreach (var prod in _recentProducts)
                        {
                            <!-- 1. key force Blazor à recréer l'élément sans garder l'état d'erreur du précédent -->
                            <div @key="prod.Id"
                                 class="recent-item-badge"
                                 @onclick="@(() => SelectRecentProduct(prod))"
                                 title="@prod.Name">

                                <!-- 2. Image avec onload pour réinitialiser le display et repli vers la lettre/texte -->
                                <img src="@GetProductImagePath(prod)"
                                        alt="@prod.Name"
                                        class="recent-item-icon"
                                        onload="this.style.display='block'; if(this.nextElementSibling) this.nextElementSibling.style.display='none';"
                                        onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                                
                                <!-- 3. Repli : affiche les 2-3 lettres si l'image est introuvable -->
                                <span class="recent-item-fallback" style="display: none;">
                                    @GetShortFallbackName(prod)
                                </span>
                                     
                            </div>

                        }

                    </div>
                </div>
            }


            <!-- Barre de recherche -->
            <!-- Sélecteur / Barre de recherche avec autocomplétion des produits -->
            <MudAutocomplete T="Product"
                             Placeholder="Rechercher ou choisir un produit..."
                             SearchFunc="@SearchProducts"
                             ToStringFunc="@(p => p?.Name ?? string.Empty)"
                             Value="_selectedProduct"
                             ValueChanged="@OnProductSelected"
                             Clearable="true"
                             ResetValueOnEmptyText="true"
                             CoerceText="false"
                             CoerceValue="false"
                             Dense="true"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Adornment="Adornment.Start"
                             AdornmentIcon="@Icons.Material.Filled.Search"
                             MaxItems="300"
                             SelectValueOnTab="false"
                             @onkeyup="HandleSearchKeyDown"
                             Class="mb-2 search-autocomplete"
                             PopoverClass="autocomplete-popover-dark">

                <!-- Rendu personnalisé de chaque ligne dans la liste déroulante -->
                <ItemTemplate Context="prod">
                    <div class="d-flex align-center gap-2 py-1">
                        <!-- Icône du produit avec gestion d'erreur d'affichage -->
                        <img src="@GetProductImagePath(prod)"
                             alt="@prod.Name"
                             style="width: 24px; height: 24px; object-fit: contain; flex-shrink: 0;"
                             onerror="this.style.display='none';" />

                        <!-- Libellé du produit -->
                        <MudText Typo="Typo.body2">@prod.Name</MudText>

                        <!-- Identifiant technique affiché discrètement -->
                        <!-- <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ms-auto">@prod.Id</MudText> -->
                    </div>
                </ItemTemplate>

                <!-- Message si aucun produit ne correspond à la saisie -->
                <NoItemsTemplate>
                    <MudText Typo="Typo.body2" Class="pa-2 text-muted">Aucun produit trouvé</MudText>
                </NoItemsTemplate>

            </MudAutocomplete>


            <!-- Filtre Entrée / Sortie / Tout : placé DIRECTEMENT sous la recherche -->
            <MudToggleGroup T="ResourceFilterMode"
                            @bind-Value="_filterMode"
                            Color="Color.Primary"
                            CheckMark="false"
                            FixedContent="true"
                            Size="MudBlazor.Size.Small"
                            Class="mb-3 w-100 d-flex justify-center"
                            Style="background-color: #1e1e1e; border: 1px solid #444; border-radius: 4px;">
                <MudToggleItem Value="ResourceFilterMode.All" Text="Tout" Class="flex-grow-1" />
                <MudToggleItem Value="ResourceFilterMode.Input" Text="Entrées" Class="flex-grow-1" />
                <MudToggleItem Value="ResourceFilterMode.Output" Text="Sorties" Class="flex-grow-1" />
            </MudToggleGroup>
        </div>


        <!-- 2. ZONE SCROLLABLE (Seule la liste défile) -->
        <div class="recipes-list flex-grow-1" style="overflow-y: auto; min-height: 0;">
            @if (FilteredRecipes != null)
            {
                <Virtualize Items="@FilteredRecipes.ToList()" Context="recipe">
                    <MudCard Class="mb-2 recipe-card" Outlined="true">
                        <MudCardContent Class="pa-2">
                            <div class="d-flex justify-space-between align-center">

                                <!-- Titre éclairci avec la classe recipe-title -->
                                <MudText Typo="Typo.subtitle2" Class="fw-bold recipe-title">@recipe.RecipeId</MudText>
                                
                                <MudIconButton Icon="@Icons.Material.Filled.AddCircle"
                                               Color="Color.Primary"
                                               Size="MudBlazor.Size.Small"
                                               Title="Ajouter sur le diagramme"
                                               OnClick="@(() => AddRecipeNode(recipe))" />
                            </div>

                            <!-- Entrées & Sorties -->
                            <div class="d-flex align-center gap-1 mt-1">
                                
                                <!-- Libellé In: avec recipe-in-label -->
                                <MudText Typo="Typo.caption" Class="recipe-in-label me-1">In:</MudText>
                                
                                @foreach (var input in recipe.Inputs)
                                {
                                    @if (!string.IsNullOrWhiteSpace(input.ProductId))
                                    {
                                        <ResourceBadge @key="@($"{recipe.RecipeId}_in_{input.ProductId}")" 
                                                       ProductId="@input.ProductId" />
                                    }
                                }
                                
                                <!-- Libellé Out: avec recipe-out-label -->
                                <MudText Typo="Typo.caption" Class="recipe-out-label ms-2 me-1">Out:</MudText>
                                
                                @foreach (var output in recipe.Outputs)
                                {
                                    @if (!string.IsNullOrWhiteSpace(output.ProductId))
                                    {
                                        <ResourceBadge @key="@($"{recipe.RecipeId}_out_{output.ProductId}")"
                                                       ProductId="@output.ProductId" />
                                    }
                                }

                            </div>
                        </MudCardContent>
                    </MudCard>
                </Virtualize>
            }

            else
            {
                <MudProgressCircular Indeterminate="true" Size="MudBlazor.Size.Small" />
            }

        </div>

    </MudDrawer>

    <!-- Zone principale : Diagramme -->
    <div class="flex-grow-1 h-100 position-relative outline-none"
         tabindex="0" 
         @onkeydown="HandleKeyDown">
        @if (Diagram != null)
        {
            <CascadingValue Value="Diagram">
                <DiagramCanvas Class="diagram-container">
                </DiagramCanvas>
            </CascadingValue>
        }
    </div>
</MudPaper>


