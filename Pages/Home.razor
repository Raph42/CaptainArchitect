    /// <summary>
    /// Recherche dans la liste complète des ressources pour le sélecteur d'icône d'onglet.
    /// </summary>
    private Task<IEnumerable<Product>> SearchTabIconProducts(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return Task.FromResult<IEnumerable<Product>>(_allProducts.OrderBy(p => p.Name));
        }

        var term = value.Trim();
        var results = _allProducts
            .Where(p => (!string.IsNullOrEmpty(p.Name) && p.Name.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                        (!string.IsNullOrEmpty(p.Id) && p.Id.Contains(term, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(p => p.Name);

        return Task.FromResult<IEnumerable<Product>>(results);
    }

