@code {

    public enum ResourceFilterMode
    {
        All,    // Les deux (entrées ou sorties)
        Input,  // Seulement si présent en entrée
        Output  // Seulement si présent en sortie
    }

    private BlazorDiagram Diagram { get; set; } = default!;
    private List<Recipe>? Recipes { get; set; }

    // Renommé pour éviter le conflit avec le namespace .NET "Resources"
    private Dictionary<string, Product> ProductDict { get; set; } = new();

    private bool _drawerOpen = true;

    // Variable contenant le texte effectif qui filtre la liste des recettes
    private string _searchQuery = "";
    // Mémorise le texte tapé au fur et à mesure sans déclencher le re-filtrage lourd des recettes
    private string _currentSearchText = "";

    private double _spawnOffset = 150;

    // Stocke la liste brute de tous les produits pour alimenter la recherche
    private List<Product> _allProducts = new();
    private Product? _selectedProduct;

    private ResourceFilterMode _filterMode = ResourceFilterMode.All;

    // Variables d'historique
    private readonly List<Product> _recentProducts = new();
    private const int MaxRecentSearches = 10;

    // Variables pour l'état d'avancement du chargement
    private bool _isLoadingDiagram = false;
    private int _loadingProgress = 0;
    private string _loadingStatusText = "";

    // =========================================================================
    // GESTION DU DÉCALAGE EN CASCADE POUR LES NOUVEAUX ÉLÉMENTS ET CLONES
    // =========================================================================
    // Décalage courant appliqué à chaque ajout successif
    private double _cascadeOffset = 0.0;

    // Pas d'incrément à chaque ajout (en pixels)
    private const double CascadeStep = 30.0;

    // Décalage maximal avant de repartir du centre
    private const double MaxCascadeOffset = 180.0;


    /// <summary>
    /// Calcule le décalage suivant et fait repartir le cycle s'il dépasse le maximum.
    /// </summary>
    private double GetNextCascadeOffset()
    {
        double current = _cascadeOffset;
        _cascadeOffset += CascadeStep;

        if (_cascadeOffset > MaxCascadeOffset)
        {
            _cascadeOffset = 0.0;
        }
        return current;
    }


    // Texte saisi dans le filtre du menu "Add Storage"
    private string _storageFilterText = "";

    // Liste filtrée des produits disponibles pour le stockage
    private IEnumerable<Product> FilteredStorageProducts =>
        string.IsNullOrWhiteSpace(_storageFilterText)
            ? ProductDict.Values.OrderBy(p => p.Name)
            : ProductDict.Values
                .Where(p => (!string.IsNullOrEmpty(p.Name) && p.Name.Contains(_storageFilterText.Trim(), StringComparison.OrdinalIgnoreCase)) ||
                            (!string.IsNullOrEmpty(p.Id) && p.Id.Contains(_storageFilterText.Trim(), StringComparison.OrdinalIgnoreCase)))
                .OrderBy(p => p.Name);

    // Propriété de filtrage des recettes
    private IEnumerable<Recipe>? FilteredRecipes =>
        Recipes?.Where(r =>
        {
            // 1. Si aucun texte n'est validé et aucun produit sélectionné, on affiche tout
            if (string.IsNullOrWhiteSpace(_searchQuery) && _selectedProduct == null)
                return true;

            var query = _searchQuery.Trim();

            // 2. Critère de correspondance :
            // - Si un produit précis a été cliqué dans la liste ou sur une machine -> Égalité stricte sur son Id
            // - Sinon (recherche validée par Entrée) -> Recherche souple avec Contains (Iron trouvera Iron, IronOre, IronScrap...)
            Func<string?, bool> matchesCriteria = (productId) =>
            {
                if (string.IsNullOrWhiteSpace(productId)) return false;

                if (_selectedProduct != null)
                {
                    // Égalité exacte : seulement le produit sélectionné
                    return string.Equals(productId, _selectedProduct.Id, StringComparison.OrdinalIgnoreCase);
                }
                else
                {
                    // Recherche large par sous-chaîne sur l'ID
                    return productId.Contains(query, StringComparison.OrdinalIgnoreCase);
                }
            };


            // 3. Vérification sur les entrées et les sorties
            bool matchesInput = r.Inputs.Any(i => matchesCriteria(i.ProductId));
            bool matchesOutput = r.Outputs.Any(o => matchesCriteria(o.ProductId));

            // 4. Correspondance sur le nom de la recette (uniquement en saisie manuelle et mode Tout)
            bool matchesName = _selectedProduct == null &&
                               r.RecipeId.Contains(query, StringComparison.OrdinalIgnoreCase);

            // 5. Filtrage selon le mode sélectionné (Tout / Entrées / Sorties)
            return _filterMode switch
            {
                ResourceFilterMode.Input => matchesInput,
                ResourceFilterMode.Output => matchesOutput,
                _ => matchesName || matchesInput || matchesOutput
            };

        });



    // 1. Fonction appelée à chaque frappe pour filtrer le menu déroulant de l'autocomplétion
    private async Task<IEnumerable<Product>> SearchProducts(string value, CancellationToken token)
    {
        // On mémorise la frappe SANS toucher à _searchQuery (supprime tout lag pendant la frappe !)
        _currentSearchText = value ?? string.Empty;

        // Si le champ est vidé, on efface aussi le filtre pour réafficher toutes les recettes
        if (string.IsNullOrWhiteSpace(value))
        {
            _selectedProduct = null;
            _searchQuery = string.Empty;
            return _allProducts.OrderBy(p => p.Name);
        }

        var term = value.Trim();

        // Filtre sur le nom affiché (Name) ou sur l'identifiant (Id)
        return _allProducts
            .Where(p => (!string.IsNullOrEmpty(p.Name) && p.Name.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                        (!string.IsNullOrEmpty(p.Id) && p.Id.Contains(term, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(p => p.Name);

    }



    // 2. Déclenché UNIQUEMENT quand vous cliquez sur un produit dans le menu déroulant
    private void OnProductSelected(Product? selected)
    {
        _selectedProduct = selected;
        _searchQuery = selected?.Id ?? string.Empty;
        _currentSearchText = selected?.Name ?? string.Empty;

        // mémorise le produit sélectionné
        if (selected != null)
        {
            AddToRecentSearches(selected);
        }

    }



    // 3. Gère la validation par la touche Entrée dans la barre de recherche
    private void HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter")
        {
            // En validant par Entrée sans avoir cliqué sur un produit précis :
            // 1. On annule la sélection stricte d'un produit unique
            _selectedProduct = null;

            // 2. On applique le texte saisi comme filtre global (partiel)
            _searchQuery = _currentSearchText;

            // 3. Rafraîchit instantanément la liste des recettes filtrées
            StateHasChanged();
        }
    }



    // 4. Clic sur une ressource posée sur le diagramme
    // Méthode appelée lors du clic sur une ressource d'une machine posée
    private void HandleResourceFilterRequested(string productId, PortDirection? direction)
    {
        // 1. Ouvre le tiroir à gauche si jamais il était fermé
        _drawerOpen = true;

        // 2. Gestion du mode de filtre :
        // - Si clic sur Sortie d'une machine posée -> filtre sur Entrées
        // - Si clic sur Entrée d'une machine posée -> filtre sur Sorties
        // - Si clic dans la liste du panneau (direction == null) -> passe en mode Tout
        _filterMode = direction switch
        {
            PortDirection.Output => ResourceFilterMode.Input,
            PortDirection.Input => ResourceFilterMode.Output,
            _ => ResourceFilterMode.All
        };

        // 3. Applique le produit cliqué dans la recherche
        if (ProductDict.TryGetValue(productId, out var product))
        {
            _selectedProduct = product;
            _searchQuery = product.Id;
            _currentSearchText = product.Name;

            // mémorise aussi le produit cliqué depuis le diagramme
            AddToRecentSearches(product);
        }
        else
        {
            _selectedProduct = null;
            _searchQuery = productId;
            _currentSearchText = productId;
        }

        // 3. Demande à Blazor de recalculer FilteredRecipes et de rafraîchir l'affichage
        InvokeAsync(StateHasChanged);
    }



    // Calcule le chemin de l'image en nettoyant le slash initial éventuel
    private string GetProductImagePath(Product? prod)
    {
        if (prod == null) return string.Empty;

        var path = !string.IsNullOrWhiteSpace(prod.Image)
            ? prod.Image
            : $"images/resources/{prod.Id}.png";

        return path.TrimStart('/');
    }



    /// Calcule un texte court de secours (3 caractères max) si le produit n'a pas d'image
    private string GetShortFallbackName(Product? prod)
    {
        if (prod == null) return string.Empty;
        var text = !string.IsNullOrWhiteSpace(prod.Name) ? prod.Name : prod.Id;
        return text.Substring(0, Math.Min(3, text.Length)).ToUpperInvariant();
    }


    protected override async Task OnInitializedAsync()
    {
        // 1. Chargement des données globales
        try
        {
            // Chargement du fichier unique
            var data = await Http.GetFromJsonAsync<CoiData>("data/captain_of_industry_data.json");

            // Enregistrement des versions du JSON et du jeu dans le service
            ResourceService.SetVersions(data.Generator, data.GameVersion);

            if (data != null)
            {
                if (data.Products != null)
                {
                    // Conserve la liste complète pour la barre de recherche
                    _allProducts = data.Products;

                    ProductDict = data.Products.ToDictionary(p => p.Id, p => p);
                    ResourceService.LoadProducts(data.Products);
                }

                if (data.Machines != null)
                {
                    ResourceService.LoadMachines(data.Machines);
                }

                Recipes = data.Recipes;

                // Force le re-rendu du tiroir avec les données prêtes
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur : {ex.Message}");
        }

        // 2. Options et création de lien avec couleur globale
        var options = new BlazorDiagramOptions
        {
            AllowMultiSelection = true,
            AllowPanning = true,

            Zoom =
            {
                Enabled = true,
                Inverse = true // <-- Inverse directement le sens de la molette
            },

            Links =
            {
                // le PathGenerator décide de la manière de dessiner la ligne entre ces points
                // (courbe, ligne droite ou angles brisés).
                // StraightPathGenerator : trace des segments droits et nets entre les points calculés, supprimant toute courbure.
                DefaultPathGenerator = new SmoothPathGenerator(),

                // le Router calcule uniquement les points de passage (les coordonnées $X, Y$), 
                //DefaultRouter = new OrthogonalRouter(),

                EnableSnapping = true,

                // Utilise notre modèle personnalisé lorsqu'un lien est tiré depuis un port
                Factory = (diagram, source, position) =>
                {
                    Blazor.Diagrams.Core.Anchors.Anchor sourceAnchor = source switch
                    {
                        PortModel port => new SinglePortAnchor(port),
                        NodeModel node => new ShapeIntersectionAnchor(node),
                        _ => new SinglePortAnchor((PortModel)source)
                    };

                    var link = new ResourceLinkModel(sourceAnchor);

                    // Récupère la couleur globale associée à l'identifiant de la ressource
                    if (source is ResourcePortModel resPort)
                    {
                        if (ProductDict.TryGetValue(resPort.ProductId, out var prod) && !string.IsNullOrWhiteSpace(prod.Color))
                        {
                            link.Color = prod.Color;
                        }
                    }

                    return link;
                }

            }
        };

        Diagram = new BlazorDiagram(options);

        // =========================================================================
        // ABONNEMENTS OPTIMISÉS : Recalcul UNIQUEMENT lors des vraies modifications
        // (Suppression de link.Changed pour éviter les 60 recalculs/sec pendant le drag)
        // =========================================================================
        Diagram.Links.Added += link =>
        {
            // Recalcul UNIQUEMENT quand le lien s'accroche définitivement sur le port cible
            link.TargetAttached += _ => FlowEngine.RecalculateFlows(Diagram, ResourceService);
        };

        // Recalcul lorsqu'une liaison est supprimée
        Diagram.Links.Removed += _ => FlowEngine.RecalculateFlows(Diagram, ResourceService);

        // Recalcul lorsqu'une machine ou un stockage est supprimé
        Diagram.Nodes.Removed += _ => FlowEngine.RecalculateFlows(Diagram, ResourceService);

        // Enregistre le composant personnalisé pour les nœuds de machine
        Diagram.RegisterComponent<MachineNodeModel, MachineNodeWidget>();

        // Enregistre le composant personnalisé pour les nœuds de stockage
        Diagram.RegisterComponent<StorageNodeModel, StorageNodeWidget>();

        // Enregistre le rendu visuel de notre lien personnalisé
        Diagram.RegisterComponent<ResourceLinkModel, ResourceLinkWidget>();

        // Abonnement à l'événement de filtrage de ressource
        ResourceService.OnResourceFilterRequested += HandleResourceFilterRequested;

        // UN SEUL Recalcul initial ici, tout à la fin
        FlowEngine.RecalculateFlows(Diagram, ResourceService);

    }


