    /// <summary>
    /// Sauvegarde l'état actuel du diagramme dans un fichier JSON téléchargé par le client.
    /// </summary>
    private async Task SaveDiagram()
    {
        try
        {
            var saveData = new DiagramSaveData();

            // 1. Sauvegarde des nœuds (machines)
            foreach (var node in Diagram.Nodes.OfType<MachineNodeModel>())
            {
                saveData.Nodes.Add(new SavedNodeData
                {
                    NodeId = node.Id,
                    RecipeId = node.Recipe.RecipeId,
                    MachineId = node.CurrentMachineId,
                    Multiplier = node.Multiplier,
                    X = node.Position.X,
                    Y = node.Position.Y,

                    // Mémorisation de l'ordre exact actuel des entrées et des sorties
                    OrderedInputProductIds = node.Recipe.Inputs.Select(i => i.ProductId).ToList(),
                    OrderedOutputProductIds = node.Recipe.Outputs.Select(o => o.ProductId).ToList()
                });
            }


            // 2. Sauvegarde de tous les stockages (StorageNodeModel)
            foreach (var storage in Diagram.Nodes.OfType<StorageNodeModel>())
            {
                saveData.Storages.Add(new SavedStorageData
                {
                    NodeId = storage.Id,
                    ProductId = storage.ProductId,
                    X = storage.Position.X,
                    Y = storage.Position.Y
                });
            }


            // 3. Sauvegarde de toutes les liaisons (câbles / tuyaux)
            // Fonctionne indifféremment entre Machines et Stockages (Machine -> Machine, Machine -> Stockage, Stockage -> Machine)
            foreach (var link in Diagram.Links)
            {
                if (link.Source is SinglePortAnchor srcAnchor &&
                    srcAnchor.Port is ResourcePortModel srcPort &&
                    link.Target is SinglePortAnchor tgtAnchor &&
                    tgtAnchor.Port is ResourcePortModel tgtPort &&
                    srcPort.Parent is NodeModel srcNode &&
                    tgtPort.Parent is NodeModel tgtNode)
                {
                    saveData.Links.Add(new SavedLinkData
                    {
                        SourceNodeId = srcNode.Id,
                        SourceProductId = srcPort.ProductId,
                        SourceDirection = srcPort.Direction,

                        TargetNodeId = tgtNode.Id,
                        TargetProductId = tgtPort.ProductId,
                        TargetDirection = tgtPort.Direction
                    });
                }
            }

            // 4. Sérialisation et téléchargement du JSON
            var jsonString = JsonSerializer.Serialize(saveData, new JsonSerializerOptions { WriteIndented = true });
            var fileName = $"factory_{DateTime.Now:yyyyMMdd_HHmmss}.json";
            await JS.InvokeVoidAsync("downloadFileFromText", fileName, jsonString);

            Snackbar.Add("Diagram saved successfully !", Severity.Success);

        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error while saving : {ex.Message}", Severity.Error);
        }

    }



    /// <summary>
    /// Charge et reconstruit le diagramme depuis un fichier JSON sélectionné par l'utilisateur.
    /// Recrée les machines, les stockages et rétablit tous les liens.
    /// </summary>
    private async Task LoadDiagram(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            // 1. Initialisation de l'état de chargement
            _isLoadingDiagram = true;
            _loadingProgress = 0;
            _loadingStatusText = "Reading the file...";
            StateHasChanged();
            await Task.Yield(); // Laisse le navigateur afficher l'overlay

            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var saveData = await JsonSerializer.DeserializeAsync<DiagramSaveData>(stream);

            if (saveData == null || Recipes == null)
            {
                Snackbar.Add("The save file is invalid.", Severity.Warning);
                return;
            }

            // 2. Vider le diagramme actuel
            Diagram.Links.Clear();
            Diagram.Nodes.Clear();

            // Dictionnaire unifié pour mapper les anciens ID vers les nouvelles instances de NodeModel (Machines OU Stockages)
            var allNodesMap = new Dictionary<string, NodeModel>();

			// Variables pour le suivi de l'avancement
            int totalNodes = saveData.Nodes.Count;
            int totalStorages = saveData.Storages.Count;
            int totalLinks = saveData.Links.Count;
            int totalOperations = (totalNodes + totalLinks) > 0 ? (totalNodes + totalLinks) : 1;
            int currentStep = 0;


            // 3. Recréation des machines (MachineNodeModel)
            for (int i = 0; i < totalNodes; i++)
            {
                var savedNode = saveData.Nodes[i];
                // Recherche de la recette dans les données chargées
                var recipe = Recipes.FirstOrDefault(r => r.RecipeId == savedNode.RecipeId);
                
                if (recipe != null)
                {
                    // Instanciation de la machine à sa position d'origine
                    var node = new MachineNodeModel(recipe, new Blazor.Diagrams.Core.Geometry.Point(savedNode.X, savedNode.Y))
                    {
                        Multiplier = savedNode.Multiplier
                    };

                    // Restauration du niveau de machine si nécessaire
                    if (!string.IsNullOrWhiteSpace(savedNode.MachineId) && node.CurrentMachineId != savedNode.MachineId)
                    {
                        while (node.CurrentMachineId != savedNode.MachineId && node.Upgrade()) { }
                    }

                    // RECONSTITUTION DE L'ORDRE DES PORTS
                    node.ApplyCustomPortOrder(savedNode.OrderedInputProductIds, savedNode.OrderedOutputProductIds);


                    Diagram.Nodes.Add(node);
                    allNodesMap[savedNode.NodeId] = node;
                }


                currentStep++;
                // Mise à jour de l'UI tous les 5 nœuds ou au dernier nœud pour rester fluide
                if (i % 5 == 0 || i == totalNodes - 1)
                {
                    _loadingProgress = (int)((double)currentStep / totalOperations * 100);
                    _loadingStatusText = $"Creation of the machines ({i + 1}/{totalNodes})...";
                    StateHasChanged();
                    await Task.Yield();
                }

            }


            // 4. Recréation des stockages (StorageNodeModel)
            for (int s = 0; s < totalStorages; s++)
            {
                var savedStorage = saveData.Storages[s];

                var storageNode = new StorageNodeModel(
                    savedStorage.ProductId,
                    new Blazor.Diagrams.Core.Geometry.Point(savedStorage.X, savedStorage.Y)
                );

                Diagram.Nodes.Add(storageNode);
                allNodesMap[savedStorage.NodeId] = storageNode;

                currentStep++;
                if (s % 5 == 0 || s == totalStorages - 1)
                {
                    _loadingProgress = (int)((double)currentStep / totalOperations * 100);
                    _loadingStatusText = $"Création des stockages ({s + 1}/{totalStorages})...";
                    StateHasChanged();
                    await Task.Yield();
                }
            }


            // 5. Reconnexion de tous les câbles et tuyaux
            for (int j = 0; j < totalLinks; j++)
            {
                var savedLink = saveData.Links[j];

                // Recherche des nœuds source et cible dans le dictionnaire global
                if (allNodesMap.TryGetValue(savedLink.SourceNodeId, out var srcNode) &&
                    allNodesMap.TryGetValue(savedLink.TargetNodeId, out var tgtNode))
                {
                    // Recherche du port source correspondant par Direction et ProductId
                    var srcPort = srcNode.Ports.OfType<ResourcePortModel>()
                        .FirstOrDefault(p => p.Direction == savedLink.SourceDirection &&
                                             string.Equals(p.ProductId, savedLink.SourceProductId, StringComparison.OrdinalIgnoreCase));

                    // Recherche du port cible correspondant par Direction et ProductId
                    var tgtPort = tgtNode.Ports.OfType<ResourcePortModel>()
                        .FirstOrDefault(p => p.Direction == savedLink.TargetDirection &&
                                             string.Equals(p.ProductId, savedLink.TargetProductId, StringComparison.OrdinalIgnoreCase));

                    if (srcPort != null && tgtPort != null)
                    {
                        var link = new ResourceLinkModel(new SinglePortAnchor(srcPort), new SinglePortAnchor(tgtPort));

                        // Attribution de la couleur de la ressource
                        if (ProductDict.TryGetValue(srcPort.ProductId, out var prod) && !string.IsNullOrWhiteSpace(prod.Color))
                        {
                            link.Color = prod.Color;
                        }

                        Diagram.Links.Add(link);
                    }
                }


                currentStep++;
                // Mise à jour de l'UI toutes les 10 liaisons
                if (j % 10 == 0 || j == totalLinks - 1)
                {
                    _loadingProgress = (int)((double)currentStep / totalOperations * 100);
                    _loadingStatusText = $"Reconnecting the pipes ({j + 1}/{totalLinks})...";
                    StateHasChanged();
                    await Task.Yield();
                }

            }

            // 6. Recalcul des flux
            _loadingStatusText = "Flow calculation and balancing...";
            _loadingProgress = 100;
            StateHasChanged();
            await Task.Yield();

            FlowEngine.RecalculateFlows(Diagram, ResourceService);
            StateHasChanged();

            Snackbar.Add("Diagram successfully loaded !", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error while loading : {ex.Message}", Severity.Error);
        }
        finally
        {
            // 5. Fermeture de l'overlay de progression
            _isLoadingDiagram = false;
            StateHasChanged();
        }

    }



