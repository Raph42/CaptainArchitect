    /// <summary>
    /// Réinitialise complètement toute l'usine après confirmation de l'utilisateur
    /// (supprime tous les onglets et recrée un onglet unique "Main" comme au démarrage).
    /// </summary>
    private async Task NewFactory()
    {
        // 1. Demande de confirmation avant de tout effacer (syntaxe asynchrone MudBlazor v7+)
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            title: "New Factory",
            message: "Are you sure you want to start a new factory? All tabs, machines, and links will be cleared.",
            yesText: "New",
            cancelText: "Cancel"
        );

        // Si l'utilisateur clique sur "Cancel" ou ferme la boîte de dialogue, on annule l'opération
        if (confirm != true) return;

        try
        {
            // 2. Active le verrou pour bloquer tout recalcul intermédiaire pendant le nettoyage
            _isBulkUpdating = true;

            // 3. Vide tous les onglets existants (machines, stockages, portails et liaisons)
            Tabs.Clear();

            // 4. Recrée l'onglet initial unique "Main", exactement comme dans OnInitializedAsync()
            var initialTab = new FactoryTab
            {
                Name = "Main",
                Diagram = CreateConfiguredDiagram()
            };
            Tabs.Add(initialTab);
            ActiveTab = initialTab;

            // 5. Réinitialise le décalage en cascade des nouveaux éléments et les filtres de menus
            _cascadeOffset = 0.0;
            _storageFilterText = "";
            _portalFilterText = "";

            // 6. Ré-enregistre la nouvelle liste d'onglets auprès du moteur de flux
            FlowEngine.RegisterTabs(Tabs);
        }
        finally
        {
            // 7. Relâche toujours le verrou, même en cas d'erreur
            _isBulkUpdating = false;
        }

        // 8. Recalcule les flux (remet également les ouvriers et l'électricité à 0 dans la barre supérieure)
        FlowEngine.RecalculateFlows(Tabs, ResourceService);
        StateHasChanged();

        Snackbar.Add("New factory initialized !", Severity.Info);
    }


    /// <summary>
    /// Réinitialise complètement le diagramme.
    /// </summary>
    private void ClearDiagram()
    {
        try
        {
            // Active le verrou avant de vider les collections
            _isBulkUpdating = true;

            // Supprime tous les liens puis tous les nœuds
            Diagram.Links.Clear();
            Diagram.Nodes.Clear();
        }
        finally
        {
            // Relâche toujours le verrou, même en cas d'erreur
            _isBulkUpdating = false;
        }

        // Un seul recalcul à la fin
        FlowEngine.RecalculateFlows(Tabs, ResourceService);
        StateHasChanged();
    }


    /// <summary>
    /// Sauvegarde l'état actuel du diagramme dans un fichier JSON téléchargé par le client.
    /// </summary>
    private async Task SaveDiagram()
    {
        try
        {
            var saveData = new DiagramSaveData { Version = "2.0" };


            foreach (var tab in Tabs)
            {
                var savedTab = new SavedTabData
                {
                    TabId = tab.Id,
                    Name = tab.Name,
                    // Sauvegarde l'icône de ressource choisie pour cet onglet
                    IconProductId = tab.IconProductId
                };

                // 1. Sauvegarde des nœuds (machines)
                foreach (var node in tab.Diagram.Nodes.OfType<MachineNodeModel>())
                {
                    savedTab.Nodes.Add(new SavedNodeData
                    {
                        NodeId = node.Id,
                        RecipeId = node.Recipe.RecipeId,
                        MachineId = node.CurrentMachineId,
                        Multiplier = node.Multiplier,
                        X = node.Position.X,
                        Y = node.Position.Y,

                        // Mémorisation de l'ordre exact actuel des entrées et des sorties
                        OrderedInputProductIds = node.Recipe.Inputs.Select(i => i.ProductId).ToList(),
                        OrderedOutputProductIds = node.Recipe.Outputs.Select(o => o.ProductId).ToList()
                    });
                }

                // 2. Sauvegarde de tous les stockages (StorageNodeModel)
                foreach (var storage in tab.Diagram.Nodes.OfType<StorageNodeModel>())
                {
                    savedTab.Storages.Add(new SavedStorageData
                    {
                        NodeId = storage.Id,
                        ProductId = storage.ProductId,
                        X = storage.Position.X,
                        Y = storage.Position.Y
                    });
                }

				// 3. Sauvegarde de tous les portails (PortalNodeModel)
                foreach (var portal in tab.Diagram.Nodes.OfType<PortalNodeModel>())
                {
                    savedTab.Portals.Add(new SavedPortalData
                    {
                        NodeId = portal.Id,
                        Direction = portal.Direction,
                        ProductId = portal.ProductId,
                        ChannelName = portal.ChannelName,
                        SourceExportPortalId = portal.SourceExportPortalId,
                        X = portal.Position.X,
                        Y = portal.Position.Y
                    });
                }

                // 4. Sauvegarde de toutes les liaisons (câbles / tuyaux)
                // Fonctionne indifféremment entre Machines et Stockages (Machine -> Machine, Machine -> Stockage, Stockage -> Machine)
                foreach (var link in tab.Diagram.Links)
                {
                    if (link.Source is SinglePortAnchor srcAnchor &&
                        srcAnchor.Port is ResourcePortModel srcPort &&
                        link.Target is SinglePortAnchor tgtAnchor &&
                        tgtAnchor.Port is ResourcePortModel tgtPort &&
                        srcPort.Parent is NodeModel srcNode &&
                        tgtPort.Parent is NodeModel tgtNode)
                    {
                        var savedLink = new SavedLinkData
                        {
                            SourceNodeId = srcNode.Id,
                            SourceProductId = srcPort.ProductId,
                            SourceDirection = srcPort.Direction,
                            TargetNodeId = tgtNode.Id,
                            TargetProductId = tgtPort.ProductId,
                            TargetDirection = tgtPort.Direction
                        };

                        // Mémorisation des points de passage
                        foreach (var vertex in link.Vertices)
                        {
                            savedLink.Vertices.Add(new double[] { vertex.Position.X, vertex.Position.Y });
                        }

                        savedTab.Links.Add(savedLink);
                    }
                }

                saveData.Tabs.Add(savedTab);
            }

            // 4. Sérialisation et téléchargement du JSON
            var jsonString = JsonSerializer.Serialize(saveData, new JsonSerializerOptions { WriteIndented = true });
            var fileName = $"factory_{DateTime.Now:yyyyMMdd_HHmmss}.json";
            await JS.InvokeVoidAsync("downloadFileFromText", fileName, jsonString);

            Snackbar.Add("Diagram saved successfully !", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error while saving : {ex.Message}", Severity.Error);
        }
    }


    /// <summary>
    /// Charge et reconstruit le diagramme depuis un fichier JSON sélectionné par l'utilisateur.
    /// Recrée les machines, les stockages et rétablit tous les liens.
    /// </summary>
    private async Task LoadDiagram(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            // 1. Active le verrou dès le début pour bloquer les recalculs intermédiaires
            _isBulkUpdating = true;

            // 2. Initialisation de l'état de chargement
            _isLoadingDiagram = true;
            _loadingProgress = 0;
            _loadingStatusText = "Reading the file...";
            StateHasChanged();

            // Laisse le navigateur afficher l'overlay
            await Task.Yield();

            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var saveData = await JsonSerializer.DeserializeAsync<DiagramSaveData>(stream);

            if (saveData == null || Recipes == null)
            {
                Snackbar.Add("The save file is invalid.", Severity.Warning);
                return;
            }

            // Rétrocompatibilité avec les anciennes sauvegardes mono-onglet (v1.x)
            if (saveData.Tabs.Count == 0 && (saveData.Nodes.Count > 0 || saveData.Storages.Count > 0))
            {
                saveData.Tabs.Add(new SavedTabData
                {
                    TabId = Guid.NewGuid().ToString("N"),
                    Name = "Principal",
                    Nodes = saveData.Nodes,
                    Storages = saveData.Storages,
                    Links = saveData.Links
                });
            }

            // 2. Vider le diagramme actuel
            // (instantané grâce à _isBulkUpdating = true)
            _loadingStatusText = "Clearing previous factory...";
            StateHasChanged();
            await Task.Yield();

            Tabs.Clear();

            var exportPortalIdMap = new Dictionary<string, string>();
            var importedPortalsToRelink = new List<(PortalNodeModel ImportPortal, string OldExportId)>();

            int totalTabs = Math.Max(1, saveData.Tabs.Count);

            for (int t = 0; t < saveData.Tabs.Count; t++)
            {
                var savedTab = saveData.Tabs[t];
                var tab = new FactoryTab
                {
                    Id = string.IsNullOrWhiteSpace(savedTab.TabId) ? Guid.NewGuid().ToString("N") : savedTab.TabId,
                    Name = string.IsNullOrWhiteSpace(savedTab.Name) ? $"Secteur {t + 1}" : savedTab.Name,
                    // Restaure l'icône de ressource choisie pour cet onglet
                    IconProductId = savedTab.IconProductId,
                    Diagram = CreateConfiguredDiagram()
                };

                // Dictionnaire unifié pour mapper les anciens ID vers les nouvelles instances de NodeModel (Machines OU Stockages)
                var allNodesMap = new Dictionary<string, NodeModel>();

                // 1. Recréation des machines (MachineNodeModel)
                for (int i = 0; i < savedTab.Nodes.Count; i++)
                {
                    var savedNode = savedTab.Nodes[i];
                    // Recherche de la recette dans les données chargées
                    var recipe = Recipes.FirstOrDefault(r => r.RecipeId == savedNode.RecipeId);

                    if (recipe != null)
                    {
                        // Instanciation de la machine à sa position d'origine
                        var node = new MachineNodeModel(recipe, new Blazor.Diagrams.Core.Geometry.Point(savedNode.X, savedNode.Y))
                        {
                            Multiplier = savedNode.Multiplier
                        };

                        // Restauration du niveau de machine si nécessaire
                        if (!string.IsNullOrWhiteSpace(savedNode.MachineId) && node.CurrentMachineId != savedNode.MachineId)
                        {
                            while (node.CurrentMachineId != savedNode.MachineId && node.Upgrade()) { }
                        }

                        // Reconstitution de l'ordre personnalisé des ports
                        node.ApplyCustomPortOrder(savedNode.OrderedInputProductIds, savedNode.OrderedOutputProductIds);

                        tab.Diagram.Nodes.Add(node);
                        allNodesMap[savedNode.NodeId] = node;
                    }
                }

                // 2. Recréation des stockages
                for (int s = 0; s < savedTab.Storages.Count; s++)
                {
                    var savedStorage = savedTab.Storages[s];
                    var storageNode = new StorageNodeModel(
                        savedStorage.ProductId,
                        new Blazor.Diagrams.Core.Geometry.Point(savedStorage.X, savedStorage.Y)
                    );

                    tab.Diagram.Nodes.Add(storageNode);
                    allNodesMap[savedStorage.NodeId] = storageNode;
                }

                // 3. Recréation des portails Export / Import
                for (int p = 0; p < savedTab.Portals.Count; p++)
                {
                    var savedPortal = savedTab.Portals[p];
                    var portalNode = new PortalNodeModel(
                        savedPortal.Direction,
                        savedPortal.ProductId,
                        savedPortal.ChannelName,
                        new Blazor.Diagrams.Core.Geometry.Point(savedPortal.X, savedPortal.Y)
                    );

                    tab.Diagram.Nodes.Add(portalNode);
                    allNodesMap[savedPortal.NodeId] = portalNode;

                    if (savedPortal.Direction == PortalDirection.Export)
                    {
                        exportPortalIdMap[savedPortal.NodeId] = portalNode.Id;
                    }
                    else if (!string.IsNullOrWhiteSpace(savedPortal.SourceExportPortalId))
                    {
                        importedPortalsToRelink.Add((portalNode, savedPortal.SourceExportPortalId));
                    }
                }

                // 4. Reconnexion des câbles et tuyaux de l'onglet
                for (int j = 0; j < savedTab.Links.Count; j++)
                {
                    var savedLink = savedTab.Links[j];

                    // Recherche des nœuds source et cible dans le dictionnaire global
                    if (allNodesMap.TryGetValue(savedLink.SourceNodeId, out var srcNode) &&
                        allNodesMap.TryGetValue(savedLink.TargetNodeId, out var tgtNode))
                    {
                        // Recherche du port source correspondant par Direction et ProductId
                        var srcPort = srcNode.Ports.OfType<ResourcePortModel>()
                            .FirstOrDefault(p => p.Direction == savedLink.SourceDirection &&
                                                 string.Equals(p.ProductId, savedLink.SourceProductId, StringComparison.OrdinalIgnoreCase));

                        // Recherche du port cible correspondant par Direction et ProductId
                        var tgtPort = tgtNode.Ports.OfType<ResourcePortModel>()
                            .FirstOrDefault(p => p.Direction == savedLink.TargetDirection &&
                                                 string.Equals(p.ProductId, savedLink.TargetProductId, StringComparison.OrdinalIgnoreCase));

                        if (srcPort != null && tgtPort != null)
                        {
                            var link = new ResourceLinkModel(new SinglePortAnchor(srcPort), new SinglePortAnchor(tgtPort));

                            // Attribution de la couleur de la ressource
                            if (ProductDict.TryGetValue(srcPort.ProductId, out var prod) && !string.IsNullOrWhiteSpace(prod.Color))
                            {
                                link.Color = prod.Color;
                            }

                            // Restauration des sommets / points de passage
                            if (savedLink.Vertices != null)
                            {
                                foreach (var pt in savedLink.Vertices)
                                {
                                    if (pt.Length == 2)
                                    {
                                        link.Vertices.Add(new LinkVertexModel(link, new Blazor.Diagrams.Core.Geometry.Point(pt[0], pt[1])));
                                    }
                                }
                            }

                            tab.Diagram.Links.Add(link);
                        }
                    }
                }

                Tabs.Add(tab);

                _loadingProgress = (int)((double)(t + 1) / totalTabs * 90);
                _loadingStatusText = $"Loading tab '{tab.Name}' ({t + 1}/{totalTabs})...";
                StateHasChanged();
                await Task.Yield();
            }

            // Rebranche les portails Import vers les nouveaux identifiants des portails Export
            foreach (var (importPortal, oldExportId) in importedPortalsToRelink)
            {
                if (exportPortalIdMap.TryGetValue(oldExportId, out var newExportId))
                {
                    importPortal.SourceExportPortalId = newExportId;
                }
            }

            if (Tabs.Count == 0)
            {
                Tabs.Add(new FactoryTab { Name = "Principal", Diagram = CreateConfiguredDiagram() });
            }

            ActiveTab = Tabs[0];
            FlowEngine.RegisterTabs(Tabs);

            // 6. Finalisation : Désactive le verrou et lance UN SEUL calcul global des flux
            _loadingStatusText = "Flow calculation and balancing...";
            _loadingProgress = 100;
            StateHasChanged();
            await Task.Yield();

            _isBulkUpdating = false;
            FlowEngine.RecalculateFlows(Tabs, ResourceService);
            Diagram.Refresh();

            Snackbar.Add($"Diagram successfully loaded ({Tabs.Count} tab(s)) !", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error while loading : {ex.Message}", Severity.Error);
        }
        finally
        {
            // Sécurité : s'assure que le verrou et l'overlay sont toujours désactivés à la fin
            _isBulkUpdating = false;
            _isLoadingDiagram = false;
            StateHasChanged();
        }
    }

}