@page "/"
@inject HttpClient Http
@inject ResourceService ResourceService
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@using System.Text.Json

@implements IDisposable
@using Blazor.Diagrams
@using Blazor.Diagrams.Options
@using Blazor.Diagrams.Core.Anchors
@using Blazor.Diagrams.Core.Behaviors
@using Blazor.Diagrams.Core.Models
@using Blazor.Diagrams.Core.Models.Base
@using Blazor.Diagrams.Core.Geometry
@using Blazor.Diagrams.Components

@using CaptainArchitect.Models
@using CaptainArchitect.Components
@using CaptainArchitect.Services


<!-- Conteneur plein écran sombre sans marge ni débordement -->
<!-- Conteneur principal décalé de 48px pour ne pas passer sous MudAppBar -->
<div class="d-flex w-100 position-relative"
     style="height: calc(100vh - 48px); margin-top: 48px; background-color: #1e1e1e; overflow: hidden;">

    <!-- Bouton flottant pour ouvrir le tiroir si replié -->
    @if (!_drawerOpen)
    {
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       OnClick="@ToggleDrawer"
                       Class="drawer-toggle-btn"
                       Title="Ouvrir le catalogue" />
    }

    <!-- Tiroir latéral rétractable MudBlazor -->
    <MudDrawer @bind-Open="@_drawerOpen"
               ClipMode="DrawerClipMode.Never"
               Elevation="4"
               Variant="@DrawerVariant.Responsive"
               Width="340px"
               Class="pa-3 bg-dark-drawer d-flex flex-column h-100"
               Style="border-right: 1px solid #333; z-index: 200;">

        <!-- 1. ZONE FIXE DU HAUT DU TIROIR -->
        <div style="flex-shrink: 0;">

            <!-- En-tête : Titre + Bouton de fermeture -->
            <div class="d-flex align-center justify-space-between mb-2">
                <MudText Typo="Typo.subtitle1" Class="fw-bold" Style="color: #e4e4e7;">Recipe Catalog</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                               Size="MudBlazor.Size.Small"
                               Color="Color.Default"
                               OnClick="@ToggleDrawer"
                               Title="Fermer le panneau" />
            </div>

            <!-- Barre d'outils Fichier compacte et harmonisée -->
            <div class="toolbar-box mb-3 d-flex align-center justify-space-between px-2 py-1">

                <!-- 1. Bouton Sauvegarder -->
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           Size="MudBlazor.Size.Small"
                           Class="tool-btn"
                           OnClick="SaveDiagram">
                    Save
                </MudButton>

                <!-- 2. Bouton Charger : InputFile natif masqué + Bouton label propre -->
                <InputFile id="fileInputLoader" OnChange="LoadDiagram" accept=".json" style="display: none;" />

                <MudButton HtmlTag="label"
                           Variant="Variant.Outlined"
                           Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.FolderOpen"
                           Size="MudBlazor.Size.Small"
                           Class="tool-btn"
                           for="fileInputLoader">
                    Load
                </MudButton>

                <!-- 3. Bouton Nouveau projet (réinitialise toute l'usine après confirmation) -->
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.NoteAdd"
                           Size="MudBlazor.Size.Small"
                           Class="tool-btn"
                           OnClick="NewFactory">
                    New
                </MudButton>

                <!-- 4. Bouton Vider l'onglet actif -->
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteSweep"
                           Size="MudBlazor.Size.Small"
                           Class="tool-btn text-muted-hover"
                           OnClick="ClearDiagram">
                    Clear Tab
                </MudButton>

            </div>


            <!-- HISTORIQUE DES DERNIÈRES RECHERCHES -->
            @if (_recentProducts.Count > 0)
            {
                <div class="mb-2">

                    <!-- Titre compact pour l'historique -->
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1 fw-bold">
                        Search history :
                    </MudText>

                    <!-- Bandeau horizontal défilant avec les icônes (sans JS inline 'this') -->
                    <div class="d-flex align-center gap-1 overflow-x-auto pb-1 recent-search-bar">
                        
                        @foreach (var prod in _recentProducts)
                        {
                            <!-- 1. key force Blazor à recréer l'élément sans garder l'état d'erreur du précédent -->
                            <div @key="prod.Id"
                                 class="recent-item-badge"
                                 @onclick="@(() => SelectRecentProduct(prod))"
                                 title="@prod.Name">

                                @if (!_failedRecentImages.Contains(prod.Id))
                                {
                                    <img src="@GetProductImagePath(prod)"
                                         alt="@prod.Name"
                                         class="recent-item-icon"
                                         @onerror="@(() => MarkRecentImageFailed(prod.Id))" />
                                }
                                else
                                {
                                    <!-- Repli : affiche les 2-3 lettres si l'image est introuvable -->
                                    <span class="recent-item-fallback">
                                        @GetShortFallbackName(prod)
                                    </span>
                                }

                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Barre de recherche avec autocomplétion des produits -->
            <MudAutocomplete T="Product"
                             Placeholder="Find a product..."
                             SearchFunc="@SearchProducts"
                             ToStringFunc="@(p => p?.Name ?? string.Empty)"
                             Value="_selectedProduct"
                             ValueChanged="@OnProductSelected"
                             Clearable="true"
                             ResetValueOnEmptyText="true"
                             CoerceText="false"
                             CoerceValue="false"
                             Dense="true"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Adornment="Adornment.Start"
                             AdornmentIcon="@Icons.Material.Filled.Search"
                             MaxItems="300"
                             MaxHeight="300"
                             SelectValueOnTab="false"
                             @onkeyup="HandleSearchKeyDown"
                             Class="mb-2 search-autocomplete"
                             PopoverClass="autocomplete-popover-dark">

                <!-- Rendu personnalisé de chaque ligne dans la liste déroulante -->
                <ItemTemplate Context="prod">
                    <div class="d-flex align-center gap-2 py-1">

                        @if (!_failedRecentImages.Contains(prod.Id))
                        {
                            <img src="@GetProductImagePath(prod)"
                                 alt="@prod.Name"
                                 style="width: 24px; height: 24px; object-fit: contain; flex-shrink: 0;"
                                 @onerror="@(() => MarkRecentImageFailed(prod.Id))" />
                        }

                        <!-- Libellé du produit -->
                        <MudText Typo="Typo.body2">@prod.Name</MudText>

                    </div>
                </ItemTemplate>

                <!-- Message si aucun produit ne correspond à la saisie -->
                <NoItemsTemplate>
                    <MudText Typo="Typo.body2" Class="pa-2 text-muted">Aucun produit trouvé</MudText>
                </NoItemsTemplate>

            </MudAutocomplete>

            <!-- Filtres : Tout / Entrées / Sorties -->
            <MudToggleGroup T="ResourceFilterMode"
                            @bind-Value="_filterMode"
                            Color="Color.Primary"
                            CheckMark="false"
                            FixedContent="true"
                            Size="MudBlazor.Size.Small"
                            Class="mb-3 w-100 d-flex justify-center mode-toggle-group">
                <MudToggleItem Value="ResourceFilterMode.All" Text="All" Class="flex-grow-1 text-center" />
                <MudToggleItem Value="ResourceFilterMode.Input" Text="Input" Class="flex-grow-1 text-center" />
                <MudToggleItem Value="ResourceFilterMode.Output" Text="Output" Class="flex-grow-1 text-center" />
            </MudToggleGroup>

        </div>

        <!-- 2. ZONE SCROLLABLE DE LA LISTE DES RECETTES -->
        <div class="recipes-list flex-grow-1" style="overflow-y: auto; min-height: 0;">
            @if (FilteredRecipes != null)
            {
                <Virtualize Items="@FilteredRecipes.ToList()" Context="recipe">
                    <MudCard Class="mb-2 recipe-card" Outlined="true">
                        <MudCardContent Class="pa-2">

                            <div class="d-flex justify-space-between align-center">

                                <!-- Titre éclairci avec la classe recipe-title -->
                                <MudText Typo="Typo.subtitle2" Class="fw-bold recipe-title">@recipe.RecipeId</MudText>

                                <MudIconButton Icon="@Icons.Material.Filled.AddCircle"
                                               Color="Color.Primary"
                                               Size="MudBlazor.Size.Small"
                                               Title="Add to the diagram"
                                               OnClick="@(() => AddRecipeNode(recipe))" />
                            </div>

                            <!-- Entrées & Sorties -->
                            <div class="d-flex align-center gap-1 mt-1">

                                <!-- Libellé In: avec recipe-in-label -->
                                <MudText Typo="Typo.caption" Class="recipe-in-label me-1">In:</MudText>

                                @foreach (var input in recipe.Inputs)
                                {
                                    @if (!string.IsNullOrWhiteSpace(input.ProductId))
                                    {
                                        <ResourceBadge @key="@($"{recipe.RecipeId}_in_{input.ProductId}")"
                                                       ProductId="@input.ProductId" />
                                    }
                                }

                                <!-- Libellé Out: avec recipe-out-label -->
                                <MudText Typo="Typo.caption" Class="recipe-out-label ms-2 me-1">Out:</MudText>

                                @foreach (var output in recipe.Outputs)
                                {
                                    @if (!string.IsNullOrWhiteSpace(output.ProductId))
                                    {
                                        <ResourceBadge @key="@($"{recipe.RecipeId}_out_{output.ProductId}")"
                                                       ProductId="@output.ProductId" />
                                    }
                                }
                            </div>
                        </MudCardContent>
                    </MudCard>
                </Virtualize>
            }
            else
            {
                <MudProgressCircular Indeterminate="true" Size="MudBlazor.Size.Small" />
            }
        </div>

    </MudDrawer>


    <!-- =========================================================================
         ZONE PRINCIPALE À DROITE : BARRE D'ONGLETS EN HAUT + CANVAS EN DESSOUS
         ========================================================================= -->
    <div class="flex-grow-1 h-100 d-flex flex-column position-relative outline-none"
         style="background-color: #1a1a1a; min-width: 0; min-height: 0;"
         tabindex="0"
         @onkeydown="HandleKeyDown"
         @oncontextmenu:preventDefault="true">

        <!-- =========================================================================
             1. BARRE SUPÉRIEURE DU BUS INTER-ONGLETS (EXPORT BUS / IMPORT BUS)
             Placée juste sous la barre de titre CaptainArchitect et au-dessus des onglets
             ========================================================================= -->
        <div class="factory-bus-bar d-flex align-center justify-space-between w-100 px-2 py-1"
             style="@($"{(_drawerOpen ? "padding-left: 348px !important;" : "padding-left: 54px !important;")} {(_summaryDrawerOpen ? "padding-right: 268px !important;" : "padding-right: 54px !important;")}")">
            
             <!-- Côté gauche : Menu pour ajouter un stockage avec filtre de recherche intégré -->
            <div class="d-flex align-center">
                <MudMenu Label="Add Storage"
                         StartIcon="@Icons.Material.Filled.Inventory2"
                         Variant="Variant.Filled"
                         Color="Color.Info"
                         Size="MudBlazor.Size.Small"
                         Dense="true"
                         MaxHeight="350">

                    <!-- 1. Champ de recherche épinglé en haut du menu -->
                    <div class="px-2 pt-2 pb-1" @onclick:stopPropagation="true">
                        <MudTextField @bind-Value="_storageFilterText"
                                      Placeholder="Filter products..."
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      IconSize="MudBlazor.Size.Small"
                                      Immediate="true"
                                      Clearable="true"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                    </div>

                    <MudDivider Class="my-1" />

                    <!-- 2. Liste déroulante filtrée dynamiquement -->
                    @if (FilteredStorageProducts.Any())
                    {
                        @foreach (var prod in FilteredStorageProducts)
                        {
                            <MudMenuItem OnClick="@(() => AddStorageNode(prod.Id))">
                                <div class="d-flex align-center gap-2">
                                    <ResourceBadge ProductId="@prod.Id" />
                                    <span>@prod.Name</span>
                                </div>
                            </MudMenuItem>
                        }
                    }
                    else
                    {
                        <!-- Message affiché si aucune ressource ne correspond -->
                        <div class="pa-2 text-center" style="color: #71717a; font-size: 0.8rem;">
                            No product found
                        </div>
                    }
                </MudMenu>
            </div>


            <!-- Côté droit : Boutons Portails Bus (Export / Import entre onglets) -->
            <div class="d-flex align-center gap-2">
                <!-- Menu Poser un Portail EXPORT -->
                <MudMenu Label="Export Bus"
                         StartIcon="@Icons.Material.Filled.Output"
                         Variant="Variant.Outlined"
                         Color="Color.Secondary"
                         Size="MudBlazor.Size.Small"
                         Dense="true"
                         MaxHeight="350">
                    <div class="px-2 pt-2 pb-1" @onclick:stopPropagation="true">
                        <MudTextField @bind-Value="_portalFilterText"
                                      Placeholder="Filter resource..."
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      Clearable="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search" />
                    </div>
                    <MudDivider Class="my-1" />
                    @foreach (var prod in FilteredPortalProducts)
                    {
                        <MudMenuItem OnClick="@(() => AddExportPortalNode(prod.Id))">
                            <div class="d-flex align-center gap-2">
                                <ResourceBadge ProductId="@prod.Id" />
                                <span>@prod.Name</span>
                            </div>
                        </MudMenuItem>
                    }
                </MudMenu>

                <!-- Menu Poser un Portail IMPORT -->
                <MudMenu Label="Import Bus"
                         StartIcon="@Icons.Material.Filled.Input"
                         Variant="Variant.Filled"
                         Color="Color.Info"
                         Size="MudBlazor.Size.Small"
                         Dense="true"
                         MaxHeight="350">
                    @{
                        var allExports = GetAllExportPortals().ToList();
                    }
                    @if (allExports.Count == 0)
                    {
                        <MudMenuItem Disabled="true">No Export created in tabs</MudMenuItem>
                    }
                    else
                    {
                        @foreach (var item in allExports)
                        {
                            <MudMenuItem OnClick="@(() => AddImportPortalNode(item.Portal))">
                                <div class="d-flex align-center gap-2">
                                    <ResourceBadge ProductId="@item.Portal.ProductId" />
                                    <span><strong>[@item.TabName]</strong> @item.Portal.ChannelName (@item.Portal.TotalInputRate.ToString("0.#")/m)</span>
                                </div>
                            </MudMenuItem>
                        }
                    }
                </MudMenu>
            </div>

        </div>

        <!-- =========================================================================
             2. BARRE DES ONGLETS D'USINE (PLEINE LARGEUR DISPONIBLE)
             ========================================================================= -->
        <div class="factory-tabs-bar d-flex align-center px-2 py-1"
             style="@($"{(_drawerOpen ? "padding-left: 348px !important;" : "padding-left: 12px !important;")} {(_summaryDrawerOpen ? "padding-right: 268px !important;" : "padding-right: 12px !important;")}")">

            <!-- Liste horizontale des onglets (réorganisable par glisser-déposer) -->
            <div class="d-flex align-center gap-1 flex-wrap" style="min-width: 0;">
                @foreach (var tab in Tabs)
                {
                    bool isActive = tab.Id == ActiveTab?.Id;
                    bool isDragging = _draggedTab?.Id == tab.Id;
                    bool isDragOver = _dragOverTab?.Id == tab.Id && _draggedTab?.Id != tab.Id;

                    <div @key="tab.Id"
                         draggable="true"
                         class="factory-tab-chip @(isActive ? "active" : "") @(isDragging ? "dragging" : "") @(isDragOver ? "drag-over" : "")"
                         title="Click to open • Drag and drop to change the order"
                         @onclick="@(() => SelectTab(tab.Id))"
                         @ondragstart="@(() => OnTabDragStart(tab))"
                         @ondragenter="@(() => OnTabDragEnter(tab))"
                         @ondragover:preventDefault="true"
                         @ondrop="@(() => OnTabDrop(tab))"
                         @ondragend="OnTabDragEnd">

                         <!-- Icône de ressource si une icône a été choisie pour cet onglet -->
                        @if (!string.IsNullOrWhiteSpace(tab.IconProductId) && ProductDict.TryGetValue(tab.IconProductId, out var tabProd))
                        {
                            <img src="@GetProductImagePath(tabProd)"
                                 alt="@tab.Name"
                                 class="tab-resource-icon"
                                 draggable="false" />
                        }

                        <span class="tab-name">@tab.Name</span>

                        <!-- Bouton modifier le nom et l'icône de l'onglet -->
                        <button type="button"
                                draggable="false"
                                class="tab-action-btn edit"
                                title="Edit Tab Name & Icon"
                                @onclick="@(() => OpenEditTabModal(tab))"
                                @onclick:stopPropagation="true"
                                @ondragstart:stopPropagation="true">
                            ✎
                        </button>

                        <!-- Bouton supprimer l'onglet (affiché s'il y a au moins 2 onglets) -->
                        @if (Tabs.Count > 1)
                        {
                            <button type="button"
                                    draggable="false"
                                    class="tab-action-btn close"
                                    title="Delete Tab"
                                    @onclick="@(() => RemoveTab(tab))"
                                    @onclick:stopPropagation="true"
                                    @ondragstart:stopPropagation="true">
                                ✕
                            </button>
                        }

                    </div>
                }

                <!-- Bouton Ajouter un nouvel onglet -->
                <MudButton Variant="Variant.Text"
                           Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.Add"
                           Size="MudBlazor.Size.Small"
                           Class="tool-btn"
                           OnClick="AddNewTab">
                    Tab
                </MudButton>
            </div>

        </div>


        <!-- 2. ZONE DU CANVAS DE L'ONGLET ACTIF -->
        <div class="flex-grow-1 w-100 position-relative"
             style="min-height: 0; overflow: hidden;"
             @onpointerdown="OnCanvasPointerDown"
             @onpointermove="OnCanvasPointerMove"
             @onpointerup="OnCanvasPointerUp"
             @oncontextmenu="OnCanvasContextMenu"
             @oncontextmenu:preventDefault="true">

            @if (Diagram != null)
            {
                <CascadingValue Value="Diagram">
                    <CascadingValue Name="AllFactoryTabs" Value="Tabs">
                        <CascadingValue Name="SelectTabCallback" Value="EventCallback.Factory.Create<string>(this, SelectTab)">
                            <!-- @key force Blazor à remonter proprement le canvas lors d'un changement d'onglet -->
                            <DiagramCanvas @key="ActiveTab.Id" Class="diagram-container" />
                        </CascadingValue>
                    </CascadingValue>
                </CascadingValue>
            }

            <!-- Rectangle visuel de multi-sélection (affiché pendant Shift + maintien clic gauche) -->
            @if (_isBoxSelecting)
            {
                <div class="selection-marquee-box" style="@SelectionBoxStyle"></div>
            }


<!-- =========================================================================
                 MENU CONTEXTUEL FAÇON WINDOWS (CLIC DROIT SUR LE DIAGRAMME)
                 ========================================================================= -->
            @if (_contextMenuVisible)
            {
                <!-- Fond transparent pour fermer le menu si l'utilisateur clique à côté -->
                <div class="win-context-backdrop"
                     @onpointerdown="CloseContextMenu"
                     @oncontextmenu="CloseContextMenu"
                     @oncontextmenu:preventDefault="true">
                </div>

                <!-- Fenêtre du menu contextuel positionnée au niveau du curseur -->
                <div class="win-context-menu"
                     style="@ContextMenuStyle"
                     @onpointerdown:stopPropagation="true"
                     @oncontextmenu:preventDefault="true"
                     @oncontextmenu:stopPropagation="true">

                    <!-- 1. Option d'aide tout en haut -->
                    <button type="button"
                            class="win-context-item"
                            @onclick="OpenHelpFromContextMenu">
                        <span class="win-context-left">
                            <MudIcon Icon="@Icons.Material.Filled.HelpOutline" Size="MudBlazor.Size.Small" Style="color: #38bdf8; font-size: 16px;" />
                            <span>Help &amp; Controls</span>
                        </span>
                        <span class="win-context-shortcut">F1</span>
                    </button>

                    <div class="win-context-separator"></div>

                    <!-- 2. Copier (actif uniquement si au moins un nœud est sélectionné) -->
                    <button type="button"
                            class="win-context-item"
                            disabled="@(!CanCopyOrCut)"
                            @onclick="CopyFromContextMenu">
                        <span class="win-context-left">
                            <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Size="MudBlazor.Size.Small" Style="font-size: 15px;" />
                            <span>Copy</span>
                        </span>
                        <span class="win-context-shortcut">Ctrl+C</span>
                    </button>

                    <!-- 3. Couper (actif uniquement si au moins un nœud ou lien est sélectionné) -->
                    <button type="button"
                            class="win-context-item"
                            disabled="@(!CanDeleteSelection)"
                            @onclick="CutFromContextMenu">
                        <span class="win-context-left">
                            <MudIcon Icon="@Icons.Material.Filled.ContentCut" Size="MudBlazor.Size.Small" Style="font-size: 15px;" />
                            <span>Cut</span>
                        </span>
                        <span class="win-context-shortcut">Ctrl+X</span>
                    </button>

                    <!-- 4. Coller (actif uniquement si le presse-papiers contient une copie) -->
                    <button type="button"
                            class="win-context-item"
                            disabled="@(!CanPaste)"
                            @onclick="PasteFromContextMenu">
                        <span class="win-context-left">
                            <MudIcon Icon="@Icons.Material.Filled.ContentPaste" Size="MudBlazor.Size.Small" Style="font-size: 15px;" />
                            <span>Paste</span>
                        </span>
                        <span class="win-context-shortcut">Ctrl+V</span>
                    </button>

                    <div class="win-context-separator"></div>

                    <!-- 5. Supprimer (actif uniquement si au moins un nœud ou lien est sélectionné) -->
                    <button type="button"
                            class="win-context-item danger"
                            disabled="@(!CanDeleteSelection)"
                            @onclick="DeleteFromContextMenu">
                        <span class="win-context-left">
                            <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" Size="MudBlazor.Size.Small" Style="font-size: 16px;" />
                            <span>Delete</span>
                        </span>
                        <span class="win-context-shortcut">Del</span>
                    </button>

                </div>
            }


            <!-- =========================================================================
                 FENÊTRE MODALE D'AIDE DES COMMANDES (HELP & CONTROLS)
                 ========================================================================= -->
            <MudOverlay Visible="@_isHelpModalOpen"
                        DarkBackground="true"
                        Absolute="true"
                        ZIndex="1200">
                <div class="pa-5 rounded-lg"
                     style="background: #27272a; border: 1px solid #3f3f46; width: 520px; max-width: 94vw; max-height: 85vh; overflow-y: auto; box-shadow: 0 14px 35px rgba(0,0,0,0.8); color: #f4f4f5;"
                     @onclick:stopPropagation="true"
                     @onkeydown:stopPropagation="true">

                    <!-- En-tête de la fenêtre d'aide -->
                    <div class="d-flex align-center justify-space-between mb-3 pb-2" style="border-bottom: 1px solid #3f3f46;">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.HelpOutline" Color="Color.Info" />
                            <MudText Typo="Typo.h6" Style="color: #38bdf8; font-weight: 600;">
                                Diagram Controls &amp; Shortcuts
                            </MudText>
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                       Size="MudBlazor.Size.Small"
                                       Color="Color.Default"
                                       OnClick="@(() => _isHelpModalOpen = false)" />
                    </div>

                    <!-- Section 1 : Souris & Sélection -->
                    <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: #38bdf8; font-weight: 700;">
                        Mouse &amp; Selection
                    </MudText>
                    <div class="help-grid mb-4">
                        <div class="help-key">Left-Click + Drag (Canvas)</div>
                        <div class="help-desc">Pan / move around the factory diagram.</div>

                        <div class="help-key">Mouse Wheel</div>
                        <div class="help-desc">Zoom in and out on the diagram.</div>

                        <div class="help-key">Left-Click (Item / Pipe)</div>
                        <div class="help-desc">Select a machine, storage, portal, or pipe.</div>

                        <div class="help-key">Shift + Left-Click + Drag</div>
                        <div class="help-desc">Draw a selection box to multi-select items and pipes.</div>

                        <div class="help-key">Right-Click (Canvas)</div>
                        <div class="help-desc">Open this context menu (Help, Copy, Cut, Paste, Delete).</div>
                    </div>

                    <!-- Section 2 : Tuyaux & Connexions -->
                    <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: #38bdf8; font-weight: 700;">
                        Pipes &amp; Flow Routing
                    </MudText>
                    <div class="help-grid mb-4">
                        <div class="help-key">Drag from Output Port</div>
                        <div class="help-desc">Connect a resource output to a matching input port.</div>

                        <div class="help-key">Double-Click on Pipe</div>
                        <div class="help-desc">Add a waypoint handle to bend the pipe path.</div>

                        <div class="help-key">Drag Flow Badge / Handle</div>
                        <div class="help-desc">Reshape the pipe curve freely.</div>

                        <div class="help-key">Right-Click on Handle / Pipe</div>
                        <div class="help-desc">Remove the waypoint handle (or delete the pipe).</div>
                    </div>

                    <!-- Section 3 : Raccourcis Clavier & Bilan -->
                    <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: #38bdf8; font-weight: 700;">
                        Keyboard Shortcuts &amp; Summary
                    </MudText>
                    <div class="help-grid mb-4">
                        <div class="help-key">Ctrl + C / Ctrl + X</div>
                        <div class="help-desc">Copy or Cut selected machines and their internal pipes.</div>

                        <div class="help-key">Ctrl + V</div>
                        <div class="help-desc">Paste copied items into the active tab.</div>

                        <div class="help-key">Ctrl + D</div>
                        <div class="help-desc">Duplicate the selected item(s) immediately.</div>

                        <div class="help-key">Delete / Backspace</div>
                        <div class="help-desc">Delete selected items or pipes (with confirmation).</div>

                        <div class="help-key">Right-Click Resource Icon</div>
                        <div class="help-desc">In the right Production Summary, jump to each producer in a loop.</div>
                    </div>

                    <!-- Bouton Fermer -->
                    <div class="d-flex justify-end">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Info"
                                   Size="MudBlazor.Size.Small"
                                   OnClick="@(() => _isHelpModalOpen = false)">
                            Close
                        </MudButton>
                    </div>

                </div>
            </MudOverlay>



            <!-- Overlay d'avancement du chargement de la sauvegarde -->
            <MudOverlay Visible="@_isLoadingDiagram"
                        DarkBackground="true"
                        Absolute="true"
                        ZIndex="1000">
                <div class="d-flex flex-column align-center justify-center pa-6 rounded-lg"
                     style="background: #27272a; border: 1px solid #3f3f46; min-width: 320px; box-shadow: 0 10px 25px rgba(0,0,0,0.6);">

                    <MudProgressCircular Color="Color.Info"
                                         Size="MudBlazor.Size.Large"
                                         Indeterminate="@(_loadingProgress == 0)"
                                         Value="@_loadingProgress"
                                         Class="mb-4" />

                    <MudText Typo="Typo.h6" Class="mb-1" Style="color: #38bdf8; font-weight: 600;">
                        Loading the factory...
                    </MudText>

                    <MudText Typo="Typo.body2" Class="mb-3 text-secondary" Style="color: #a1a1aa;">
                        @_loadingStatusText
                    </MudText>

                    <MudProgressLinear Color="Color.Info"
                                       Value="@_loadingProgress"
                                       Rounded="true"
                                       Size="MudBlazor.Size.Medium"
                                       Style="width: 100%; height: 8px;" />

                    <MudText Typo="Typo.caption" Class="mt-2" Style="color: #71717a;">
                        @($"{_loadingProgress}%")
                    </MudText>
                </div>
            </MudOverlay>


            <!-- Fenêtre modale d'édition du nom et de l'icône d'un onglet -->
            <MudOverlay Visible="@_isEditingTab"
                        DarkBackground="true"
                        Absolute="true"
                        ZIndex="1100">
                <div class="pa-5 rounded-lg"
                     style="background: #27272a; border: 1px solid #3f3f46; width: 380px; max-width: 92vw; box-shadow: 0 12px 30px rgba(0,0,0,0.75); color: #f4f4f5;"
                     @onclick:stopPropagation="true"
                     @onkeydown:stopPropagation="true">

                    <!-- Titre de la fenêtre -->
                    <div class="d-flex align-center justify-space-between mb-3">
                        <MudText Typo="Typo.h6" Style="color: #38bdf8; font-weight: 600;">
                            Edit tab
                        </MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                       Size="MudBlazor.Size.Small"
                                       Color="Color.Default"
                                       OnClick="CancelEditTab" />
                    </div>

                    <!-- 1. Recherche d'une ressource pour choisir son icône et remplir le nom -->
                    <MudText Typo="Typo.caption" Style="color: #a1a1aa;" Class="d-block mb-1">
                        Select a resource (automatically fills in the name) :
                    </MudText>

                    <MudAutocomplete T="Product"
                                     Placeholder="Search for a resource..."
                                     SearchFunc="@SearchTabIconProducts"
                                     ToStringFunc="@(p => p?.Name ?? string.Empty)"
                                     Value="_editingTabSelectedProduct"
                                     ValueChanged="@OnEditTabProductSelected"
                                     Clearable="true"
                                     ResetValueOnEmptyText="true"
                                     CoerceText="false"
                                     CoerceValue="false"
                                     Dense="true"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Adornment="Adornment.Start"
                                     AdornmentIcon="@Icons.Material.Filled.Search"
                                     MaxItems="300"
                                     MaxHeight="240"
                                     Class="mb-3 search-autocomplete"
                                     PopoverClass="autocomplete-popover-dark">

                        <!-- Ligne de suggestion avec l'icône et le nom de la ressource -->
                        <ItemTemplate Context="prod">
                            <div class="d-flex align-center gap-2 py-1">
                                <img src="@GetProductImagePath(prod)"
                                     alt="@prod.Name"
                                     style="width: 22px; height: 22px; object-fit: contain; flex-shrink: 0;" />
                                <MudText Typo="Typo.body2">@prod.Name</MudText>
                            </div>
                        </ItemTemplate>

                        <NoItemsTemplate>
                            <MudText Typo="Typo.body2" Class="pa-2 text-muted">Aucune ressource trouvée</MudText>
                        </NoItemsTemplate>
                    </MudAutocomplete>

                    <!-- 2. Champ texte du nom de l'onglet (pré-rempli par la ressource ou saisi librement) -->
                    <MudText Typo="Typo.caption" Style="color: #a1a1aa;" Class="d-block mb-1">
                        Tab name :
                    </MudText>

                    <MudTextField @bind-Value="_editingTabName"
                                  Placeholder="Tab name"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Class="mb-3 search-autocomplete"
                                  @onkeyup="HandleEditTabKeyUp" />

                    <!-- 3. Aperçu en direct de l'onglet avec son icône -->
                    <div class="d-flex align-center justify-space-between pa-2 mb-4 rounded"
                         style="background: #18181b; border: 1px solid #3f3f46;">
                        <div class="d-flex align-center gap-2">
                            <span style="font-size: 0.72rem; color: #71717a;">Preview :</span>
                            <div class="factory-tab-chip active" style="cursor: default;">
                                @if (!string.IsNullOrWhiteSpace(_editingTabIconProductId) && ProductDict.TryGetValue(_editingTabIconProductId, out var previewProd))
                                {
                                    <img src="@GetProductImagePath(previewProd)"
                                         alt="@previewProd.Name"
                                         class="tab-resource-icon" />
                                }
                                <span class="tab-name">@(string.IsNullOrWhiteSpace(_editingTabName) ? "Onglet" : _editingTabName)</span>
                            </div>
                        </div>

                        <!-- Bouton pour retirer l'icône si on veut un onglet uniquement textuel -->
                        @if (!string.IsNullOrWhiteSpace(_editingTabIconProductId))
                        {
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Warning"
                                       Size="MudBlazor.Size.Small"
                                       Style="font-size: 0.70rem; text-transform: none;"
                                       OnClick="ClearEditTabIcon">
                                Sans icône
                            </MudButton>
                        }
                    </div>

                    <!-- 4. Boutons d'action Annuler / Valider -->
                    <div class="d-flex justify-end gap-2">
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Default"
                                   Size="MudBlazor.Size.Small"
                                   OnClick="CancelEditTab">
                            Annuler
                        </MudButton>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Info"
                                   Size="MudBlazor.Size.Small"
                                   Disabled="@string.IsNullOrWhiteSpace(_editingTabName)"
                                   OnClick="ConfirmEditTab">
                            Valider
                        </MudButton>
                    </div>

                </div>
            </MudOverlay>


        </div>


    </div>

    <!-- Bouton flottant en haut à droite pour ouvrir le bilan s'il est fermé -->
    @if (!_summaryDrawerOpen)
    {
        <MudTooltip Text="Overall production summary" Placement="Placement.Left">
            <MudIconButton Icon="@Icons.Material.Filled.Analytics"
                           Color="Color.Info"
                           OnClick="@ToggleSummaryDrawer"
                           Class="summary-toggle-btn" />
        </MudTooltip>
    }


    <!-- Tiroir rétractable ancré à droite -->
    <MudDrawer @bind-Open="@_summaryDrawerOpen"
               Anchor="MudBlazor.Anchor.End"
               ClipMode="DrawerClipMode.Never"
               Elevation="4"
               Variant="@DrawerVariant.Persistent"
               Width="260px"
               Class="pa-3 bg-dark-drawer d-flex flex-column h-100"
               Style="border-left: 1px solid #333; z-index: 200;">

        <!-- 1. EN-TÊTE DU BILAN -->
        <div style="flex-shrink: 0;">
            <div class="d-flex align-center justify-space-between mb-2">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.Analytics" Color="Color.Info" Size="MudBlazor.Size.Small" />
                    <MudText Typo="Typo.subtitle1" Class="fw-bold" Style="color: #e4e4e7;">
                        Production Summary
                    </MudText>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                               Size="MudBlazor.Size.Small"
                               Color="Color.Default"
                               OnClick="@ToggleSummaryDrawer"
                               Title="Close the balance sheet" />
            </div>

            <!-- Champ de recherche rapide dans le bilan -->
            <MudTextField @bind-Value="_summaryFilterText"
                          Placeholder="Filter resources..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="MudBlazor.Size.Small"
                          Immediate="true"
                          Clearable="true"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-2 search-autocomplete" />

            <!-- Filtre d'état compact : All / Deficit / Surplus -->
            <MudToggleGroup T="BalanceFilterMode"
                            @bind-Value="_balanceFilterMode"
                            Color="Color.Info"
                            CheckMark="false"
                            FixedContent="true"
                            Size="MudBlazor.Size.Small"
                            Class="mb-2 w-100 d-flex justify-center mode-toggle-group summary-toggle-group">
                <MudToggleItem Value="BalanceFilterMode.All" Text="All" Class="flex-grow-1 text-center" />
                <MudToggleItem Value="BalanceFilterMode.Deficit" Text="Deficit" Class="flex-grow-1 text-center" />
                <MudToggleItem Value="BalanceFilterMode.Surplus" Text="Surplus" Class="flex-grow-1 text-center" />
            </MudToggleGroup>
        </div>

        <!-- 2. LISTE DÉFILANTE DES RESSOURCES -->
        <div class="recipes-list flex-grow-1" style="overflow-y: auto; min-height: 0;">
            @{
                var items = FilteredSummaryBalances.ToList();
            }

            @if (items.Count == 0)
            {
                <div class="pa-4 text-center" style="color: #71717a; font-size: 0.85rem;">
                    No resources passing through the diagram.
                </div>
            }
            else
            {
                @foreach (var item in items)
                {
                    // Détermination de la classe couleur et du texte formaté pour le bilan net
                    string netClass = item.NetBalance > 0.01m ? "balance-surplus"
                                    : item.NetBalance < -0.01m ? "balance-deficit"
                                    : "balance-neutral";

                    string netFormatted = item.NetBalance > 0.01m ? $"+{item.NetBalance:0.##}/m"
                                        : item.NetBalance < -0.01m ? $"{item.NetBalance:0.##}/m"
                                        : "0/m";

                    <div @key="item.ProductId" class="summary-resource-card mb-2 pa-2">

                        <!-- Ligne supérieure : Icône + Nom + Badge Bilan Net -->
                        <div class="d-flex align-center justify-space-between mb-1">
                            <div class="d-flex align-center gap-2"
                                 style="min-width: 0;"
                                 title="Left-click: filter recipes • Right-click: locate the producing machine">

                                <ResourceBadge ProductId="@item.ProductId"
                                               OnRightClick="@(() => NavigateToNextProducer(item.ProductId))" />

                                <span class="summary-prod-name" title="@item.ProductName">@item.ProductName</span>
                            </div>

                            <!-- Bilan net avec code couleur -->
                            <span class="balance-badge @netClass">
                                @netFormatted
                            </span>
                        </div>

                        <!-- Ligne inférieure : Production brute totale & Consommation totale -->
                        <div class="d-flex align-center justify-space-between mt-1 pt-1" style="border-top: 1px solid #3f3f46; font-size: 0.74rem;">
                            <span style="color: #a1a1aa;">
                                Prod: <strong style="color: #e4e4e7;">@item.TotalProduced.ToString("0.##")/m</strong>
                            </span>
                            <span style="color: #a1a1aa;">
                                Cons: <strong style="color: #e4e4e7;">@item.TotalConsumed.ToString("0.##")/m</strong>
                            </span>
                        </div>
                    </div>
                }
            }
        </div>

    </MudDrawer>



</div>



<style>

    /* Barre supérieure dédiée aux portails Bus (Export / Import) */
    .factory-bus-bar {
        background: #18181c;
        border-bottom: 1px solid #27272a;
        min-height: 40px;
        flex-shrink: 0;
        z-index: 55;
    }

    /* Barre des onglets d'usine (juste sous la barre Bus) */
    .factory-tabs-bar {
        background: #141418;
        border-bottom: 1px solid #333;
        min-height: 38px;
        flex-shrink: 0;
        z-index: 50;
    }

    .factory-tab-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: 6px;
        background: #1e1e22;
        border: 1px solid #3f3f46;
        color: #a1a1aa;
        font-size: 0.80rem;
        cursor: pointer;
        user-select: none;
        transition: all 0.15s ease;
    }

        .factory-tab-chip:hover {
            border-color: #71717a;
            color: #f4f4f5;
        }

        .factory-tab-chip.active {
            background: #27272a;
            border-color: #38bdf8;
            color: #ffffff;
            font-weight: 600;
            box-shadow: 0 0 0 1px rgba(56, 189, 248, 0.25);
        }

        /* Style visuel de l'onglet en cours de déplacement (Drag) */
        .factory-tab-chip.dragging {
            opacity: 0.45;
            border-style: dashed;
        }

        /* Indicateur visuel sur l'onglet cible lors du survol (Drop) */
        .factory-tab-chip.drag-over {
            border-left: 3px solid #38bdf8 !important;
            background: #2e323b !important;
            transform: translateX(2px);
        }

    /* Icône de ressource affichée à gauche du nom de l'onglet */
    .tab-resource-icon {
        width: 18px;
        height: 18px;
        object-fit: contain;
        flex-shrink: 0;
        user-select: none;
        -webkit-user-drag: none;
    }

    .tab-action-btn {
        background: transparent;
        border: none;
        font-size: 0.72rem;
        cursor: pointer;
        padding: 0 2px;
        line-height: 1;
        border-radius: 3px;
    }

        .tab-action-btn.edit {
            color: #a1a1aa;
        }

            .tab-action-btn.edit:hover {
                color: #38bdf8;
            }

        .tab-action-btn.close {
            color: #ef4444;
        }

            .tab-action-btn.close:hover {
                background: rgba(239, 68, 68, 0.2);
            }

    /* Conteneur sombre des boutons d'action */
    .toolbar-box {
        background: #18181b;
        border: 1px solid #333;
        border-radius: 6px;
        height: 42px;
    }

    .tool-btn {
        font-size: 0.72rem !important;
        text-transform: none !important;
        padding: 3px 6px !important;
        height: 28px !important;
        min-height: 28px !important;
    }

    /* Style du groupe Tout / Entrées / Sorties */
    .mode-toggle-group {
        background-color: #18181b !important;
        border: 1px solid #333 !important;
        border-radius: 4px;
    }

    .diagram-container {
        width: 100%;
        height: 100%;
        background-color: #18181b;
        background-image: radial-gradient(#2e2e33 1px, transparent 1px);
        background-size: 24px 24px;
    }

    .drawer-toggle-btn {
        position: absolute;
        top: 4px;
        left: 8px;
        z-index: 100;
        background: rgba(24, 24, 27, 0.9);
        color: #e4e4e7;
        border: 1px solid #3f3f46;
        border-radius: 6px;
        width: 32px;
        height: 32px;
    }

        .drawer-toggle-btn:hover {
            background: #27272a;
            color: #38bdf8;
        }

    .bg-dark-drawer {
        background-color: #1e1e20 !important;
        color: #f3f4f6;
    }

    .recipes-list {
        overflow-y: auto;
        padding-right: 4px;
    }

    /* Fond et bordure de la carte de recette */
    .recipe-card {
        background-color: #2f2f2f !important;
        border-color: #3f3f46 !important;
        transition: border-color 0.15s ease-in-out;
    }

        /* Survol de la carte */
        .recipe-card:hover {
            border-color: #38bdf8 !important;
        }

        /* 1. Titre de la recette (blanc cassé très lisible) */
        .recipe-card .recipe-title {
            color: #f4f4f5 !important;
            font-size: 0.85rem;
        }

        /* 2. Libellé 'In:' des entrées (ambre / orange doux) */
        .recipe-card .recipe-in-label {
            color: #fbbf24 !important;
            font-weight: 600;
        }

        /* 3. Libellé 'Out:' des sorties (cyan / bleu clair) */
        .recipe-card .recipe-out-label {
            color: #38bdf8 !important;
            font-weight: 600;
        }

    /* Conteneur défilant horizontalement pour les dernières recherches */
    .recent-search-bar {
        scrollbar-width: thin;
        scrollbar-color: #555 transparent;
    }

        .recent-search-bar::-webkit-scrollbar {
            height: 4px;
        }

        .recent-search-bar::-webkit-scrollbar-thumb {
            background-color: #555;
            border-radius: 4px;
        }

    /* Vignette individuelle d'icône d'historique */
    .recent-item-badge {
        width: 28px;
        height: 28px;
        min-width: 28px;
        border-radius: 4px;
        background-color: #1e1e1e;
        border: 1px solid #444;
        padding: 2px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: transform 0.1s ease, border-color 0.2s ease;
    }

        .recent-item-badge:hover {
            border-color: #38bdf8;
            transform: scale(1.15);
        }

    .recent-item-icon {
        width: 100%;
        height: 100%;
        object-fit: contain;
        user-select: none;
        -webkit-user-drag: none;
    }

    /* Style du texte de secours (2-3 lettres) dans les vignettes d'historique */
    .recent-item-fallback {
        font-size: 0.60rem;
        font-weight: 700;
        color: #e4e4e7;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        text-align: center;
        user-select: none;
        text-transform: uppercase;
    }

    /* Animation ou survol d'un port prêt à être connecté */
    .diagram-port:hover {
        transform: scale(1.4);
        background: #38bdf8 !important;
        transition: transform 0.15s ease-in-out;
    }

    /* Couleur du texte saisi dans la barre de recherche */
    .search-autocomplete input.mud-input-slot {
        color: #f4f4f5 !important;
        font-size: 0.875rem;
    }

        /* Couleur du texte indicatif (placeholder) quand le champ est vide */
        .search-autocomplete input.mud-input-slot::placeholder {
            color: #a1a1aa !important;
            opacity: 1;
        }

    /* Éclaircir également l'icône loupe et la croix d'effacement */
    .search-autocomplete .mud-input-adornment-start .mud-icon-root,
    .search-autocomplete .mud-input-adornment-end .mud-icon-root {
        color: #a1a1aa !important;
    }

    /* Couleur de la bordure du champ en mode sombre */
    .search-autocomplete .mud-input-outlined-border {
        border-color: #3f3f46 !important;
    }

    /* Bordure plus lumineuse lors du survol ou du focus */
    .search-autocomplete:hover .mud-input-outlined-border,
    .search-autocomplete.mud-input-focused .mud-input-outlined-border {
        border-color: #38bdf8 !important;
    }

    /* 1. Fenêtre déroulante complète (Popover) avec hauteur limitée et ascenseur actif */
    .autocomplete-popover-dark {
        background-color: #242424 !important; /* Même fond sombre que le panneau */
        border: 1px solid #3f3f46 !important; /* Bordure discrète */
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.6) !important;
        max-height: 300px !important; /* Force le plafonnement de la hauteur */
        overflow-y: auto !important; /* Active le défilement vertical à la molette et à la souris */
        scrollbar-width: thin;
        scrollbar-color: #52525b #1e1e22;
    }

        /* Style de la barre de défilement sur Chrome / Edge */
        .autocomplete-popover-dark::-webkit-scrollbar {
            width: 6px;
        }

        .autocomplete-popover-dark::-webkit-scrollbar-thumb {
            background-color: #52525b;
            border-radius: 4px;
        }

        /* 2. Liste interne */
        .autocomplete-popover-dark .mud-list {
            background-color: transparent !important;
            padding: 4px !important;
            max-height: none !important; /* Laisse le conteneur parent gérer seul l'ascenseur */
            overflow: visible !important;
        }

        /* 3. Lignes de produits (Item individuel) */
        .autocomplete-popover-dark .mud-list-item {
            color: #f4f4f5 !important;
            border-radius: 4px;
            transition: background-color 0.15s ease-in-out;
        }

            /* 4. Effet lors du survol de la souris ou de la sélection au clavier */
            .autocomplete-popover-dark .mud-list-item:hover,
            .autocomplete-popover-dark .mud-list-item.mud-selected-item {
                background-color: #38bdf820 !important;
                color: #38bdf8 !important;
            }

        /* 5. Message quand rien n'est trouvé */
        .autocomplete-popover-dark .text-muted {
            color: #a1a1aa !important;
        }

    /* OPTIMISATION MATÉRIELLE POUR LE CANVAS ET LES NŒUDS */
    .machine-card, .storage-card, .portal-card {
        /* Isole le recalcul géométrique à la carte sans forcer le recalcul de toute la page */
        contain: layout style;
        will-change: transform;
    }

        /* Supprime les calculs d'ombres lourds pendant que l'élément est en cours de déplacement/sélection */
        .machine-card.selected, .storage-card.selected {
            box-shadow: 0 0 8px rgba(56, 189, 248, 0.4) !important;
        }

    /* Fluidifie le rendu des tracés SVG des câbles */
    .diagram-container svg path {
        shape-rendering: geometricPrecision;
    }

    /* Bouton flottant en haut à droite pour ouvrir le bilan */
    .summary-toggle-btn {
        position: absolute;
        top: 4px;
        right: 8px;
        z-index: 100;
        background: rgba(24, 24, 27, 0.9);
        border: 1px solid #3f3f46;
        border-radius: 6px;
        width: 32px;
        height: 32px;
    }

        .summary-toggle-btn:hover {
            background: #27272a;
        }

    /* Carte d'une ressource dans le tiroir de bilan */
    .summary-resource-card {
