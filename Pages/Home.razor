    }

    .drawer-toggle-btn {
        position: absolute;
        top: 10px;
        left: 10px;
        z-index: 100;
        background: rgba(30, 30, 30, 0.85);
        color: white;
    }

    .drawer-toggle-btn:hover {
        background: #333;
     }

    .bg-dark-drawer {
        background-color: #242424 !important;
