    /// <summary>
    /// Mémorise l'onglet cible uniquement à l'entrée du curseur (1 seul événement au lieu de 60/sec).
    /// Évite toute file d'attente de rendu Blazor pendant le déplacement de la souris.
    /// </summary>
    private void OnTabDragEnter(FactoryTab targetTab)
    {
        if (_draggedTab == null || _draggedTab == targetTab || _dragOverTab == targetTab) return;
        _dragOverTab = targetTab;
    }

    /// <summary>
    /// Déplace instantanément l'onglet glissé à la position de l'onglet cible lorsqu'on relâche la souris.
    /// </summary>
    private void OnTabDrop(FactoryTab targetTab)
    {
        if (_draggedTab != null && _draggedTab != targetTab)
        {
            int oldIndex = Tabs.IndexOf(_draggedTab);
            int newIndex = Tabs.IndexOf(targetTab);

            if (oldIndex >= 0 && newIndex >= 0)
            {
                Tabs.RemoveAt(oldIndex);
                Tabs.Insert(newIndex, _draggedTab);
            }
        }

        _draggedTab = null;
        _dragOverTab = null;
    }

    /// <summary>
    /// Nettoie l'état du glisser-déposer si l'utilisateur relâche en dehors d'un onglet.
    /// </summary>
