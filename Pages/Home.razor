@page "/"
@inject HttpClient Http
@inject ResourceService ResourceService
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@using System.Text.Json

@implements IDisposable
@using Blazor.Diagrams
@using Blazor.Diagrams.Options
@using Blazor.Diagrams.Core.Anchors;
@using Blazor.Diagrams.Core.Models;
@using Blazor.Diagrams.Core.Models.Base;
@using Blazor.Diagrams.Core.Geometry
@using Blazor.Diagrams.Components

@using CaptainArchitect.Models
@using CaptainArchitect.Components
@using CaptainArchitect.Services


<!-- Conteneur plein écran sombre sans marge ni débordement -->
<div class="d-flex w-100 h-100 position-relative" style="background-color: #1e1e1e; overflow: hidden;">

    <!-- Bouton flottant pour ouvrir le tiroir si replié -->
    @if (!_drawerOpen)
    {
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       OnClick="@ToggleDrawer"
                       Class="drawer-toggle-btn"
                       Title="Ouvrir le catalogue" />
    }

    <!-- Tiroir latéral rétractable MudBlazor -->
    <MudDrawer @bind-Open="@_drawerOpen"
               ClipMode="DrawerClipMode.Never"
               Elevation="4"
               Variant="@DrawerVariant.Responsive"
               Width="340px"
               Class="pa-3 bg-dark-drawer d-flex flex-column h-100"
               Style="border-right: 1px solid #333; z-index: 200;">

        <!-- 1. ZONE FIXE DU HAUT -->
        <div style="flex-shrink: 0;">
            
            <!-- En-tête : Titre + Bouton de fermeture -->
            <div class="d-flex align-center justify-space-between mb-2">
                <MudText Typo="Typo.subtitle1" Class="fw-bold" Style="color: #e4e4e7;">Recipe Catalog</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" 
                               Size="MudBlazor.Size.Small" 
                               Color="Color.Default" 
                               OnClick="@ToggleDrawer" 
                               Title="Fermer le panneau" />
            </div>




            <!-- Barre d'outils Fichier compacte et harmonisée -->
            <div class="toolbar-box mb-3 d-flex align-center justify-space-between px-2 py-1">

                <!-- 1. Bouton Sauvegarder -->
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           Size="MudBlazor.Size.Small"
                           Class="tool-btn"
                           OnClick="SaveDiagram">
                    Save
                </MudButton>

                <!-- 2. Bouton Charger : InputFile natif masqué + Bouton label propre -->
                <InputFile id="fileInputLoader" OnChange="LoadDiagram" accept=".json" style="display: none;" />

                <MudButton HtmlTag="label"
                           Variant="Variant.Outlined"
                           Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.FolderOpen"
                           Size="MudBlazor.Size.Small"
                           Class="tool-btn"
                           for="fileInputLoader">
                    Load
                </MudButton>

                <!-- 3. Bouton Vider -->
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteSweep"
                           Size="MudBlazor.Size.Small"
                           Class="tool-btn text-muted-hover"
                           OnClick="ClearDiagram">
                    Clear
                </MudButton>


            </div>



            <!-- Menu pour ajouter un stockage avec filtre de recherche intégré -->
            <MudMenu Label="Add Storage"
                     StartIcon="@Icons.Material.Filled.Inventory2"
                     Variant="Variant.Filled"
                     Color="Color.Info"
                     Size="MudBlazor.Size.Small"
                     Dense="true"
                     MaxHeight="350">

                <!-- 1. Champ de recherche épinglé en haut du menu -->
                <div class="px-2 pt-2 pb-1" @onclick:stopPropagation="true">
                    <MudTextField @bind-Value="_storageFilterText"
                                  Placeholder="Filter products..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  IconSize="MudBlazor.Size.Small"
                                  Immediate="true"
                                  Clearable="true"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </div>

                <MudDivider Class="my-1" />

                <!-- 2. Liste déroulante filtrée dynamiquement -->
                @if (FilteredStorageProducts.Any())
                {
                    @foreach (var prod in FilteredStorageProducts)
                    {
                        <MudMenuItem OnClick="@(() => AddStorageNode(prod.Id))">
                            <div class="d-flex align-center gap-2">
                                <ResourceBadge ProductId="@prod.Id" />
                                <span>@prod.Name</span>
                            </div>
                        </MudMenuItem>
                    }
                }
                else
                {
                    <!-- Message affiché si aucune ressource ne correspond -->
                    <div class="pa-2 text-center" style="color: #71717a; font-size: 0.8rem;">
                        No product found
                    </div>
                }
            </MudMenu>





            <!-- HISTORIQUE DES DERNIÈRES RECHERCHES -->
            @if (_recentProducts.Count > 0)
            {
                <div class="mb-2">

                    <!-- Titre compact pour l'historique -->
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1 fw-bold">
                        Search history :
                    </MudText>

                    <!-- Bandeau horizontal défilant avec les icônes -->
                    <div class="d-flex align-center gap-1 overflow-x-auto pb-1 recent-search-bar">
                        
                        @foreach (var prod in _recentProducts)
                        {
                            <!-- 1. key force Blazor à recréer l'élément sans garder l'état d'erreur du précédent -->
                            <div @key="prod.Id"
                                 class="recent-item-badge"
                                 @onclick="@(() => SelectRecentProduct(prod))"
                                 title="@prod.Name">

                                <!-- 2. Image avec onload pour réinitialiser le display et repli vers la lettre/texte -->
                                <img src="@GetProductImagePath(prod)"
                                     alt="@prod.Name"
                                     class="recent-item-icon"
                                     onload="this.style.display='block'; if(this.nextElementSibling) this.nextElementSibling.style.display='none';"
                                     onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';" />

                                <!-- 3. Repli : affiche les 2-3 lettres si l'image est introuvable -->
                                <span class="recent-item-fallback" style="display: none;">
                                    @GetShortFallbackName(prod)
                                </span>

                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Barre de recherche -->
            <!-- Sélecteur / Barre de recherche avec autocomplétion des produits -->
            <MudAutocomplete T="Product"
                             Placeholder="Find a product..."
                             SearchFunc="@SearchProducts"
                             ToStringFunc="@(p => p?.Name ?? string.Empty)"
                             Value="_selectedProduct"
                             ValueChanged="@OnProductSelected"
                             Clearable="true"
                             ResetValueOnEmptyText="true"
                             CoerceText="false"
                             CoerceValue="false"
                             Dense="true"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Adornment="Adornment.Start"
                             AdornmentIcon="@Icons.Material.Filled.Search"
                             MaxItems="300"
                             SelectValueOnTab="false"
                             @onkeyup="HandleSearchKeyDown"
                             Class="mb-2 search-autocomplete"
                             PopoverClass="autocomplete-popover-dark">

                <!-- Rendu personnalisé de chaque ligne dans la liste déroulante -->
                <ItemTemplate Context="prod">
                    <div class="d-flex align-center gap-2 py-1">
                        
                        <!-- Icône du produit avec gestion d'erreur d'affichage -->
                        <img src="@GetProductImagePath(prod)"
                             alt="@prod.Name"
                             style="width: 24px; height: 24px; object-fit: contain; flex-shrink: 0;"
                             onerror="this.style.display='none';" />
                        
                        <!-- Libellé du produit -->
                        <MudText Typo="Typo.body2">@prod.Name</MudText>

                    </div>
                </ItemTemplate>

                <!-- Message si aucun produit ne correspond à la saisie -->
                <NoItemsTemplate>
                    <MudText Typo="Typo.body2" Class="pa-2 text-muted">Aucun produit trouvé</MudText>
                </NoItemsTemplate>

            </MudAutocomplete>

            <!-- Filtres : Tout / Entrées / Sorties -->
            <MudToggleGroup T="ResourceFilterMode"
                            @bind-Value="_filterMode"
                            Color="Color.Primary"
                            CheckMark="false"
                            FixedContent="true"
                            Size="MudBlazor.Size.Small"
                            Class="mb-3 w-100 d-flex justify-center mode-toggle-group">
                <MudToggleItem Value="ResourceFilterMode.All" Text="All" Class="flex-grow-1 text-center" />
                <MudToggleItem Value="ResourceFilterMode.Input" Text="Input" Class="flex-grow-1 text-center" />
                <MudToggleItem Value="ResourceFilterMode.Output" Text="Output" Class="flex-grow-1 text-center" />
            </MudToggleGroup>

        </div>

        <!-- 2. ZONE SCROLLABLE DE LA LISTE -->
        <div class="recipes-list flex-grow-1" style="overflow-y: auto; min-height: 0;">
            @if (FilteredRecipes != null)
            {
                <Virtualize Items="@FilteredRecipes.ToList()" Context="recipe">
                    <MudCard Class="mb-2 recipe-card" Outlined="true">
                        <MudCardContent Class="pa-2">
                            
                            <div class="d-flex justify-space-between align-center">

                                <!-- Titre éclairci avec la classe recipe-title -->
                                <MudText Typo="Typo.subtitle2" Class="fw-bold recipe-title">@recipe.RecipeId</MudText>
                                
                                <MudIconButton Icon="@Icons.Material.Filled.AddCircle"
                                               Color="Color.Primary"
                                               Size="MudBlazor.Size.Small"
                                               Title="Add to the diagram"
                                               OnClick="@(() => AddRecipeNode(recipe))" />
                            </div>

                            <!-- Entrées & Sorties -->
                            <div class="d-flex align-center gap-1 mt-1">
                                
                                <!-- Libellé In: avec recipe-in-label -->
                                <MudText Typo="Typo.caption" Class="recipe-in-label me-1">In:</MudText>
                                
                                @foreach (var input in recipe.Inputs)
                                {
                                    @if (!string.IsNullOrWhiteSpace(input.ProductId))
                                    {
                                        <ResourceBadge @key="@($"{recipe.RecipeId}_in_{input.ProductId}")" 
                                                       ProductId="@input.ProductId" />
                                    }
                                }
                                
                                <!-- Libellé Out: avec recipe-out-label -->
                                <MudText Typo="Typo.caption" Class="recipe-out-label ms-2 me-1">Out:</MudText>
                                
                                @foreach (var output in recipe.Outputs)
                                {
                                    @if (!string.IsNullOrWhiteSpace(output.ProductId))
                                    {
                                        <ResourceBadge @key="@($"{recipe.RecipeId}_out_{output.ProductId}")"
                                                       ProductId="@output.ProductId" />
                                    }
                                }

                            </div>
                        </MudCardContent>
                    </MudCard>
                </Virtualize>
            }

            else

            {
                <MudProgressCircular Indeterminate="true" Size="MudBlazor.Size.Small" />
            }

        </div>

    </MudDrawer>


    <!-- Zone principale : Diagramme Canvas prenant tout l'espace restant -->
    <div class="flex-grow-1 h-100 position-relative outline-none"
         style="background-color: #1a1a1a;"
         tabindex="0" 
         @onkeydown="HandleKeyDown">
        @if (Diagram != null)
        {
            <CascadingValue Value="Diagram">
                <DiagramCanvas Class="diagram-container">

                </DiagramCanvas>
            </CascadingValue>
        }

        <!-- Overlay d'avancement du chargement de la sauvegarde -->
        <MudOverlay Visible="@_isLoadingDiagram"
                    DarkBackground="true"
                    Absolute="true"
                    ZIndex="1000">
            <div class="d-flex flex-column align-center justify-center pa-6 rounded-lg"
                 style="background: #27272a; border: 1px solid #3f3f46; min-width: 320px; box-shadow: 0 10px 25px rgba(0,0,0,0.6);">

                <MudProgressCircular Color="Color.Info"
                                     Size="MudBlazor.Size.Large"
                                     Indeterminate="@(_loadingProgress == 0)"
                                     Value="@_loadingProgress"
                                     Class="mb-4" />

                <MudText Typo="Typo.h6" Class="mb-1" Style="color: #38bdf8; font-weight: 600;">
                    Loading the factory...
                </MudText>

                <MudText Typo="Typo.body2" Class="mb-3 text-secondary" Style="color: #a1a1aa;">
                    @_loadingStatusText
                </MudText>

                <MudProgressLinear Color="Color.Info"
                                   Value="@_loadingProgress"
                                   Rounded="true"
                                   Size="MudBlazor.Size.Medium"
                                   Style="width: 100%; height: 8px;" />

                <MudText Typo="Typo.caption" Class="mt-2" Style="color: #71717a;">
                    @($"{_loadingProgress}%")
                </MudText>
            </div>
        </MudOverlay>


    </div>
</div>


