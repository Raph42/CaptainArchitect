    private async Task SelectTab(string tabId)
    {
        var target = Tabs.FirstOrDefault(t => t.Id == tabId);

        if (target != null && target != ActiveTab)
        {
            ActiveTab = target;
            FlowEngine.RecalculateFlows(Tabs, ResourceService);
            StateHasChanged();

            // Si cet onglet vient d'être chargé depuis une sauvegarde et n'avait pas encore été affiché,
            // on attend que Blazor monte son <DiagramCanvas> puis on restaure son Zoom et son Pan.
            if (_pendingTabViews.Remove(target.Id, out var view))
            {
                await Task.Yield();
                ApplyTabViewState(target, view.Zoom, view.PanX, view.PanY);
            }

        }
    }


