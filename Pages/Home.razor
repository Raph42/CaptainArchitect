    /// <summary>
    /// Gère les raccourcis clavier sur le diagramme :
    /// - Delete / Backspace : Suppression avec confirmation
    /// - Ctrl + C : Copier la sélection (machines, stockages, portails et liens internes)
    /// - Ctrl + X : Couper la sélection
    /// - Ctrl + V : Coller la sélection dans l'onglet actif
    /// - Ctrl + D : Dupliquer la sélection
    /// </summary>
    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (Diagram == null) return;

        // 1. Suppression des nœuds ou liens sélectionnés (Delete ou Backspace)
        if (e.Key is "Delete" or "Backspace")
        {
            await DeleteSelectedItemsAsync();
        }
        // Touche F1 : ouvre/ferme la fenêtre d'aide des commandes
        else if (e.Key == "F1")
        {
            _contextMenuVisible = false;
            _isHelpModalOpen = !_isHelpModalOpen;
        }
        // Touche Échap : ferme le menu contextuel ou l'aide
        else if (e.Key == "Escape")
        {
            _contextMenuVisible = false;
            _isHelpModalOpen = false;
        }


        // 2. Copier la sélection (Ctrl + C)
        else if ((e.CtrlKey || e.MetaKey) && (e.Key is "c" or "C"))
        {
            CopySelectionToClipboard(showNotification: true);
        }
        // 3. Couper la sélection (Ctrl + X)
        else if ((e.CtrlKey || e.MetaKey) && (e.Key is "x" or "X"))
        {
            CutSelectionToClipboard();
        }
        // 4. Coller la sélection (Ctrl + V)
        else if ((e.CtrlKey || e.MetaKey) && (e.Key is "v" or "V"))
        {
            await PasteFromClipboard();
        }
        // 5. Duplication rapide (Ctrl + D) : fonctionne désormais aussi sur une multi-sélection
        else if ((e.CtrlKey || e.MetaKey) && (e.Key is "d" or "D"))
        {
            var selectedNodes = Diagram.Nodes.Where(n => n.Selected).ToList();
            if (selectedNodes.Count == 1)
            {
                await DuplicateNode(selectedNodes[0]);
            }
            else if (selectedNodes.Count > 1)
            {
                CopySelectionToClipboard(showNotification: false);
                await PasteFromClipboard();
            }
        }

    }


    /// <summary>
    /// Duplique une machine ou un stockage sélectionné en conservant ses réglages,
    /// en décalant sa position et en recalculant les flux.
    /// </summary>
    /// <param name="originalNode">Le nœud source à dupliquer</param>
    public async Task DuplicateNode(NodeModel originalNode)
    {
        if (originalNode == null) return;

        // Décalage fixe de 35px en diagonale par rapport au nœud actuellement sélectionné
        const double cloneOffset = 35.0;

        var newPosition = new Blazor.Diagrams.Core.Geometry.Point(
            originalNode.Position.X + cloneOffset,
            originalNode.Position.Y + cloneOffset
        );

        NodeModel? newNode = null;

        // Cas 1 : Duplication d'une machine (MachineNodeModel)
        if (originalNode is MachineNodeModel machineSrc)
        {
            var machineClone = new MachineNodeModel(machineSrc.Recipe, newPosition)
            {
                Multiplier = machineSrc.Multiplier,
                IsPaused = machineSrc.IsPaused
            };

            // Restaure le bon niveau (Tier) de la machine
            if (!string.IsNullOrWhiteSpace(machineSrc.CurrentMachineId))
            {
                while (machineClone.CurrentMachineId != machineSrc.CurrentMachineId && machineClone.Upgrade()) { }
            }

            // Restaure l'ordre exact personnalisé des ports d'entrée et de sortie
            var orderedInputs = machineSrc.Recipe.Inputs.Select(i => i.ProductId).ToList();
            var orderedOutputs = machineSrc.Recipe.Outputs.Select(o => o.ProductId).ToList();
            machineClone.ApplyCustomPortOrder(orderedInputs, orderedOutputs);

            newNode = machineClone;
        }
        // Cas 2 : Duplication d'un stockage (StorageNodeModel)
        else if (originalNode is StorageNodeModel storageSrc)
        {
            newNode = new StorageNodeModel(storageSrc.ProductId, newPosition);
        }
        // Cas 3 : Duplication d'un portail (PortalNodeModel)
        else if (originalNode is PortalNodeModel portalSrc)
        {
            newNode = new PortalNodeModel(
                portalSrc.Direction,
                portalSrc.ProductId,
                portalSrc.Direction == PortalDirection.Export ? $"{portalSrc.ChannelName} (copy)" : portalSrc.ChannelName,
                newPosition,
                portalSrc.SourceExportPortalId
            );
        }

        if (newNode != null)
        {
            // Désélectionne tous les éléments actuellement actifs (y compris le nœud d'origine)
            Diagram.UnselectAll();

            // Ajoute le nœud au diagramme
            Diagram.Nodes.Add(newNode);

            // Force le cycle de rendu pour que Blazor peigne le DOM et monte les ports
            StateHasChanged();
            await Task.Yield();

            // Applique la sélection sur le nouveau nœud maintenant qu'il est présent dans le DOM
            Diagram.SelectModel(newNode, unselectOthers: true);

            // Rafraîchit géométriquement le nœud et le canvas
            newNode.Refresh();
            Diagram.Refresh();
            FlowEngine.RecalculateFlows(Tabs, ResourceService);

            Snackbar.Add("Duplicate item !", Severity.Info);
        }
    }


    // =========================================================================
    // HISTORIQUE DES RECHERCHES
    // =========================================================================
    // Ajoute un produit à l'historique :
    // - S'il existe déjà : on le remet en tête de liste.
    // - S'il n'existe pas : on l'insère à l'index 0.
    // - Si la liste dépasse 10 éléments : on retire le plus ancien (le dernier).
    private void AddToRecentSearches(Product? product)
    {
        if (product == null) return;

        // Retrait de la position précédente si présent (dédoublonnage)
        _recentProducts.RemoveAll(p => p.Id == product.Id);

        // Insertion au tout début (le plus récent)
        _recentProducts.Insert(0, product);

        // Limitation stricte à 10 items maximum
        if (_recentProducts.Count > MaxRecentSearches)
        {
            _recentProducts.RemoveAt(_recentProducts.Count - 1);
        }
    }


    // Déclenché lors du clic sur une des icônes de la barre d'historique
    private void SelectRecentProduct(Product product)
    {
        // 1. Réinjecte le produit dans la recherche
        _selectedProduct = product;
        _searchQuery = product.Id;
        _currentSearchText = product.Name;

        // 2. Remonte le produit cliqué en 1ère position dans l'historique
        AddToRecentSearches(product);

        // 3. Rafraîchit l'affichage
        StateHasChanged();
    }


