    private async Task SpawnAndSelectNodeAsync(NodeModel node)
    {
        if (Diagram == null) return;

        Diagram.UnselectAll();
        Diagram.Nodes.Add(node);

        // Force le rendu DOM pour que le widget du nœud et ses ports soient montés
        StateHasChanged();
        await Task.Yield();

        // Sélectionne automatiquement le nouvel élément posé
        Diagram.SelectModel(node, unselectOthers: true);

        // Rafraîchissement géométrique et calcul des flux
        node.Refresh();
        Diagram.Refresh();
        FlowEngine.RecalculateFlows(Tabs, ResourceService);
    }



