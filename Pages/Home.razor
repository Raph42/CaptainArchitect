@code {

    public enum ResourceFilterMode
    {
        All,    // Les deux (entrées ou sorties)
        Input,  // Seulement si présent en entrée
        Output  // Seulement si présent en sortie
    }

    // =========================================================================
    // GESTION DES ONGLETS D'USINE
    // =========================================================================
    private List<FactoryTab> Tabs { get; set; } = new();
    private FactoryTab ActiveTab { get; set; } = default!;

    // =========================================================================
    // VARIABLES POUR LE DÉPLACEMENT (DRAG & DROP) ET L'ÉDITION D'ONGLET
    // =========================================================================
    private FactoryTab? _draggedTab;
    private FactoryTab? _dragOverTab;

    private bool _isEditingTab = false;
    private FactoryTab? _editingTab;
    private string _editingTabName = "";
    private string? _editingTabIconProductId;
    private Product? _editingTabSelectedProduct;

    // Propriété raccourci pointant vers le BlazorDiagram de l'onglet actif
    // Utilise l'opérateur ?. pour renvoyer null sans planter tant que ActiveTab n'est pas prêt
    private BlazorDiagram? Diagram => ActiveTab?.Diagram;

    private List<Recipe>? Recipes { get; set; }

    // Renommé pour éviter le conflit avec le namespace .NET "Resources"
    private Dictionary<string, Product> ProductDict { get; set; } = new();

    private bool _drawerOpen = true;

    // Variable contenant le texte effectif qui filtre la liste des recettes
    private string _searchQuery = "";

    // Mémorise le texte tapé au fur et à mesure sans déclencher le re-filtrage lourd des recettes
    private string _currentSearchText = "";

    // Stocke la liste brute de tous les produits pour alimenter la recherche
    private List<Product> _allProducts = new();
    private Product? _selectedProduct;

    private ResourceFilterMode _filterMode = ResourceFilterMode.All;

    // Historique des recherches + mémorisation des images introuvables (sans JS inline)
    private readonly List<Product> _recentProducts = new();
    private readonly HashSet<string> _failedRecentImages = new(StringComparer.OrdinalIgnoreCase);
    private const int MaxRecentSearches = 10;

    // État de chargement d'une sauvegarde
    private bool _isLoadingDiagram = false;
    private int _loadingProgress = 0;
    private string _loadingStatusText = "";

    // Verrou pour bloquer les recalculs en chaîne pendant un chargement ou un nettoyage massif du diagramme
    private bool _isBulkUpdating = false;

    // ANTI-REBOND (DEBOUNCE) : Évite d'exécuter RecalculateFlows 5 fois de suite
    // lorsqu'une machine avec plusieurs câbles est supprimée.
    private bool _recalculatePending = false;

    // Décalage en cascade lors de l'ajout successif de nœuds
    private double _cascadeOffset = 0.0;
    // Pas d'incrément à chaque ajout (en pixels)
    private const double CascadeStep = 30.0;
    // Décalage maximal avant de repartir du centre
    private const double MaxCascadeOffset = 180.0;

    // Filtres des menus Storage et Export Bus
    private string _storageFilterText = "";
    private string _portalFilterText = "";

    // =========================================================================
    // ÉTAT ET FILTRES DU TIROIR DE BILAN DE PRODUCTION (DROITE)
    // =========================================================================
    public enum BalanceFilterMode
    {
        All,
        Deficit,
        Surplus
    }

    private bool _summaryDrawerOpen = false;
    private string _summaryFilterText = "";
    private BalanceFilterMode _balanceFilterMode = BalanceFilterMode.All;

    private void ToggleSummaryDrawer()
    {
        _summaryDrawerOpen = !_summaryDrawerOpen;
    }


    // =========================================================================
    // MÉTHODES D'AIDE POUR L'HISTORIQUE DES RECHERCHES
    // =========================================================================
    private void MarkRecentImageFailed(string productId)
    {
        if (!string.IsNullOrWhiteSpace(productId))
        {
            _failedRecentImages.Add(productId);
        }
    }



    // =========================================================================
    // MENU CONTEXTUEL FAÇON WINDOWS (CLIC DROIT SUR DIAGRAMME) & AIDE
    // =========================================================================
    private bool _contextMenuVisible = false;
    private double _contextMenuX;
    private double _contextMenuY;
    private bool _isHelpModalOpen = false;

    // État dynamique d'activation des commandes du menu contextuel
    private bool CanCopyOrCut => Diagram != null && Diagram.Nodes.Any(n => n.Selected);
    private bool CanDeleteSelection => Diagram != null && (Diagram.Nodes.Any(n => n.Selected) || Diagram.Links.Any(l => l.Selected));
    private bool CanPaste => _clipboard != null && (_clipboard.Machines.Count > 0 || _clipboard.Storages.Count > 0 || _clipboard.Portals.Count > 0);

    private string ContextMenuStyle =>
        FormattableString.Invariant($"left: {_contextMenuX:0.##}px; top: {_contextMenuY:0.##}px;");

    /// <summary>
    /// Ouvre le menu contextuel façon Windows à l'emplacement du curseur sur le diagramme.
    /// </summary>
    private void OnCanvasContextMenu(MouseEventArgs e)
    {
        if (Diagram == null) return;

        // Position relative au conteneur du canvas avec maintien dans les bords visibles
        double maxWidth = (Diagram.Container?.Width ?? 1000.0) - 225.0;
        double maxHeight = (Diagram.Container?.Height ?? 700.0) - 210.0;

        _contextMenuX = Math.Clamp(e.OffsetX, 8.0, Math.Max(8.0, maxWidth));
        _contextMenuY = Math.Clamp(e.OffsetY, 8.0, Math.Max(8.0, maxHeight));
        _contextMenuVisible = true;
    }

    private void CloseContextMenu()
    {
        _contextMenuVisible = false;
    }

    private void OpenHelpFromContextMenu()
    {
        _contextMenuVisible = false;
        _isHelpModalOpen = true;
    }

    private void CopyFromContextMenu()
    {
        _contextMenuVisible = false;
        CopySelectionToClipboard(showNotification: true);
    }

    private void CutFromContextMenu()
    {
        _contextMenuVisible = false;
        CutSelectionToClipboard();
    }

    private async Task PasteFromContextMenu()
    {
        _contextMenuVisible = false;
        await PasteFromClipboard();
    }

    private async Task DeleteFromContextMenu()
    {
        _contextMenuVisible = false;
        await DeleteSelectedItemsAsync();
    }

    /// <summary>
    /// Supprime les éléments sélectionnés (nœuds et/ou liens) après confirmation MudBlazor.
    /// Partagée entre la touche Delete/Backspace et le menu contextuel.
    /// </summary>
    private async Task DeleteSelectedItemsAsync()
    {
        if (Diagram == null) return;

        var selectedLinks = Diagram.Links.Where(l => l.Selected).ToList();
        var selectedNodes = Diagram.Nodes.Where(n => n.Selected).ToList();

        if (selectedLinks.Count == 0 && selectedNodes.Count == 0) return;

        string message;
        if (selectedNodes.Count == 1 && selectedLinks.Count == 0)
        {
            message = "Delete the item ?";
        }
        else if (selectedNodes.Count > 1)
        {
            message = $"Delete these {selectedNodes.Count} selected items ?";
        }
        else
        {
            message = selectedLinks.Count == 1
                ? "Delete the link ?"
                : $"Delete these {selectedLinks.Count} links ?";
        }

        bool? confirm = await DialogService.ShowMessageBoxAsync(
            title: "Delete",
            message: message,
            yesText: "Delete",
            cancelText: "Cancel"
        );

        if (confirm != true) return;

        foreach (var link in selectedLinks)
        {
            Diagram.Links.Remove(link);
        }

        foreach (var node in selectedNodes)
        {
            Diagram.Nodes.Remove(node);
        }
    }




    // =========================================================================
    // ANTI-REBOND (DEBOUNCE) : Évite d'exécuter RecalculateFlows 5 fois de suite
    // lorsqu'une machine avec plusieurs câbles est supprimée.
    // =========================================================================
    private async Task RequestFlowRecalculationAsync()
    {
        // Si un recalcul est déjà planifié pour ce cycle, on ignore les doublons
        if (_recalculatePending || _isBulkUpdating) return;

        _recalculatePending = true;

        // Attend que Blazor.Diagrams ait fini de supprimer tous les câbles et le nœud
        await Task.Yield();

        _recalculatePending = false;

        // Exécute le moteur de flux UNE SEULE FOIS
        FlowEngine.RecalculateFlows(Tabs, ResourceService);
        StateHasChanged();
    }


    /// <summary>
    /// Calcule le décalage suivant et fait repartir le cycle s'il dépasse le maximum.
    /// </summary>
    private double GetNextCascadeOffset()
    {
        double current = _cascadeOffset;
        _cascadeOffset += CascadeStep;

        if (_cascadeOffset > MaxCascadeOffset)
        {
            _cascadeOffset = 0.0;
        }
        return current;
    }


    /// <summary>
    /// Filtre la liste déjà triée des produits selon un texte de recherche (utilisé pour Storage et Export Bus).
    /// </summary>
    private IEnumerable<Product> FilterProductsByText(string filterText)
    {
        if (string.IsNullOrWhiteSpace(filterText))
            return _allProducts;

        var term = filterText.Trim();
        return _allProducts.Where(p =>
            (!string.IsNullOrEmpty(p.Name) && p.Name.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(p.Id) && p.Id.Contains(term, StringComparison.OrdinalIgnoreCase)));
    }

    // Liste filtrée des produits disponibles pour le stockage
    private IEnumerable<Product> FilteredStorageProducts => FilterProductsByText(_storageFilterText);

    // Liste filtrée des produits disponibles pour le portail
    private IEnumerable<Product> FilteredPortalProducts => FilterProductsByText(_portalFilterText);


    // Propriété de filtrage des recettes
    private IEnumerable<Recipe>? FilteredRecipes =>
        Recipes?.Where(r =>
        {
            // 1. Si aucun texte n'est validé et aucun produit sélectionné, on affiche tout
            if (string.IsNullOrWhiteSpace(_searchQuery) && _selectedProduct == null)
                return true;

            var query = _searchQuery.Trim();

            // 2. Critère de correspondance :
            // - Si un produit précis a été cliqué dans la liste ou sur une machine -> Égalité stricte sur son Id
            // - Sinon (recherche validée par Entrée) -> Recherche souple avec Contains (Iron trouvera Iron, IronOre, IronScrap...)
            Func<string?, bool> matchesCriteria = (productId) =>
            {
                if (string.IsNullOrWhiteSpace(productId)) return false;

                if (_selectedProduct != null)
                {
                    // Égalité exacte : seulement le produit sélectionné
                    return string.Equals(productId, _selectedProduct.Id, StringComparison.OrdinalIgnoreCase);
                }
                else
                {
                    // Recherche large par sous-chaîne sur l'ID
                    return productId.Contains(query, StringComparison.OrdinalIgnoreCase);
                }
            };

            // 3. Vérification sur les entrées et les sorties
            bool matchesInput = r.Inputs.Any(i => matchesCriteria(i.ProductId));
            bool matchesOutput = r.Outputs.Any(o => matchesCriteria(o.ProductId));

            // 4. Correspondance sur le nom de la recette (uniquement en saisie manuelle et mode Tout)
            bool matchesName = _selectedProduct == null &&
                               r.RecipeId.Contains(query, StringComparison.OrdinalIgnoreCase);

            // 5. Filtrage selon le mode sélectionné (Tout / Entrées / Sorties)
            return _filterMode switch
            {
                ResourceFilterMode.Input => matchesInput,
                ResourceFilterMode.Output => matchesOutput,
                _ => matchesName || matchesInput || matchesOutput
            };

        });


    // 1. Fonction appelée à chaque frappe pour filtrer le menu déroulant de l'autocomplétion
    private async Task<IEnumerable<Product>> SearchProducts(string value, CancellationToken token)
    {
        // On mémorise la frappe SANS toucher à _searchQuery (supprime tout lag pendant la frappe !)
        _currentSearchText = value ?? string.Empty;

        // Si le champ est vidé, on efface aussi le filtre pour réafficher toutes les recettes
        if (string.IsNullOrWhiteSpace(value))
        {
            _selectedProduct = null;
            _searchQuery = string.Empty;
            return _allProducts.OrderBy(p => p.Name);
        }

        var term = value.Trim();

        // Filtre sur le nom affiché (Name) ou sur l'identifiant (Id)
        return _allProducts
            .Where(p => (!string.IsNullOrEmpty(p.Name) && p.Name.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                        (!string.IsNullOrEmpty(p.Id) && p.Id.Contains(term, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(p => p.Name);
    }


    // 2. Déclenché UNIQUEMENT quand vous cliquez sur un produit dans le menu déroulant
    private void OnProductSelected(Product? selected)
    {
        _selectedProduct = selected;
        _searchQuery = selected?.Id ?? string.Empty;
        _currentSearchText = selected?.Name ?? string.Empty;

        // mémorise le produit sélectionné
        if (selected != null)
        {
            AddToRecentSearches(selected);
        }
    }


    // 3. Gère la validation par la touche Entrée dans la barre de recherche
    private void HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter")
        {
            // En validant par Entrée sans avoir cliqué sur un produit précis :
            // 1. On annule la sélection stricte d'un produit unique
            _selectedProduct = null;

            // 2. On applique le texte saisi comme filtre global (partiel)
            _searchQuery = _currentSearchText;

            // 3. Rafraîchit instantanément la liste des recettes filtrées
            StateHasChanged();
        }
    }


    // 4. Clic sur une ressource posée sur le diagramme
    // Méthode appelée lors du clic sur une ressource d'une machine posée
    private void HandleResourceFilterRequested(string productId, PortDirection? direction)
    {
        // 1. Ouvre le tiroir à gauche si jamais il était fermé
        _drawerOpen = true;

        // 2. Gestion du mode de filtre :
        // - Si clic sur Sortie d'une machine posée -> filtre sur Entrées
        // - Si clic sur Entrée d'une machine posée -> filtre sur Sorties
        // - Si clic dans la liste du panneau (direction == null) -> passe en mode Tout
        _filterMode = direction switch
        {
            PortDirection.Output => ResourceFilterMode.Input,
            PortDirection.Input => ResourceFilterMode.Output,
            _ => ResourceFilterMode.All
        };

        // 3. Applique le produit cliqué dans la recherche
        if (ProductDict.TryGetValue(productId, out var product))
        {
            _selectedProduct = product;
            _searchQuery = product.Id;
            _currentSearchText = product.Name;

            // mémorise aussi le produit cliqué depuis le diagramme
            AddToRecentSearches(product);
        }
        else
        {
            _selectedProduct = null;
            _searchQuery = productId;
            _currentSearchText = productId;
        }

        // 3. Demande à Blazor de recalculer FilteredRecipes et de rafraîchir l'affichage
        InvokeAsync(StateHasChanged);
    }


    // Calcule le chemin de l'image en nettoyant le slash initial éventuel
    private string GetProductImagePath(Product? prod)
    {
        if (prod == null) return string.Empty;

        var path = !string.IsNullOrWhiteSpace(prod.Image)
            ? prod.Image
            : $"images/resources/{prod.Id}.png";

        return path.TrimStart('/');
    }


    // Calcule un texte court de secours (3 caractères max) si le produit n'a pas d'image
    private string GetShortFallbackName(Product? prod)
    {
        if (prod == null) return string.Empty;
        var text = !string.IsNullOrWhiteSpace(prod.Name) ? prod.Name : prod.Id;
        return text.Substring(0, Math.Min(3, text.Length)).ToUpperInvariant();
    }


    /// <summary>
    /// Crée et configure une nouvelle instance de BlazorDiagram pour un onglet.
    /// </summary>
    private BlazorDiagram CreateConfiguredDiagram()
    {
        // 2. Options et création de lien avec couleur globale
        var options = new BlazorDiagramOptions
        {
            AllowMultiSelection = true,
            AllowPanning = true,

            Zoom =
            {
                Enabled = true,
                // Inverse directement le sens de la molette
                Inverse = true
            },

            Links =
            {
                // le PathGenerator décide de la manière de dessiner la ligne entre ces points
                // (courbe, ligne droite ou angles brisés).
                // StraightPathGenerator : trace des segments droits et nets entre les points calculés, supprimant toute courbure.
                DefaultPathGenerator = new SmoothPathGenerator(),

                // le Router calcule uniquement les points de passage (les coordonnées $X, Y$),
                // DefaultRouter = new OrthogonalRouter(),
                // DefaultPathGenerator = new StraightPathGenerator(),
                EnableSnapping = true,

                // =========================================================================
                // ACTIVATION DES POINTS DE PASSAGE (VERTICES) SUR LES LIAISONS
                // =========================================================================
                // Autorise l'ajout et le déplacement de points intermédiaires
                RequireTarget = true,

                // Utilise notre modèle personnalisé lorsqu'un lien est tiré depuis un port
                Factory = (diagram, source, position) =>
                {
                    Blazor.Diagrams.Core.Anchors.Anchor sourceAnchor = source switch
                    {
                        PortModel port => new SinglePortAnchor(port),
                        NodeModel node => new ShapeIntersectionAnchor(node),
                        _ => new SinglePortAnchor((PortModel)source)
                    };

                    var link = new ResourceLinkModel(sourceAnchor);

                    // Récupère la couleur globale associée à l'identifiant de la ressource
                    if (source is ResourcePortModel resPort)
                    {
                        if (ProductDict.TryGetValue(resPort.ProductId, out var prod) && !string.IsNullOrWhiteSpace(prod.Color))
                        {
                            link.Color = prod.Color;
                        }
                    }

                    return link;
                }
            }
        };

        var diag = new BlazorDiagram(options);

        // =========================================================================
        // DÉSACTIVATION DE LA SUPPRESSION NATIVES SUR LA TOUCHE "DELETE"
        // Empêche Blazor.Diagrams de supprimer les liens tout seul sans passer par
        // notre méthode HandleKeyDown (et donc sans afficher la confirmation).
        // =========================================================================
        diag.UnregisterBehavior<KeyboardShortcutsBehavior>();

        // =========================================================================
        // ABONNEMENTS OPTIMISÉS : Recalcul UNIQUEMENT lors des vraies modifications
        // (Suppression de link.Changed pour éviter les 60 recalculs/sec pendant le drag)
        // =========================================================================
        diag.Links.Added += link =>
        {
            // Recalcul quand le lien s'accroche définitivement sur le port cible
            // (hors chargement de fichier)
            link.TargetAttached += _ =>
            {
                // Évite les recalculs pendant LoadDiagram
                if (_isBulkUpdating) return;

                FlowEngine.RecalculateFlows(Tabs, ResourceService);
                InvokeAsync(StateHasChanged);
            };
        };

        // Recalcul lorsqu'une liaison est supprimée (regroupé via RequestFlowRecalculationAsync)
        diag.Links.Removed += link =>
        {
            if (_isBulkUpdating) return;
            _ = RequestFlowRecalculationAsync();
        };

        // Recalcul lorsqu'une machine ou un stockage est supprimé (regroupé via RequestFlowRecalculationAsync)
        diag.Nodes.Removed += node =>
        {
            if (_isBulkUpdating) return;
            _ = RequestFlowRecalculationAsync();
        };

        // Enregistrement des widgets personnalisés (Machines, Stockages, Portails Bus et Liens)
        diag.RegisterComponent<MachineNodeModel, MachineNodeWidget>();
        diag.RegisterComponent<StorageNodeModel, StorageNodeWidget>();
        diag.RegisterComponent<PortalNodeModel, PortalNodeWidget>();
        diag.RegisterComponent<ResourceLinkModel, ResourceLinkWidget>();

        return diag;
    }


    // =========================================================================
    // INITIALISATION DU COMPOSANT
    // =========================================================================
    protected override async Task OnInitializedAsync()
    {
        // 1. Création immédiate du premier onglet AVANT tout 'await'
        // Garantit que ActiveTab et Diagram ne sont jamais null lors du premier rendu Blazor
        var initialTab = new FactoryTab
        {
            Name = "Main",
            Diagram = CreateConfiguredDiagram()
        };
        Tabs.Add(initialTab);
        ActiveTab = initialTab;
        FlowEngine.RegisterTabs(Tabs);

        // 2. Chargement des données globales
        try
        {
            // Chargement du fichier unique
            var data = await Http.GetFromJsonAsync<CoiData>("data/captain_of_industry_data.json");

            if (data != null)
            {
                // Enregistrement des versions du JSON et du jeu dans le service
                ResourceService.SetVersions(data.Generator, data.GameVersion);

                if (data.Products != null)
                {
                    // Conserve la liste complète triée par nom une seule fois au chargement
                    _allProducts = data.Products.OrderBy(p => p.Name).ToList();

                    ProductDict = data.Products.ToDictionary(p => p.Id, p => p);
                    ResourceService.LoadProducts(data.Products);
                }

                if (data.Machines != null)
                {
                    ResourceService.LoadMachines(data.Machines);
                }

                Recipes = data.Recipes;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur : {ex.Message}");
        }

        // 3. Abonnement à l'événement de filtrage de ressource
        ResourceService.OnResourceFilterRequested += HandleResourceFilterRequested;

        // 4.Rafraîchit le tiroir de bilan droit dès que FlowEngine recalcule
        // (modification de quantité +/-, pause, changement de recette, ajout/suppression)
        ResourceService.OnGlobalStatsChanged += HandleGlobalStatsChanged;

        // Abonnement au clic sur l'icône d'aide (?) située dans la barre supérieure MainLayout
        ResourceService.OnHelpRequested += HandleHelpRequested;

        // 5. Calcul initial des flux
        FlowEngine.RecalculateFlows(Tabs, ResourceService);

        // Force le re-rendu du tiroir avec les données prêtes
        StateHasChanged();
    }


