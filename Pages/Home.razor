    /// <summary>
    /// Ajoute une machine sur le diagramme en la centrant exactement
    /// dans la zone visible du canvas (prend en compte le zoom et le pan).
    /// </summary>
    /// <param name="recipe">La recette sélectionnée à instancier</param>
    private async Task AddRecipeNode(Recipe recipe)
    {
        // Place le nouveau nœud avec un léger décalage à chaque clic
        // var node = new MachineNodeModel(recipe, new Point(_spawnOffset, _spawnOffset));
        // _spawnOffset += 40;
        // if (_spawnOffset > 400) _spawnOffset = 150;

        // Diagram.Nodes.Add(node);

        // Dimensions approximatives de la carte MachineNodeWidget pour centrer son milieu géométrique
        const double nodeWidth = 330.0;
        const double nodeHeight = 160.0;

        // 1. Récupération des dimensions réelles de la zone visible du canvas
        // Si le conteneur n'a pas encore été mesuré par Blazor.Diagrams, on prend une taille de repli (ex: 1200x800)
        double canvasWidth = Diagram.Container?.Width ?? 1200;
        double canvasHeight = Diagram.Container?.Height ?? 800;

        // 2. Coordonnées de l'écran vers le système de coordonnées du Diagramme :
        // (Centre de l'écran - Pan) / Zoom
        double zoom = Diagram.Zoom;
        double centerX = ((canvasWidth / 2.0) - Diagram.Pan.X) / zoom;
        double centerY = ((canvasHeight / 2.0) - Diagram.Pan.Y) / zoom;

        // 3. Décalage pour centrer la machine + décalage en cascade si ajouts successifs
        double offset = GetNextCascadeOffset();
        double targetX = centerX - (nodeWidth / 2.0) + offset;
        double targetY = centerY - (nodeHeight / 2.0) + offset;

        // 4. Instanciation du nœud à la position calculée
        var machineNode = new MachineNodeModel(recipe, new Blazor.Diagrams.Core.Geometry.Point(targetX, targetY));

        // 5. Désélectionne les éventuels éléments actifs et ajoute la machine
        Diagram.UnselectAll();
        Diagram.Nodes.Add(machineNode);

        // 6. Force le rendu DOM pour que le widget de la machine soit monté
        StateHasChanged();
        await Task.Yield();

        // 7. Sélectionne automatiquement la nouvelle machine posée
        Diagram.SelectModel(machineNode, unselectOthers: true);

        // 8. Rafraîchissement géométrique et flux
        machineNode.Refresh();
        Diagram.Refresh();
        FlowEngine.RecalculateFlows(Diagram, ResourceService);

        // 5. Ajout au diagramme et recalcul des flux
        //Diagram.Nodes.Add(machineNode);
        //FlowEngine.RecalculateFlows(Diagram);

    }


    private void HandleKeyDown(KeyboardEventArgs e)
    {
        // 1. Suppression des nœuds ou liens sélectionnés (Delete ou Backspace)
        if (e.Key is "Delete" or "Backspace")
        {
            // 1. Récupère tous les liens sélectionnés et les supprime du diagramme
            var selectedLinks = Diagram.Links.Where(l => l.Selected).ToList();

            foreach (var link in selectedLinks)
            {
                Diagram.Links.Remove(link);
            }

            // 2. Supprime également les nœuds sélectionnés s'il y en a
            var selectedNodes = Diagram.Nodes.Where(n => n.Selected).ToList();

            foreach (var node in selectedNodes)
            {
                Diagram.Nodes.Remove(node);
            }

            FlowEngine.RecalculateFlows(Diagram, ResourceService);
        }

        // 2. Duplication par raccourci Ctrl + D ou Ctrl + d
        else if ((e.CtrlKey || e.MetaKey) && (e.Key is "d" or "D"))
        {
            // Récupère le dernier nœud sélectionné sur le diagramme
            var selectedNode = Diagram.Nodes.FirstOrDefault(n => n.Selected);

            if (selectedNode != null)
            {
                _ = DuplicateNode(selectedNode);
            }
        }

    }



    // Ajoute un produit à l'historique :
    // - S'il existe déjà : on le remet en tête de liste.
    // - S'il n'existe pas : on l'insère à l'index 0.
    // - Si la liste dépasse 10 éléments : on retire le plus ancien (le dernier).
    private void AddToRecentSearches(Product? product)
    {
        if (product == null) return;

        // Retrait de la position précédente si présent (dédoublonnage)
        _recentProducts.RemoveAll(p => p.Id == product.Id);

        // Insertion au tout début (le plus récent)
        _recentProducts.Insert(0, product);

        // Limitation stricte à 10 items maximum
        if (_recentProducts.Count > MaxRecentSearches)
        {
            _recentProducts.RemoveAt(_recentProducts.Count - 1);
        }
    }



    // Déclenché lors du clic sur une des icônes de la barre d'historique
    private void SelectRecentProduct(Product product)
    {
        // 1. Réinjecte le produit dans la recherche
        _selectedProduct = product;
        _searchQuery = product.Id;
        _currentSearchText = product.Name;

        // 2. Remonte le produit cliqué en 1ère position dans l'historique
        AddToRecentSearches(product);

        // 3. Rafraîchit l'affichage
        StateHasChanged();
    }



