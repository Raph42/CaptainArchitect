    /// <summary>
    /// Réinitialise complètement toute l'usine après confirmation de l'utilisateur
    /// (supprime tous les onglets et recrée un onglet unique "Main" comme au démarrage).
    /// </summary>
    private async Task NewFactory()
    {
        _pendingTabViews.Clear();

        // 1. Demande de confirmation avant de tout effacer (syntaxe asynchrone MudBlazor v7+)
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            title: "New Factory",
            message: "Are you sure you want to start a new factory? All tabs, machines, and links will be cleared.",
            yesText: "New",
            cancelText: "Cancel"
        );

        // Si l'utilisateur clique sur "Cancel" ou ferme la boîte de dialogue, on annule l'opération
        if (confirm != true) return;

        try
        {
            // 2. Active le verrou pour bloquer tout recalcul intermédiaire pendant le nettoyage
            _isBulkUpdating = true;

            // 3. Vide tous les onglets existants (machines, stockages, portails et liaisons)
            Tabs.Clear();

            // 4. Recrée l'onglet initial unique "Main", exactement comme dans OnInitializedAsync()
            var initialTab = new FactoryTab
            {
                Name = "Main",
                Diagram = CreateConfiguredDiagram()
            };
            Tabs.Add(initialTab);
            ActiveTab = initialTab;

            // 5. Réinitialise le décalage en cascade des nouveaux éléments et les filtres de menus
            _cascadeOffset = 0.0;
            _storageFilterText = "";
            _portalFilterText = "";

            // 6. Ré-enregistre la nouvelle liste d'onglets auprès du moteur de flux
            FlowEngine.RegisterTabs(Tabs);
        }
        finally
        {
            // 7. Relâche toujours le verrou, même en cas d'erreur
            _isBulkUpdating = false;
        }

        // 8. Recalcule les flux (remet également les ouvriers et l'électricité à 0 dans la barre supérieure)
        FlowEngine.RecalculateFlows(Tabs, ResourceService);
        StateHasChanged();

        Snackbar.Add("New factory initialized !", Severity.Info);
    }


    /// <summary>
    /// Réinitialise complètement le diagramme.
    /// </summary>
    private void ClearDiagram()
    {
        try
        {
            // Active le verrou avant de vider les collections
            _isBulkUpdating = true;

            // Supprime tous les liens puis tous les nœuds
            Diagram.Links.Clear();
            Diagram.Nodes.Clear();
        }
        finally
        {
            // Relâche toujours le verrou, même en cas d'erreur
            _isBulkUpdating = false;
        }

        // Un seul recalcul à la fin
        FlowEngine.RecalculateFlows(Tabs, ResourceService);
        StateHasChanged();
    }



    /// <summary>
    /// Sauvegarde l'état actuel du diagramme dans un fichier JSON téléchargé par le client.
    /// </summary>
    private async Task SaveDiagram()
    {
        try
        {
            var saveData = new DiagramSaveData
            {
                Version = "2.0",
                ActiveTabId = ActiveTab?.Id
            };


            // Parcours de chaque onglet de l'usine
            foreach (var tab in Tabs)
            {
                var savedTab = new SavedTabData
                {
                    TabId = tab.Id,
                    Name = tab.Name,
                    // Sauvegarde l'icône de ressource choisie pour cet onglet
                    IconProductId = tab.IconProductId,

                    // Sauvegarde du niveau de zoom et de la position (Pan) propres à cet onglet
                    Zoom = tab.Diagram.Zoom,
                    PanX = tab.Diagram.Pan.X,
                    PanY = tab.Diagram.Pan.Y
                };

                // 1. Sauvegarde des nœuds (machines)
                foreach (var node in tab.Diagram.Nodes.OfType<MachineNodeModel>())
                {
                    savedTab.Nodes.Add(new SavedNodeData
                    {
                        NodeId = node.Id,
                        RecipeId = node.Recipe.RecipeId,
                        MachineId = node.CurrentMachineId,
                        Multiplier = node.Multiplier,
                        X = node.Position.X,
                        Y = node.Position.Y,

                        // Mémorisation de l'ordre exact actuel des entrées et des sorties
                        OrderedInputProductIds = node.Recipe.Inputs.Select(i => i.ProductId).ToList(),
                        OrderedOutputProductIds = node.Recipe.Outputs.Select(o => o.ProductId).ToList()
                    });
                }

                // 2. Sauvegarde de tous les stockages (StorageNodeModel)
                foreach (var storage in tab.Diagram.Nodes.OfType<StorageNodeModel>())
                {
                    savedTab.Storages.Add(new SavedStorageData
                    {
                        NodeId = storage.Id,
                        ProductId = storage.ProductId,
                        X = storage.Position.X,
                        Y = storage.Position.Y
                    });
                }

                // 3. Sauvegarde de tous les portails (PortalNodeModel)
                foreach (var portal in tab.Diagram.Nodes.OfType<PortalNodeModel>())
                {
                    savedTab.Portals.Add(new SavedPortalData
                    {
                        NodeId = portal.Id,
                        Direction = portal.Direction,
                        ProductId = portal.ProductId,
                        ChannelName = portal.ChannelName,
                        SourceExportPortalId = portal.SourceExportPortalId,
                        X = portal.Position.X,
                        Y = portal.Position.Y
                    });
                }

                // 4. Sauvegarde de toutes les liaisons (câbles / tuyaux)
                // Fonctionne indifféremment entre Machines et Stockages (Machine -> Machine, Machine -> Stockage, Stockage -> Machine)
                foreach (var link in tab.Diagram.Links)
                {
                    if (link.Source is SinglePortAnchor srcAnchor &&
                        srcAnchor.Port is ResourcePortModel srcPort &&
                        link.Target is SinglePortAnchor tgtAnchor &&
                        tgtAnchor.Port is ResourcePortModel tgtPort &&
                        srcPort.Parent is NodeModel srcNode &&
                        tgtPort.Parent is NodeModel tgtNode)
                    {
                        var savedLink = new SavedLinkData
                        {
                            SourceNodeId = srcNode.Id,
                            SourceProductId = srcPort.ProductId,
                            SourceDirection = srcPort.Direction,
                            TargetNodeId = tgtNode.Id,
                            TargetProductId = tgtPort.ProductId,
                            TargetDirection = tgtPort.Direction
                        };

                        // Mémorisation des points de passage
                        foreach (var vertex in link.Vertices)
                        {
                            savedLink.Vertices.Add(new double[] { vertex.Position.X, vertex.Position.Y });
                        }

                        savedTab.Links.Add(savedLink);
                    }
                }

                saveData.Tabs.Add(savedTab);
            }

            // 4. Sérialisation et téléchargement du JSON
            var jsonString = JsonSerializer.Serialize(saveData, new JsonSerializerOptions { WriteIndented = true });
            var fileName = $"factory_{DateTime.Now:yyyyMMdd_HHmmss}.json";
            await JS.InvokeVoidAsync("downloadFileFromText", fileName, jsonString);

            Snackbar.Add("Diagram saved successfully !", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error while saving : {ex.Message}", Severity.Error);
        }
    }


    // Mémorise temporairement le (Zoom, PanX, PanY) des onglets chargés depuis un fichier
    // qui ne sont pas encore affichés à l'écran, afin de les appliquer dès la première ouverture de l'onglet.
    private readonly Dictionary<string, (double Zoom, double PanX, double PanY)> _pendingTabViews = new();

    /// <summary>
    /// Applique le zoom et la position (Pan) sauvegardés sur le diagramme d'un onglet donné.
    /// </summary>
    private void ApplyTabViewState(FactoryTab tab, double zoom, double panX, double panY)
    {
        if (tab?.Diagram == null) return;

        // Sécurité : empêche un zoom nul ou négatif si un ancien fichier JSON ne contenait pas la propriété
        double validZoom = zoom > 0.05 ? zoom : 1.0;

        tab.Diagram.SetZoom(validZoom);
        tab.Diagram.SetPan(panX, panY);
        tab.Diagram.Refresh();
    }


    /// <summary>
    /// Charge et reconstruit le diagramme depuis un fichier JSON sélectionné par l'utilisateur.
    /// Recrée les machines, les stockages et rétablit tous les liens.
    /// </summary>
    private async Task LoadDiagram(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        _pendingTabViews.Clear();

        try
        {
            // 1. Active le verrou dès le début pour bloquer les recalculs intermédiaires
            _isBulkUpdating = true;

            // 2. Initialisation de l'état de chargement
            _isLoadingDiagram = true;
            _loadingProgress = 0;
            _loadingStatusText = "Reading the file...";
            StateHasChanged();

            // Laisse le navigateur afficher l'overlay
            await Task.Yield();

            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var saveData = await JsonSerializer.DeserializeAsync<DiagramSaveData>(stream);

            if (saveData == null || Recipes == null)
            {
                Snackbar.Add("The save file is invalid.", Severity.Warning);
                return;
            }

            // Rétrocompatibilité avec les anciennes sauvegardes mono-onglet (v1.x)
            if (saveData.Tabs.Count == 0 && (saveData.Nodes.Count > 0 || saveData.Storages.Count > 0))
            {
                saveData.Tabs.Add(new SavedTabData
                {
                    TabId = Guid.NewGuid().ToString("N"),
                    Name = "Principal",
                    Nodes = saveData.Nodes,
                    Storages = saveData.Storages,
                    Links = saveData.Links
                });
            }

            // 2. Vider le diagramme actuel
            // (instantané grâce à _isBulkUpdating = true)
            _loadingStatusText = "Clearing previous factory...";
            StateHasChanged();
            await Task.Yield();

            Tabs.Clear();

            var exportPortalIdMap = new Dictionary<string, string>();
            var importedPortalsToRelink = new List<(PortalNodeModel ImportPortal, string OldExportId)>();

            int totalTabs = Math.Max(1, saveData.Tabs.Count);

            // Boucle qui reconstruit chaque onglet
            for (int t = 0; t < saveData.Tabs.Count; t++)
            {
                var savedTab = saveData.Tabs[t];

                var tab = new FactoryTab
                {
                    Id = string.IsNullOrWhiteSpace(savedTab.TabId) ? Guid.NewGuid().ToString("N") : savedTab.TabId,
                    Name = string.IsNullOrWhiteSpace(savedTab.Name) ? $"Secteur {t + 1}" : savedTab.Name,
                    // Restaure l'icône de ressource choisie pour cet onglet
                    IconProductId = savedTab.IconProductId,
                    Diagram = CreateConfiguredDiagram()
                };


                // Enregistre le zoom et le pan sauvegardés pour cet onglet
                double savedZoom = savedTab.Zoom > 0.05 ? savedTab.Zoom : 1.0;
                _pendingTabViews[tab.Id] = (savedZoom, savedTab.PanX, savedTab.PanY);

                // Dictionnaire unifié pour mapper les anciens ID vers les nouvelles instances de NodeModel (Machines OU Stockages)
                var allNodesMap = new Dictionary<string, NodeModel>();

                // 1. Recréation des machines (MachineNodeModel)
                for (int i = 0; i < savedTab.Nodes.Count; i++)
                {
                    var savedNode = savedTab.Nodes[i];
                    // Recherche de la recette dans les données chargées
                    var recipe = Recipes.FirstOrDefault(r => r.RecipeId == savedNode.RecipeId);

                    if (recipe != null)
                    {
                        // Instanciation de la machine à sa position d'origine
                        var node = new MachineNodeModel(recipe, new Blazor.Diagrams.Core.Geometry.Point(savedNode.X, savedNode.Y))
                        {
                            Multiplier = savedNode.Multiplier
                        };

                        // Restauration du niveau de machine si nécessaire
                        if (!string.IsNullOrWhiteSpace(savedNode.MachineId) && node.CurrentMachineId != savedNode.MachineId)
                        {
                            while (node.CurrentMachineId != savedNode.MachineId && node.Upgrade()) { }
                        }

                        // Reconstitution de l'ordre personnalisé des ports
                        node.ApplyCustomPortOrder(savedNode.OrderedInputProductIds, savedNode.OrderedOutputProductIds);

                        tab.Diagram.Nodes.Add(node);
                        allNodesMap[savedNode.NodeId] = node;
                    }
                }

                // 2. Recréation des stockages
                for (int s = 0; s < savedTab.Storages.Count; s++)
                {
                    var savedStorage = savedTab.Storages[s];
                    var storageNode = new StorageNodeModel(
                        savedStorage.ProductId,
                        new Blazor.Diagrams.Core.Geometry.Point(savedStorage.X, savedStorage.Y)
                    );

                    tab.Diagram.Nodes.Add(storageNode);
                    allNodesMap[savedStorage.NodeId] = storageNode;
                }

                // 3. Recréation des portails Export / Import
                for (int p = 0; p < savedTab.Portals.Count; p++)
                {
                    var savedPortal = savedTab.Portals[p];
                    var portalNode = new PortalNodeModel(
                        savedPortal.Direction,
                        savedPortal.ProductId,
                        savedPortal.ChannelName,
                        new Blazor.Diagrams.Core.Geometry.Point(savedPortal.X, savedPortal.Y)
                    );

                    tab.Diagram.Nodes.Add(portalNode);
                    allNodesMap[savedPortal.NodeId] = portalNode;

                    if (savedPortal.Direction == PortalDirection.Export)
                    {
                        exportPortalIdMap[savedPortal.NodeId] = portalNode.Id;
                    }
                    else if (!string.IsNullOrWhiteSpace(savedPortal.SourceExportPortalId))
                    {
                        importedPortalsToRelink.Add((portalNode, savedPortal.SourceExportPortalId));
                    }
                }

                // 4. Reconnexion des câbles et tuyaux de l'onglet
                for (int j = 0; j < savedTab.Links.Count; j++)
                {
                    var savedLink = savedTab.Links[j];

                    // Recherche des nœuds source et cible dans le dictionnaire global
                    if (allNodesMap.TryGetValue(savedLink.SourceNodeId, out var srcNode) &&
                        allNodesMap.TryGetValue(savedLink.TargetNodeId, out var tgtNode))
                    {
                        // Recherche du port source correspondant par Direction et ProductId
                        var srcPort = srcNode.Ports.OfType<ResourcePortModel>()
                            .FirstOrDefault(p => p.Direction == savedLink.SourceDirection &&
                                                 string.Equals(p.ProductId, savedLink.SourceProductId, StringComparison.OrdinalIgnoreCase));

                        // Recherche du port cible correspondant par Direction et ProductId
                        var tgtPort = tgtNode.Ports.OfType<ResourcePortModel>()
                            .FirstOrDefault(p => p.Direction == savedLink.TargetDirection &&
                                                 string.Equals(p.ProductId, savedLink.TargetProductId, StringComparison.OrdinalIgnoreCase));

                        if (srcPort != null && tgtPort != null)
                        {
                            var link = new ResourceLinkModel(new SinglePortAnchor(srcPort), new SinglePortAnchor(tgtPort));

                            // Attribution de la couleur de la ressource
                            if (ProductDict.TryGetValue(srcPort.ProductId, out var prod) && !string.IsNullOrWhiteSpace(prod.Color))
                            {
                                link.Color = prod.Color;
                            }

                            // Restauration des sommets / points de passage
                            if (savedLink.Vertices != null)
                            {
                                foreach (var pt in savedLink.Vertices)
                                {
                                    if (pt.Length == 2)
                                    {
                                        link.Vertices.Add(new LinkVertexModel(link, new Blazor.Diagrams.Core.Geometry.Point(pt[0], pt[1])));
                                    }
                                }
                            }

                            tab.Diagram.Links.Add(link);
                        }
                    }
                }

                Tabs.Add(tab);

                _loadingProgress = (int)((double)(t + 1) / totalTabs * 90);
                _loadingStatusText = $"Loading tab '{tab.Name}' ({t + 1}/{totalTabs})...";
                StateHasChanged();
                await Task.Yield();

            } // Fin de la boucle qui reconstruit chaque onglet


            // Rebranche les portails Import vers les nouveaux identifiants des portails Export
            foreach (var (importPortal, oldExportId) in importedPortalsToRelink)
            {
                if (exportPortalIdMap.TryGetValue(oldExportId, out var newExportId))
                {
                    importPortal.SourceExportPortalId = newExportId;
                }
            }

            if (Tabs.Count == 0)
            {
                Tabs.Add(new FactoryTab { Name = "Principal", Diagram = CreateConfiguredDiagram() });
            }

            ActiveTab = Tabs[0];
            FlowEngine.RegisterTabs(Tabs);

            // 6. Finalisation : Désactive le verrou et lance UN SEUL calcul global des flux
            _loadingStatusText = "Flow calculation and balancing...";
            _loadingProgress = 100;
            StateHasChanged();
            await Task.Yield();

            _isBulkUpdating = false;
            FlowEngine.RecalculateFlows(Tabs, ResourceService);

            //Diagram.Refresh();


            // Restaure l'onglet qui était actif lors de la sauvegarde (ou le premier par défaut)
            if (!string.IsNullOrWhiteSpace(saveData.ActiveTabId))
            {
                ActiveTab = Tabs.FirstOrDefault(t => t.Id == saveData.ActiveTabId) ?? Tabs[0];
            }
            else
            {
                ActiveTab = Tabs[0];
            }

            // Force le rendu du <DiagramCanvas> de l'onglet actif avant d'appliquer son Zoom et son Pan
            StateHasChanged();
            await Task.Yield();

            if (_pendingTabViews.Remove(ActiveTab.Id, out var activeView))
            {
                ApplyTabViewState(ActiveTab, activeView.Zoom, activeView.PanX, activeView.PanY);
            }


            //Snackbar.Add($"Diagram successfully loaded ({Tabs.Count} tab(s)) !", Severity.Success);
        
            // =========================================================================
            // NOTIFICATION DE CHARGEMENT : durée courte (1,5s) et clic désactivé
            // =========================================================================
            Snackbar.Add($"Diagram successfully loaded ({Tabs.Count} tab(s)) !", Severity.Success, config =>
            {
                // Durée d'affichage réduite à 1,5 seconde (au lieu de 5 secondes par défaut)
                config.VisibleStateDuration = 1500;

                // Animation d'apparition/disparition rapide (200 ms)
                config.ShowTransitionDuration = 200;
                config.HideTransitionDuration = 200;

                // Masque la croix de fermeture sur le bandeau
                config.ShowCloseIcon = false;

                // Supprime toute action au clic sur la notification
                config.OnClick = null;
            });
        
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error while loading : {ex.Message}", Severity.Error);
        }
        finally
        {
            // Sécurité : s'assure que le verrou et l'overlay sont toujours désactivés à la fin
            _isBulkUpdating = false;
            _isLoadingDiagram = false;
            StateHasChanged();
        }
    }


    /// <summary>
    /// Liste filtrée des ressources affichées dans le tiroir de bilan droit.
    /// </summary>
    private IEnumerable<ResourceBalanceItem> FilteredSummaryBalances =>
        ResourceService.GlobalResourceBalances.Where(item =>
        {
            // 1. Filtre texte
            if (!string.IsNullOrWhiteSpace(_summaryFilterText))
            {
                var term = _summaryFilterText.Trim();
                bool matchesText = item.ProductName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                                   item.ProductId.Contains(term, StringComparison.OrdinalIgnoreCase);
                if (!matchesText) return false;
            }

            // 2. Filtre par état (Déficit / Surplus / Tout)
            return _balanceFilterMode switch
            {
                BalanceFilterMode.Deficit => item.NetBalance < -0.01m,
                BalanceFilterMode.Surplus => item.NetBalance > 0.01m,
                _ => true
            };
        });


    // =========================================================================
    // NAVIGATION CYCLIQUE VERS LES MACHINES PRODUCTRICES (CLIC DROIT BILAN)
    // =========================================================================
    private string? _lastLocatedProductId;
    private int _lastLocatedProducerIndex = -1;

    /// <summary>
    /// Localise la machine qui produit la ressource demandée sur l'ensemble des onglets,
    /// bascule sur son onglet, la sélectionne et centre la vue dessus.
    /// Chaque clic droit consécutif sur la même ressource passe au producteur suivant.
    /// </summary>
    private async Task NavigateToNextProducer(string productId)
    {
        if (string.IsNullOrWhiteSpace(productId)) return;

        // 1. Collecte toutes les machines actives qui produisent cette ressource (dans l'ordre des onglets)
        var producers = new List<(FactoryTab Tab, MachineNodeModel Machine)>();

        foreach (var tab in Tabs)
        {
            foreach (var machine in tab.Diagram.Nodes.OfType<MachineNodeModel>())
            {
                if (machine.IsPaused) continue;

                bool producesResource = machine.Recipe.Outputs.Any(o =>
                    string.Equals(o.ProductId, productId, StringComparison.OrdinalIgnoreCase) &&
                    machine.GetActualProducedRatePerMin(o) > 0m);

                if (producesResource)
                {
                    producers.Add((tab, machine));
                }
            }
        }

        // Aucun producteur actif trouvé (ex: ressource uniquement importée ou en déficit total)
        if (producers.Count == 0)
        {
            Snackbar.Add("No active machine produces this resource.", Severity.Info, config =>
            {
                config.VisibleStateDuration = 1500;
                config.ShowCloseIcon = false;
            });
            return;
        }

        // 2. Détermine l'index de la cible (incrémente si clic consécutif sur la même ressource)
        if (string.Equals(_lastLocatedProductId, productId, StringComparison.OrdinalIgnoreCase))
        {
            _lastLocatedProducerIndex = (_lastLocatedProducerIndex + 1) % producers.Count;
        }
        else
        {
            _lastLocatedProductId = productId;
            _lastLocatedProducerIndex = 0;
        }

        var (targetTab, targetMachine) = producers[_lastLocatedProducerIndex];

        // 3. Bascule vers l'onglet de la machine si ce n'est pas l'onglet actif
        // (await garantit que la restauration éventuelle du Zoom/Pan de l'onglet est terminée avant de centrer la caméra)
        if (ActiveTab?.Id != targetTab.Id)
        {
            await SelectTab(targetTab.Id);
        }

        // 4. Désélectionne les autres nœuds et sélectionne la machine cible
        targetTab.Diagram.UnselectAll();
        targetTab.Diagram.SelectModel(targetMachine, unselectOthers: true);

        // 5. Centre la caméra du diagramme sur la machine cible
        CenterCameraOnNode(targetTab.Diagram, targetMachine);
    }

    /// <summary>
    /// Déplace le panoramique (Pan) du diagramme pour placer le centre du nœud
    /// au milieu de la fenêtre visible (en tenant compte du zoom actuel).
    /// </summary>
    private void CenterCameraOnNode(BlazorDiagram diagram, NodeModel node)
    {
        // Dimensions réelles du nœud ou valeurs par défaut de MachineNodeWidget (330x160)
        double nodeWidth = node.Size?.Width ?? 330.0;
        double nodeHeight = node.Size?.Height ?? 160.0;

        // Centre géométrique du nœud dans le repère du diagramme
        double nodeCenterX = node.Position.X + (nodeWidth / 2.0);
        double nodeCenterY = node.Position.Y + (nodeHeight / 2.0);

        // Dimensions visibles du conteneur du canvas
        double canvasWidth = diagram.Container?.Width ?? 1200.0;
        double canvasHeight = diagram.Container?.Height ?? 800.0;

        // Formule inverse du centrage : Pan = (CentreÉcran) - (CentreNœud * Zoom)
        double zoom = diagram.Zoom;
        double newPanX = (canvasWidth / 2.0) - (nodeCenterX * zoom);
        double newPanY = (canvasHeight / 2.0) - (nodeCenterY * zoom);

        diagram.SetPan(newPanX, newPanY);
        diagram.Refresh();
    }


    // =========================================================================
    // MULTI-SÉLECTION AU RECTANGLE (SHIFT + MAINTIEN CLIC GAUCHE SOURIS)
    // =========================================================================
    private bool _isBoxSelecting = false;
    private double _boxStartClientX;
    private double _boxStartClientY;
    private double _boxCurrentClientX;
    private double _boxCurrentClientY;

    // Position relative au conteneur du canvas pour dessiner le cadre visuel
    private double _boxStartRelX;
    private double _boxStartRelY;
    private double _boxCurrentRelX;
    private double _boxCurrentRelY;

    private string SelectionBoxStyle
    {
        get
        {
            double left = Math.Min(_boxStartRelX, _boxCurrentRelX);
            double top = Math.Min(_boxStartRelY, _boxCurrentRelY);
            double width = Math.Abs(_boxCurrentRelX - _boxStartRelX);
            double height = Math.Abs(_boxCurrentRelY - _boxStartRelY);
            return FormattableString.Invariant($"left: {left:0.##}px; top: {top:0.##}px; width: {width:0.##}px; height: {height:0.##}px;");
        }
    }

    private void OnCanvasPointerDown(PointerEventArgs e)
    {
        if (Diagram == null) return;

        // Démarre la sélection au rectangle uniquement si Shift est maintenu + clic gauche
        if (e.ShiftKey && e.Button == 0)
        {
            // Désactive temporairement le déplacement de la carte (Panning) pendant le tracé du cadre
            Diagram.Options.AllowPanning = false;

            _isBoxSelecting = true;
            _boxStartClientX = _boxCurrentClientX = e.ClientX;
            _boxStartClientY = _boxCurrentClientY = e.ClientY;
            _boxStartRelX = _boxCurrentRelX = e.OffsetX;
            _boxStartRelY = _boxCurrentRelY = e.OffsetY;
        }
    }

    private void OnCanvasPointerMove(PointerEventArgs e)
    {
        if (!_isBoxSelecting || Diagram == null) return;

        // Sécurité : si le bouton gauche a été relâché hors du cadre
        if (e.Buttons == 0)
        {
            FinishBoxSelection();
            return;
        }

        // Met à jour la taille du rectangle visuel
        _boxCurrentRelX += (e.ClientX - _boxCurrentClientX);
        _boxCurrentRelY += (e.ClientY - _boxCurrentClientY);
        _boxCurrentClientX = e.ClientX;
        _boxCurrentClientY = e.ClientY;
    }

    private void OnCanvasPointerUp(PointerEventArgs e)
    {
        if (!_isBoxSelecting) return;
        FinishBoxSelection();
    }

    private void FinishBoxSelection()
    {
        _isBoxSelecting = false;

        if (Diagram == null) return;

        // Réactive immédiatement le déplacement normal du canvas
        Diagram.Options.AllowPanning = true;

        // Conversion des deux coins écran du rectangle en coordonnées du diagramme (gère Zoom + Pan)
        var p1 = Diagram.GetRelativeMousePoint(_boxStartClientX, _boxStartClientY);
        var p2 = Diagram.GetRelativeMousePoint(_boxCurrentClientX, _boxCurrentClientY);

        double minX = Math.Min(p1.X, p2.X);
        double maxX = Math.Max(p1.X, p2.X);
        double minY = Math.Min(p1.Y, p2.Y);
        double maxY = Math.Max(p1.Y, p2.Y);

        // Ignore les micro-clics accidentels (< 5px)
        if ((maxX - minX) < 5.0 && (maxY - minY) < 5.0) return;

        Diagram.UnselectAll();

        // 1. Sélectionne tous les nœuds (Machines, Stockages, Portails) qui chevauchent le rectangle
        foreach (var node in Diagram.Nodes)
        {
            double w = node.Size?.Width ?? (node is MachineNodeModel ? 330.0 : 260.0);
            double h = node.Size?.Height ?? (node is MachineNodeModel ? 160.0 : 95.0);

            bool overlaps = node.Position.X <= maxX &&
                            (node.Position.X + w) >= minX &&
                            node.Position.Y <= maxY &&
                            (node.Position.Y + h) >= minY;

            if (overlaps)
            {
                Diagram.SelectModel(node, unselectOthers: false);
            }
        }

        // 2. Sélectionne tous les liens dont une extrémité ou un sommet est à l'intérieur du rectangle
        foreach (var link in Diagram.Links)
        {
            var pts = new List<Blazor.Diagrams.Core.Geometry.Point>();

            if ((link.Source as SinglePortAnchor)?.Port is PortModel sp)
                pts.Add(sp.MiddlePosition);

            foreach (var v in link.Vertices)
                pts.Add(v.Position);

            if ((link.Target as SinglePortAnchor)?.Port is PortModel tp)
                pts.Add(tp.MiddlePosition);

            bool linkInside = pts.Any(pt => pt.X >= minX && pt.X <= maxX && pt.Y >= minY && pt.Y <= maxY);
            if (linkInside)
            {
                Diagram.SelectModel(link, unselectOthers: false);
            }
        }

        Diagram.Refresh();
    }


    // =========================================================================
    // PRESSE-PAPIERS MULTI-ÉLÉMENTS : COPIER (CTRL+C) / COUPER (CTRL+X) / COLLER (CTRL+V)
    // =========================================================================
    private sealed class ClipboardGroupData
    {
        public List<SavedNodeData> Machines { get; set; } = new();
        public List<SavedStorageData> Storages { get; set; } = new();
        public List<SavedPortalData> Portals { get; set; } = new();
        public List<SavedLinkData> InternalLinks { get; set; } = new();
    }

    private ClipboardGroupData? _clipboard;
    private int _pasteCount = 0;

    /// <summary>
    /// Copie tous les éléments sélectionnés (machines, stockages, portails et liens internes entre eux).
    /// </summary>
    private void CopySelectionToClipboard(bool showNotification = true)
    {
        if (Diagram == null) return;

        var selectedNodes = Diagram.Nodes.Where(n => n.Selected).ToList();
        if (selectedNodes.Count == 0) return;

        var selectedNodeIds = selectedNodes.Select(n => n.Id).ToHashSet();
        var data = new ClipboardGroupData();

        // 1. Capture les machines sélectionnées
        foreach (var m in selectedNodes.OfType<MachineNodeModel>())
        {
            data.Machines.Add(new SavedNodeData
            {
                NodeId = m.Id,
                RecipeId = m.Recipe.RecipeId,
                MachineId = m.CurrentMachineId,
                Multiplier = m.Multiplier,
                X = m.Position.X,
                Y = m.Position.Y,
                OrderedInputProductIds = m.Recipe.Inputs.Select(i => i.ProductId).ToList(),
                OrderedOutputProductIds = m.Recipe.Outputs.Select(o => o.ProductId).ToList()
            });
        }

        // 2. Capture les stockages sélectionnés
        foreach (var s in selectedNodes.OfType<StorageNodeModel>())
        {
            data.Storages.Add(new SavedStorageData
            {
                NodeId = s.Id,
                ProductId = s.ProductId,
                X = s.Position.X,
                Y = s.Position.Y
            });
        }

        // 3. Capture les portails sélectionnés
        foreach (var p in selectedNodes.OfType<PortalNodeModel>())
        {
            data.Portals.Add(new SavedPortalData
            {
                NodeId = p.Id,
                Direction = p.Direction,
                ProductId = p.ProductId,
                ChannelName = p.ChannelName,
                SourceExportPortalId = p.SourceExportPortalId,
                X = p.Position.X,
                Y = p.Position.Y
            });
        }

        // 4. Capture uniquement les liens dont BOTH extrémités font partie de la sélection
        foreach (var link in Diagram.Links)
        {
            if (link.Source is SinglePortAnchor srcAnchor &&
                srcAnchor.Port is ResourcePortModel srcPort &&
                link.Target is SinglePortAnchor tgtAnchor &&
                tgtAnchor.Port is ResourcePortModel tgtPort &&
                srcPort.Parent is NodeModel srcNode &&
                tgtPort.Parent is NodeModel tgtNode &&
                selectedNodeIds.Contains(srcNode.Id) &&
                selectedNodeIds.Contains(tgtNode.Id))
            {
                var savedLink = new SavedLinkData
                {
                    SourceNodeId = srcNode.Id,
                    SourceProductId = srcPort.ProductId,
                    SourceDirection = srcPort.Direction,
                    TargetNodeId = tgtNode.Id,
                    TargetProductId = tgtPort.ProductId,
                    TargetDirection = tgtPort.Direction
                };

                foreach (var v in link.Vertices)
                {
                    savedLink.Vertices.Add(new double[] { v.Position.X, v.Position.Y });
                }

                data.InternalLinks.Add(savedLink);
            }
        }

        _clipboard = data;
        _pasteCount = 0;

        if (showNotification)
        {
            Snackbar.Add($"Copied {selectedNodes.Count} item(s) and {data.InternalLinks.Count} link(s).", Severity.Info, cfg =>
            {
                cfg.VisibleStateDuration = 1200;
                cfg.ShowCloseIcon = false;
            });
        }
    }

    /// <summary>
    /// Coupe les éléments sélectionnés (Copie + Suppression immédiate).
    /// </summary>
    private void CutSelectionToClipboard()
    {
        if (Diagram == null) return;

        var selectedNodes = Diagram.Nodes.Where(n => n.Selected).ToList();
        var selectedLinks = Diagram.Links.Where(l => l.Selected).ToList();
        if (selectedNodes.Count == 0 && selectedLinks.Count == 0) return;

        if (selectedNodes.Count > 0)
        {
            CopySelectionToClipboard(showNotification: false);
        }

        foreach (var link in selectedLinks)
            Diagram.Links.Remove(link);

        foreach (var node in selectedNodes)
            Diagram.Nodes.Remove(node);

        Snackbar.Add($"Cut {selectedNodes.Count} item(s).", Severity.Warning, cfg =>
        {
            cfg.VisibleStateDuration = 1200;
            cfg.ShowCloseIcon = false;
        });
    }

    /// <summary>
    /// Colle le groupe mémorisé dans l'onglet actif en décalant légèrement sa position
    /// et en reconstituant tous les liens internes.
    /// </summary>
    private async Task PasteFromClipboard()
    {
        if (Diagram == null || _clipboard == null || Recipes == null) return;

        _pasteCount++;
        double offset = 40.0 * _pasteCount;

        var nodeMap = new Dictionary<string, NodeModel>();
        var newlyCreatedNodes = new List<NodeModel>();

        try
        {
            _isBulkUpdating = true;

            // 1. Recréation des machines
            foreach (var savedNode in _clipboard.Machines)
            {
                var recipe = Recipes.FirstOrDefault(r => r.RecipeId == savedNode.RecipeId);
                if (recipe == null) continue;

                var node = new MachineNodeModel(recipe, new Blazor.Diagrams.Core.Geometry.Point(savedNode.X + offset, savedNode.Y + offset))
                {
                    Multiplier = savedNode.Multiplier
                };

                if (!string.IsNullOrWhiteSpace(savedNode.MachineId) && node.CurrentMachineId != savedNode.MachineId)
                {
                    while (node.CurrentMachineId != savedNode.MachineId && node.Upgrade()) { }
                }

                node.ApplyCustomPortOrder(savedNode.OrderedInputProductIds, savedNode.OrderedOutputProductIds);

                Diagram.Nodes.Add(node);
                nodeMap[savedNode.NodeId] = node;
                newlyCreatedNodes.Add(node);
            }

            // 2. Recréation des stockages
            foreach (var savedStorage in _clipboard.Storages)
            {
                var storage = new StorageNodeModel(
                    savedStorage.ProductId,
                    new Blazor.Diagrams.Core.Geometry.Point(savedStorage.X + offset, savedStorage.Y + offset)
                );

                Diagram.Nodes.Add(storage);
                nodeMap[savedStorage.NodeId] = storage;
                newlyCreatedNodes.Add(storage);
            }

            // 3. Recréation des portails
            foreach (var savedPortal in _clipboard.Portals)
            {
                var portal = new PortalNodeModel(
                    savedPortal.Direction,
                    savedPortal.ProductId,
                    savedPortal.Direction == PortalDirection.Export ? $"{savedPortal.ChannelName} (copy)" : savedPortal.ChannelName,
                    new Blazor.Diagrams.Core.Geometry.Point(savedPortal.X + offset, savedPortal.Y + offset),
                    savedPortal.SourceExportPortalId
                );

                Diagram.Nodes.Add(portal);
                nodeMap[savedPortal.NodeId] = portal;
                newlyCreatedNodes.Add(portal);
            }

            // 4. Recréation des liens internes entre les éléments collés
            foreach (var savedLink in _clipboard.InternalLinks)
            {
                if (nodeMap.TryGetValue(savedLink.SourceNodeId, out var srcNode) &&
                    nodeMap.TryGetValue(savedLink.TargetNodeId, out var tgtNode))
                {
                    var srcPort = srcNode.Ports.OfType<ResourcePortModel>()
                        .FirstOrDefault(p => p.Direction == savedLink.SourceDirection &&
                                             string.Equals(p.ProductId, savedLink.SourceProductId, StringComparison.OrdinalIgnoreCase));

                    var tgtPort = tgtNode.Ports.OfType<ResourcePortModel>()
                        .FirstOrDefault(p => p.Direction == savedLink.TargetDirection &&
                                             string.Equals(p.ProductId, savedLink.TargetProductId, StringComparison.OrdinalIgnoreCase));

                    if (srcPort != null && tgtPort != null)
                    {
                        var link = new ResourceLinkModel(new SinglePortAnchor(srcPort), new SinglePortAnchor(tgtPort));

                        if (ProductDict.TryGetValue(srcPort.ProductId, out var prod) && !string.IsNullOrWhiteSpace(prod.Color))
                        {
                            link.Color = prod.Color;
                        }

                        if (savedLink.Vertices != null)
                        {
                            foreach (var pt in savedLink.Vertices)
                            {
                                if (pt.Length == 2)
                                {
                                    link.Vertices.Add(new LinkVertexModel(link, new Blazor.Diagrams.Core.Geometry.Point(pt[0] + offset, pt[1] + offset)));
                                }
                            }
                        }

                        Diagram.Links.Add(link);
                    }
                }
            }
        }
        finally
        {
            _isBulkUpdating = false;
        }

        if (newlyCreatedNodes.Count == 0) return;

        // Laisse Blazor monter les ports dans le DOM avant de sélectionner le groupe
        StateHasChanged();
        await Task.Yield();

        Diagram.UnselectAll();
        foreach (var n in newlyCreatedNodes)
        {
            n.Refresh();
            Diagram.SelectModel(n, unselectOthers: false);
        }

        Diagram.Refresh();
        FlowEngine.RecalculateFlows(Tabs, ResourceService);

        Snackbar.Add($"Pasted {newlyCreatedNodes.Count} item(s).", Severity.Success, cfg =>
        {
            cfg.VisibleStateDuration = 1200;
            cfg.ShowCloseIcon = false;
        });
    }


