@using MudBlazor
@using Blazor.Diagrams.Components.Renderers
@using Blazor.Diagrams.Core
@using CaptainArchitect.Models
@using CaptainArchitect.Services
@inject ResourceService ResourceService
@implements IDisposable

<div class="storage-card @(Node.Selected ? "selected" : "")">

    <!-- En-tête : Titre et boutons d'actions -->
    <div class="storage-header">

        <div class="d-flex align-center gap-1">
            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="MudBlazor.Size.Small" Style="color: #38bdf8; font-size: 0.9rem;" />
            <span class="storage-title" title="@ProductDisplayName">
                @ProductDisplayName
            </span>
        </div>

        <div class="d-flex align-center gap-1">

            <!-- Bouton Dupliquer le stockage -->
            <button class="btn-duplicate"
                    title="Dupliquer le stockage (Ctrl+D)"
                    @onclick="DuplicateThisNode"
                    @onclick:stopPropagation="true">
                ⧉
            </button>

            <!-- Croix rouge immédiatement à sa droite Bouton supprimer -->
            <button class="btn-delete" title="Supprimer le stockage" @onclick="DeleteNode">✕</button>
        </div>

    </div>

    <!-- Corps du stockage : Ports collés aux bords -->
    <div class="storage-body">

        <!-- Port d'entrée (Gauche) avec son identifiant pour forcer la mise à jour -->
        <div class="storage-port-wrapper input-wrapper">
            <PortRenderer @key="Node.InputPort.Id" Port="Node.InputPort" Class="diagram-port" />
            <div class="rate-stack text-left">
                <span class="rate-label">IN</span>
                <span class="rate-value in-rate">@Node.TotalInputRate.ToString("0.#")/m</span>
            </div>
        </div>

        <!-- Centre : Icône et Bilan net -->
        <div class="storage-center">
            <ResourceBadge ProductId="@Node.ProductId" />

            @{
                var hasIn = Node.InputPort.Links.Count > 0;
                var hasOut = Node.OutputPort.Links.Count > 0;
                var netBalance = Node.TotalInputRate - Node.DistributedOutputRate;

                var isDeficit = hasOut && Node.DownstreamDemandRate > Node.TotalInputRate + 0.01m;
                var isSurplus = hasIn && netBalance > 0.01m;

                var balanceClass = (!hasIn && !hasOut) ? "balance-neutral"
                                                 : isDeficit ? "balance-deficit"
                                                 : isSurplus ? "balance-surplus"
                                                 : "balance-ok";
            }

            <div class="balance-tag @balanceClass" title="Bilan net (Entrée - Sortie)">
                @if (hasIn || hasOut)
                {
                    @if (isDeficit)
                    {
                        var missing = Node.DownstreamDemandRate - Node.TotalInputRate;
                        <span>-@missing.ToString("0.#")/m</span>
                    }
                    else if (isSurplus)
                    {
                        <span>+@netBalance.ToString("0.#")/m</span>
                    }
                    else
                    {
                        <span>0/m ✓</span>
                    }
                }
                else
                {
                    <span>Libre</span>
                }
            </div>
        </div>

        <!-- Port de sortie (Droite) avec son identifiant -->
        <div class="storage-port-wrapper output-wrapper">
            <div class="rate-stack text-right">
                <span class="rate-label">OUT</span>
                <span class="rate-value out-rate">@Node.DistributedOutputRate.ToString("0.#")/m</span>
            </div>
            <PortRenderer @key="Node.OutputPort.Id" Port="Node.OutputPort" Class="diagram-port" />
        </div>

    </div>
</div>

<style>
    .storage-card {
        position: relative;
        width: 260px !important;
        min-width: 260px !important;
        max-width: 260px !important;
        background: #242427;
        border: 2px solid #3f3f46;
        border-radius: 8px;
        color: #f4f4f5;
        font-family: sans-serif;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.45);
        user-select: none;
    }

        .storage-card.selected {
            border-color: #38bdf8;
        }

    .storage-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #18181b;
        padding: 5px 8px;
        border-top-left-radius: 6px;
        border-top-right-radius: 6px;
        border-bottom: 1px solid #3f3f46;
    }

    .storage-title {
        font-weight: 600;
        font-size: 0.80rem;
        color: #e4e4e7;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        max-width: 190px;
    }

    .btn-duplicate {
        background: transparent;
        border: none;
        color: #38bdf8;
        font-size: 0.95rem;
        cursor: pointer;
        padding: 0 4px;
        line-height: 1;
        border-radius: 4px;
        transition: background 0.15s, color 0.15s;
    }

    .btn-duplicate:hover {
        background: rgba(56, 189, 248, 0.2);
        color: #7dd3fc;
    }

    .btn-delete {
        background: transparent;
        border: none;
        color: #ef4444;
        font-size: 1rem;
        cursor: pointer;
        padding: 0 4px;
        line-height: 1;
    }

        .btn-delete:hover {
            color: #f87171;
        }

    .storage-body {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 0;
        width: 100%;
        box-sizing: border-box;
    }

    /* Conteneurs des ports collés aux extrémités */
    .storage-port-wrapper {
        display: flex;
        align-items: center;
        gap: 6px;
        width: 80px;
        box-sizing: border-box;
    }

    .input-wrapper {
        justify-content: flex-start;
        padding-left: 0;
        margin-left: -6px; /* Place le centre du port exactement sur la bordure gauche */
    }

    .output-wrapper {
        justify-content: flex-end;
        padding-right: 0;
        margin-right: -6px; /* Place le centre du port exactement sur la bordure droite */
    }

    /* STYLES EXPLICITES DES PORTS DU STOCKAGE (évite la dépendance à MachineNodeWidget) */
    .diagram-port {
        width: 12px !important;
        height: 12px !important;
        min-width: 12px !important;
        min-height: 12px !important;
        flex-shrink: 0 !important;
        background: #3b82f6 !important;
        border: 2px solid #ffffff !important;
        border-radius: 50% !important;
        cursor: crosshair !important;
        box-sizing: border-box !important;
        display: inline-block !important;
    }

    .rate-stack {
        display: flex;
        flex-direction: column;
        line-height: 1.15;
        white-space: nowrap;
    }

    .text-left {
        text-align: left;
    }

    .text-right {
        text-align: right;
    }

    .rate-label {
        font-size: 0.60rem;
        color: #71717a;
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    .rate-value {
        font-size: 0.75rem;
        font-weight: bold;
    }

    .in-rate {
        color: #38bdf8;
    }

    .out-rate {
        color: #4ade80;
    }

    .storage-center {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 3px;
        flex: 1;
    }

    .balance-tag {
        font-size: 0.65rem;
        font-weight: bold;
        padding: 1px 6px;
        border-radius: 4px;
        background: #18181b;
        white-space: nowrap;
    }

    .balance-ok {
        color: #4ade80;
    }

    .balance-surplus {
        color: #38bdf8;
    }

    .balance-deficit {
        color: #f87171;
    }

    .balance-neutral {
        color: #71717a;
    }
</style>

@code {
    [CascadingParameter] public BlazorDiagram Diagram { get; set; } = default!;
    [Parameter] public StorageNodeModel Node { get; set; } = default!;

    private Product? ProductEntity => ResourceService.GetProduct(Node.ProductId);
    private string ProductDisplayName => ProductEntity?.Name ?? Node.ProductId;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        // Abonnement au changement du modèle
        if (Node != null)
        {
            Node.Changed += OnNodeChanged;
        }
    }

    // Force la prise en compte des coordonnées géométriques des ports dès que le DOM est peint
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && Node != null)
        {
            // Notifie les ports pour que Blazor.Diagrams enregistre leur position absolue
            Node.InputPort?.Refresh();
            Node.OutputPort?.Refresh();
        }
    }

    // Accepte le modèle passé par l'événement Action<Model> de Blazor.Diagrams
    private void OnNodeChanged(Blazor.Diagrams.Core.Models.Base.Model model)
    {
        InvokeAsync(StateHasChanged);
    }

    private void DeleteNode()
    {
        Diagram.Nodes.Remove(Node);
        FlowEngine.RecalculateFlows(Diagram, ResourceService);
    }

    public void Dispose()
    {
        if (Node != null)
        {
            Node.Changed -= OnNodeChanged;
        }
    }

    // Duplication de ce stockage
    private async Task DuplicateThisNode()
    {
        // 1. Décalage de 40px
        var newPosition = new Blazor.Diagrams.Core.Geometry.Point(Node.Position.X + 40, Node.Position.Y + 40);
        var clone = new StorageNodeModel(Node.ProductId, newPosition);

        // 2. Désélectionne tout avant l'ajout
        Diagram.UnselectAll();

        // 3. Ajout au diagramme
        Diagram.Nodes.Add(clone);

        // 4. Attente du rendu DOM
        await Task.Yield();

        // 5. Sélectionne le nouveau stockage
        Diagram.SelectModel(clone, unselectOthers: true);

        clone.Refresh();
        Diagram.Refresh();
        FlowEngine.RecalculateFlows(Diagram, ResourceService);
    }

}