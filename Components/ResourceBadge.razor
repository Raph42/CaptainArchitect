@using MudBlazor
@using CaptainArchitect.Models
@using CaptainArchitect.Services
@inject ResourceService ResourceService

<MudTooltip Text="@TooltipText" Placement="Placement.Top" Arrow="true">
    <!-- Ajout de l'événement @onclick et d'un curseur pointeur -->
    <div class="resource-badge" @onclick="OnClickBadge" @onclick:stopPropagation="true">
        <img src="@ImagePath" 
             alt="@TooltipText" 
             class="resource-icon"
             loading="lazy"
             decoding="async"
             draggable="false"
             onload="this.style.display='block'; this.nextElementSibling.style.display='none';"
             onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';" />
        <!-- Repli textuel si l'image n'est pas trouvée -->
        <span class="resource-fallback" style="display:none;">@FallbackName</span>
    </div>
</MudTooltip>


<style>
    .resource-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;  /* Augmenté (ex: de 26px à 36px) */
        height: 36px; /* Augmenté (ex: de 26px à 36px) */
        border-radius: 4px;
        background: #1e1e1e;
        border: 1px solid #444;
        padding: 2px;
        cursor: pointer; /* Indique clairement que c'est cliquable */
        transition: transform 0.1s ease, border-color 0.2s ease;
    }

    .resource-badge:hover {
        border-color: #3b82f6;
        transform: scale(1.1); /* Petit zoom sympa au survol */
    }

    .resource-icon {
        width: 100%;
        height: 100%;
        object-fit: contain;
        user-select: none;
        -webkit-user-drag: none;
    }

    .resource-fallback {
        font-size: 0.65rem;
        color: #ddd;
        text-transform: uppercase;
    }
</style>




@code {
    [Parameter, EditorRequired] public string ProductId { get; set; } = string.Empty;
    [Parameter] public string? ResourceId { get; set; }

    // Direction du port (Input ou Output). Null si affiché dans le tiroir de gauche
    [Parameter] public PortDirection? Direction { get; set; }

    private string EffectiveId => 
        !string.IsNullOrWhiteSpace(ProductId) ? ProductId : (ResourceId ?? string.Empty);

    private Product? Prod => ResourceService.GetProduct(ProductId);


    // 1. Image : utilise le chemin exact défini dans le JSON, ou repli par défaut
    private string ImagePath
    {
        get
        {
            var path = !string.IsNullOrWhiteSpace(Prod?.Image)
                ? Prod.Image
                : $"images/resources/{ProductId}.png";

            // Supprime le slash initial éventuel pour rester relatif à la base du site
            return path.TrimStart('/');
        }
    }

    // 2. Nom : utilise le vrai nom du JSON (ex: "Acid", "Iron Ore")
    private string TooltipText =>
        Prod?.Name ?? ProductId;

    // 3. Trois premières lettres pour le secours
    private string FallbackName =>
        (Prod?.Name ?? ProductId).Substring(0, Math.Min(3, (Prod?.Name ?? ProductId).Length));

    // Déclenché au clic sur l'icône de la ressource
    private void OnClickBadge()
    {
        // On transmet toujours le clic :
        // - Si Direction a une valeur (badge sur une machine), elle est transmise
        // - Si Direction est null (badge dans le panneau latéral), null est transmis
        ResourceService.SelectFilterResource(EffectiveId, Direction);
    }

}