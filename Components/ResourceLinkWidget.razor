@* injecter le style stroke en ligne directement avec la couleur de la ressource *@

@using Blazor.Diagrams.Components.Renderers
@using Blazor.Diagrams.Core
@using Blazor.Diagrams.Core.Models
@using Blazor.Diagrams.Core.Geometry
@using CaptainArchitect.Models
@using Blazor.Diagrams.Core.Anchors
@inherits LinkWidget

<g class="resource-link @(Link.Selected ? "selected" : "")"
   style="@StyleString"
   @ondblclick="OnDoubleClick"
   @oncontextmenu="OnRightClick" 
   @oncontextmenu:preventDefault="true">

    <!-- Infobulle native qui s'affiche au survol du câble -->
    <title>Double-click: add a point | Right-click: delete the point / pipe</title>

    <!-- Rendu natif SVG généré par Blazor.Diagrams (trajectoire path + poignées diagram-vertex) -->
    @base.BuildRenderTree
</g>


<style>
    /* 1. STYLE DU CÂBLE / TUYAU SVG */
    .resource-link path {
        stroke: var(--link-color, #38bdf8) !important;
        stroke-width: 8px !important; /* Règle ici la largeur (ex: 8px, 10px ou 12px) */
        stroke-linecap: round !important; /* Bouts arrondis pour un rendu plus propre */
        stroke-linejoin: round !important;
        fill: none !important;

        /* Curseur en forme de réticule précis pour inciter à l'ajout de point */
        /* cursor: crosshair !important; */
        cursor: pointer !important;
        pointer-events: stroke !important;
        transition: stroke-width 0.15s ease;
    }

    /* Épaississement dynamique au survol pour indiquer que le tuyau est interactif */
    .resource-link path:hover {
        stroke-width: 10px !important;
    }

    /* Style quand la courbe est sélectionnée */
    .resource-link.selected path {
        stroke: #fbbf24 !important; /* Jaune de sélection */
        stroke-width: 10px !important; /* Légèrement plus large au clic */
    }

    /* 2. STYLE DES POINTS DE PASSAGE (VERTICES) */
    .diagram-vertex {
        fill: #fbbf24 !important;
        stroke: #ffffff !important;
        stroke-width: 2px !important;
        width: 14px;
        height: 14px;

        /* Curseur 'grab' ou 'move' pour indiquer clairement qu'on peut l'attraper et le glisser */
        cursor: grab !important;
        transition: transform 0.15s ease, fill 0.15s ease;
    }

    /* Curseur 'grabbing' quand on clique et déplace le point */
    .diagram-vertex:active {
        cursor: grabbing !important;
    }

    /* Survol d'un point existant : devient rouge pour avertir de la suppression au clic droit */
    .diagram-vertex:hover {
        fill: #ef4444 !important; /* Rouge d'alerte suppression */
        stroke: #fca5a5 !important;
        transform: scale(1.25);
    }

</style>



@code {
    [CascadingParameter] public BlazorDiagram Diagram { get; set; } = default!;

    // Détermine la couleur hexadécimale de la ressource ou bleu par défaut
    private string StyleString => Link is ResourceLinkModel resLink && !string.IsNullOrWhiteSpace(resLink.Color)
        ? $"--link-color: {resLink.Color};"
        : "--link-color: #38bdf8;";



    // =========================================================================
    // AJOUT D'UN POINT DE PASSAGE (VERTEX) AU DOUBLE-CLIC
    // =========================================================================
    private void OnDoubleClick(MouseEventArgs e)
    {
        if (Diagram == null || Link == null) return;

        // 1. Convertit les coordonnées de la souris (écran) vers le repère du diagramme
        var clickPoint = Diagram.GetRelativeMousePoint(e.ClientX, e.ClientY);

        // 2. Si le lien ne contient encore aucun point intermédiaire, ajout direct
        if (Link.Vertices.Count == 0)
        {
            Link.Vertices.Add(new LinkVertexModel(Link, clickPoint));
            Link.Refresh();
            return;
        }

        // 3. Récupère la liste complète et ordonnée de tous les points formant le câble :
        // [Point Source] -> [Sommet 0] -> [Sommet 1] -> ... -> [Point Cible]
        var allPoints = new List<Blazor.Diagrams.Core.Geometry.Point>();

        // --- POINT DE DÉPART (SOURCE) ---
        // On récupère la position calculée de l'ancre source, ou le milieu de son port[cite: 17]
        var sourcePos = Link.Source.GetPosition(Link)
                     ?? (Link.Source as SinglePortAnchor)?.Port.MiddlePosition
                     ?? clickPoint;
        allPoints.Add(sourcePos);

        // --- POINTS DE PASSAGE EXISTANTS ---
        foreach (var v in Link.Vertices)
        {
            allPoints.Add(v.Position);
        }

        // --- POINT D'ARRIVÉE (CIBLE) ---
        // On récupère la position calculée de l'ancre cible[cite: 17]
        var targetPos = Link.Target?.GetPosition(Link)
                     ?? (Link.Target as SinglePortAnchor)?.Port.MiddlePosition
                     ?? sourcePos;
        allPoints.Add(targetPos);

        // 4. Détermine quel segment consécutif est le plus proche de l'endroit double-cliqué
        int bestSegmentIndex = 0;
        double minDistance = double.MaxValue;

        for (int i = 0; i < allPoints.Count - 1; i++)
        {
            var pA = allPoints[i];
            var pB = allPoints[i + 1];

            double dist = DistanceToSegment(clickPoint, pA, pB);
            if (dist < minDistance)
            {
                minDistance = dist;
                bestSegmentIndex = i; // Segment détecté entre point i et point i+1
            }
        }

        // 5. Insère le point à l'index précis dans la collection Vertices pour éviter les boucles
        int insertIndex = Math.Clamp(bestSegmentIndex, 0, Link.Vertices.Count);
        Link.Vertices.Insert(insertIndex, new LinkVertexModel(Link, clickPoint));

        // 6. Rafraîchit la courbe
        Link.Refresh();
    }



    /// <summary>
    /// Calcule la distance orthogonale la plus courte entre un point cliqué P et un segment de droite [A, B].
    /// </summary>
    private double DistanceToSegment(Blazor.Diagrams.Core.Geometry.Point p,
                                     Blazor.Diagrams.Core.Geometry.Point a,
                                     Blazor.Diagrams.Core.Geometry.Point b)
    {
        double dx = b.X - a.X;
        double dy = b.Y - a.Y;
        double lengthSquared = dx * dx + dy * dy;

        // Si le segment est de longueur nulle (points superposés)
        if (lengthSquared == 0)
        {
            double diffX = p.X - a.X;
            double diffY = p.Y - a.Y;
            return Math.Sqrt(diffX * diffX + diffY * diffY);
        }

        // Projection du point P sur la droite (A, B) bornée entre 0.0 et 1.0 (segment fermé)
        double t = Math.Max(0, Math.Min(1, ((p.X - a.X) * dx + (p.Y - a.Y) * dy) / lengthSquared));

        // Coordonnées du point projeté le plus proche sur le segment
        double projX = a.X + t * dx;
        double projY = a.Y + t * dy;

        double deltaX = p.X - projX;
        double deltaY = p.Y - projY;

        return Math.Sqrt(deltaX * deltaX + deltaY * deltaY);
    }



    // =========================================================================
    // GESTION DU CLIC DROIT : Point seul OU Tuyau complet
    // =========================================================================
    private void OnRightClick(MouseEventArgs e)
    {
        if (Diagram == null || Link == null) return;

        // 1. Récupère la position du clic droit dans les coordonnées du diagramme
        var clickPoint = Diagram.GetRelativeMousePoint(e.ClientX, e.ClientY);

        // Rayon de détection en pixels (un vertex fait environ 12px de large)
        const double tolerance = 15.0;

        // 2. Recherche si le clic droit a eu lieu directement sur un point de passage existant
        var clickedVertex = Link.Vertices.FirstOrDefault(v =>
            Math.Abs(v.Position.X - clickPoint.X) <= tolerance &&
            Math.Abs(v.Position.Y - clickPoint.Y) <= tolerance);

        if (clickedVertex != null)
        {
            // CAS 1 : Clic droit sur un point -> Supprime UNIQUEMENT ce point
            Link.Vertices.Remove(clickedVertex);
            Link.Refresh();
        }
        else
        {
            // CAS 2 : Clic droit sur le câble -> Supprime la courbe entière
            Diagram.Links.Remove(Link);
        }
    }


}