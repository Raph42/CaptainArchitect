@* injecter le style stroke en ligne directement avec la couleur de la ressource *@

@using Blazor.Diagrams.Components.Renderers
@using Blazor.Diagrams.Core
@using Blazor.Diagrams.Core.Anchors
@using Blazor.Diagrams.Core.Geometry
@using Blazor.Diagrams.Core.Models
@using CaptainArchitect.Models
@* pour les dialogues MudBlazor *@
@using MudBlazor
@* service de fenêtre de confirmation *@
@inject IDialogService DialogService
@inherits LinkWidget


<!--
    Conteneur global SVG du lien.
    - @onpointerdown : sélectionne uniquement CETTE courbe dès qu'on clique dessus, sur sa pastille ou sur un point.
    - @ondblclick : ajoute un point de passage.
    - @oncontextmenu : supprime un point ou le tuyau complet.
-->
<g class="resource-link @(Link.Selected ? "selected" : "")"
   style="@StyleString"
   @onpointerdown="OnLinkPointerDown"
   @ondblclick="OnDoubleClick"
   @oncontextmenu="OnRightClick"
   @oncontextmenu:preventDefault="true">

    <!-- Infobulle native au survol du câble -->
    <title>Double-clic : ajouter un point | Clic droit : supprimer un point ou le tuyau</title>

    <!-- Rendu SVG natif généré par Blazor.Diagrams -->
    @base.BuildRenderTree

    <!-- =========================================================================
         1. PASTILLE DE DÉBIT INTERACTIVE
         ========================================================================= -->
    @if (BadgePosition != null && ResLink != null && (ResLink.FlowRate > 0 || ResLink.MaxFlowRate > 0))
    {
        <!-- 
            - pointer-events="all" : capture le clic gauche et le glisser-déposer sur la pastille.
            - @oncontextmenu : clic droit sur la pastille appelle OnBadgeRightClick (qui ne supprime que ce point).
        -->
        <g class="flow-badge-group @(_isDraggingBadge ? "dragging" : "")"
           transform="translate(@BadgePosition.X.ToString(System.Globalization.CultureInfo.InvariantCulture), @BadgePosition.Y.ToString(System.Globalization.CultureInfo.InvariantCulture))"
           pointer-events="all"
           @onpointerdown="OnBadgePointerDown"
           @onpointerdown:stopPropagation="true"
           @oncontextmenu="OnBadgeRightClick"
           @oncontextmenu:stopPropagation="true"
           @oncontextmenu:preventDefault="true">

            <!-- Fond arrondi de la pastille -->
            <rect x="-29" y="-17" width="58" height="20" rx="7" class="flow-badge-bg" />

            <!--
                Bloc texte centré verticalement :
                - Ligne 1 : Débit circulant réel (ex: 24/m)
                - Ligne 2 (dy="1.25em", x="0") : Saut de ligne pour afficher max: 36/m
            -->
            <text x="0" y="-3" text-anchor="middle" class="flow-badge-text">
                <!-- Ligne 1 : Débit réel -->
                <tspan x="0" class="flow-badge-val">@(ResLink.FlowRate.ToString("0.#"))/m</tspan>

                <!-- Ligne 2 : Retour à la ligne avec décalage dy
                <tspan x="0" dy="1.25em" class="flow-badge-max">
                    max @(ResLink.MaxFlowRate.ToString("0.#"))/m
                </tspan>
                -->
            </text>


        </g>
    }

    <!-- =========================================================================
         2. CALQUE DE CAPTURE DE SOURIS (Pendant le glissement)
         ========================================================================= -->
    @if (_isDraggingBadge)
    {
        <rect class="drag-capture-overlay"
              x="-50000" y="-50000" width="100000" height="100000"
              fill="transparent"
              pointer-events="all"
              style="cursor: grabbing;"
              @onpointermove="OnDragMove"
              @onpointerup="OnDragUp"
              @onpointercancel="OnDragUp"
              @onclick:stopPropagation="true"
              @onpointerdown:stopPropagation="true" />
    }

</g>

<style>
    /* 1. STYLE DU CÂBLE / TUYAU SVG */
    .resource-link path {
        stroke: var(--link-color, #38bdf8) !important;
        stroke-width: 8px !important;
        stroke-linecap: round !important;
        stroke-linejoin: round !important;
        fill: none !important;
        cursor: crosshair !important;
        pointer-events: stroke !important;
        transition: stroke-width 0.15s ease;
    }

    .resource-link path:hover {
        stroke-width: 11px !important;
    }

    /* Style quand la courbe est sélectionnée */
    .resource-link.selected path {
        stroke: #fbbf24 !important; /* Jaune doré de sélection */
        stroke-width: 12px !important;
    }

    /* Met aussi en évidence la pastille quand la courbe est sélectionnée */
    .resource-link.selected .flow-badge-bg {
        stroke: #fbbf24 !important;
        stroke-width: 2.2px !important;
    }

    /* 2. MASQUAGE DES POIGNÉES NATIVES (Seule la pastille sert de repère) */
    ::deep .diagram-vertex,
    .resource-link ::deep .diagram-vertex,
    .resource-link ::deep circle,
    .diagram-vertex {
        display: none !important;
        visibility: hidden !important;
        opacity: 0 !important;
        pointer-events: none !important;
    }

    /* 3. PASTILLE INDICATRICE DE DÉBIT INTERACTIVE */
    .flow-badge-group {
        cursor: grab !important;
    }

    .flow-badge-group.dragging {
        cursor: grabbing !important;
    }

    .flow-badge-bg {
        fill: #18181b !important;
        stroke: var(--link-color, #38bdf8) !important;
        stroke-width: 1.5px !important;
        filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.7));
        transition: stroke-width 0.1s ease;
    }

    .flow-badge-group:hover .flow-badge-bg {
        stroke-width: 2.2px !important;
        stroke: #fbbf24 !important;
    }

    .flow-badge-text {
        font-family: ui-sans-serif, system-ui, -apple-system, sans-serif !important;
        user-select: none !important;
        pointer-events: none;
    }

    .flow-badge-val {
        font-size: 10px !important;
        font-weight: 800 !important;
        fill: #f4f4f5 !important;
    }

    .flow-badge-max {
        font-size: 8.5px !important;
        font-weight: 700 !important;
        fill: #a1a1aa !important;
    }
</style>

@code {
    [CascadingParameter] public BlazorDiagram Diagram { get; set; } = default!;

    // Cast typé vers le modèle de lien personnalisé
    private ResourceLinkModel? ResLink => Link as ResourceLinkModel;

    // Détermine la couleur hexadécimale de la ressource ou bleu par défaut
    private string StyleString => Link is ResourceLinkModel resLink && !string.IsNullOrWhiteSpace(resLink.Color)
        ? $"--link-color: {resLink.Color};"
        : "--link-color: #38bdf8;";

    // Variables pour le déplacement à la souris de la pastille
    private bool _isDraggingBadge = false;
    private LinkVertexModel? _dragVertex = null;

    private Point? BadgePosition
    {
        get
        {
            if (Link == null) return null;

            if (_dragVertex != null)
            {
                return _dragVertex.Position;
            }

            if (Link.Vertices.Count > 0)
            {
                return Link.Vertices[Link.Vertices.Count / 2].Position;
            }

            return GetDefaultMidPoint();
        }
    }


    // =========================================================================
    // 1. SÉLECTION PROPRE AU CLIC SOURIS (Sans boucle infinie)
    // =========================================================================
    /// <summary>
    /// Déclenché uniquement lorsqu'un clic gauche physique a lieu sur le câble ou un de ses points.
    /// </summary>
    private void OnLinkPointerDown(PointerEventArgs e)
    {
        if (e.Button == 0 && Diagram != null && Link != null && !Link.Selected)
        {
            Diagram.SelectModel(Link, unselectOthers: true);
        }
    }

    // =========================================================================
    // DÉPLACEMENT DE LA PASTILLE ET DU POINT
    // =========================================================================
    private void OnBadgePointerDown(PointerEventArgs e)
    {
        if (Diagram == null || Link == null) return;
        if (e.Button != 0) return; // Uniquement clic gauche

        // 1. Sélectionne immédiatement la courbe lorsqu'on attrape la pastille[cite: 2]
        if (!Link.Selected)
        {
            Diagram.SelectModel(Link, unselectOthers: true);
        }

        _isDraggingBadge = true;
        var canvasPoint = Diagram.GetRelativeMousePoint(e.ClientX, e.ClientY);

        if (Link.Vertices.Count == 0)
        {
            _dragVertex = new LinkVertexModel(Link, canvasPoint);
            Link.Vertices.Add(_dragVertex);
        }
        else
        {
            // Trouve le sommet le plus proche du clic pour le déplacer
            _dragVertex = Link.Vertices
                .OrderBy(v => Math.Pow(v.Position.X - canvasPoint.X, 2) + Math.Pow(v.Position.Y - canvasPoint.Y, 2))
                .FirstOrDefault() ?? Link.Vertices[Link.Vertices.Count / 2];

            _dragVertex.SetPosition(canvasPoint.X, canvasPoint.Y);
        }

        Link.Refresh();
    }

    private void OnDragMove(PointerEventArgs e)
    {
        if (!_isDraggingBadge || _dragVertex == null || Diagram == null) return;

        if (e.Buttons == 0)
        {
            OnDragUp(e);
            return;
        }

        var newPoint = Diagram.GetRelativeMousePoint(e.ClientX, e.ClientY);
        _dragVertex.SetPosition(newPoint.X, newPoint.Y);
        Link.Refresh();
    }

    private void OnDragUp(PointerEventArgs e)
    {
        if (_isDraggingBadge)
        {
            _isDraggingBadge = false;
            _dragVertex = null;
            Link.Refresh();
        }
    }

    // =========================================================================
    // GESTION DU CLIC DROIT : SUPPRESSION D'UN POINT UNIQUE OU DU CÂBLE
    // =========================================================================

    // 1. Clic droit direct sur la pastille : supprime UNIQUEMENT le point sous la pastille
    private void OnBadgeRightClick(MouseEventArgs e)
    {
        if (Link == null || Link.Vertices.Count == 0) return;

        var clickPoint = Diagram.GetRelativeMousePoint(e.ClientX, e.ClientY);

        // Trouve le sommet le plus proche sous la pastille
        var nearestVertex = Link.Vertices
            .OrderBy(v => Math.Pow(v.Position.X - clickPoint.X, 2) + Math.Pow(v.Position.Y - clickPoint.Y, 2))
            .FirstOrDefault();

        if (nearestVertex != null)
        {
            // SUPPRIME UNIQUEMENT CE POINT (pas tous les points !)
            Link.Vertices.Remove(nearestVertex);
            _dragVertex = null;
            Link.Refresh();
        }
    }


    // ============================================================================
    // GESTION DU CLIC DROIT : Suppression d'un point OU confirmation pour le tuyau
    // =============================================================================
    private async Task OnRightClick(MouseEventArgs e)
    {
        if (Diagram == null || Link == null) return;

        // 1. Récupère la position du clic droit dans les coordonnées du diagramme
        var clickPoint = Diagram.GetRelativeMousePoint(e.ClientX, e.ClientY);

        // Rayon de détection confortable (28px) pour attraper un point sans le rater
        const double toleranceDistanceSq = 28.0 * 28.0;

        LinkVertexModel? clickedVertex = null;
        double minDistanceSq = double.MaxValue;

        // 2. Recherche si le clic droit a eu lieu sur un point de passage existant
        foreach (var v in Link.Vertices)
        {
            double distSq = Math.Pow(v.Position.X - clickPoint.X, 2) + Math.Pow(v.Position.Y - clickPoint.Y, 2);
            if (distSq <= toleranceDistanceSq && distSq < minDistanceSq)
            {
                minDistanceSq = distSq;
                clickedVertex = v;
            }
        }

        if (clickedVertex != null)
        {
            // CAS 1 : Un point a été cliqué -> Supprime UNIQUEMENT ce point précis
            Link.Vertices.Remove(clickedVertex);
            if (_dragVertex == clickedVertex)
            {
                _dragVertex = null;
            }
            Link.Refresh();
        }
        else
        {
            // CAS 2 : Clic droit sur le tuyau -> Ouvre la fenêtre de confirmation
            bool? confirm = await DialogService.ShowMessageBoxAsync(
                title: "Remove the link",
                message: "Do you really want to delete this link?",
                yesText: "Delete",
                cancelText: "Cancel"
            );

            // Si l'utilisateur a cliqué sur "Supprimer" (confirm == true), on retire le lien
            if (confirm == true)
            {
                Diagram.Links.Remove(Link);
            }
        }
    }

    // =========================================================================
    // POINT MILIEU PAR DÉFAUT
    // =========================================================================
    private Point? GetDefaultMidPoint()
    {
        var src = Link.Source.GetPosition(Link)
               ?? (Link.Source as SinglePortAnchor)?.Port.MiddlePosition;
        var tgt = Link.Target?.GetPosition(Link)
               ?? (Link.Target as SinglePortAnchor)?.Port.MiddlePosition;

        if (src == null || tgt == null) return null;

        return new Point((src.X + tgt.X) / 2.0, (src.Y + tgt.Y) / 2.0);
    }

    // =========================================================================
    // DOUBLE-CLIC : AJOUT DU POINT AU BON SEGMENT
    // =========================================================================
    private void OnDoubleClick(MouseEventArgs e)
    {
        if (Diagram == null || Link == null) return;

        var clickPoint = Diagram.GetRelativeMousePoint(e.ClientX, e.ClientY);

        if (Link.Vertices.Count == 0)
        {
            Link.Vertices.Add(new LinkVertexModel(Link, clickPoint));
            Link.Refresh();
            return;
        }

        var allPoints = new List<Point>();
        var sourcePos = Link.Source.GetPosition(Link)
                     ?? (Link.Source as SinglePortAnchor)?.Port.MiddlePosition
                     ?? clickPoint;
        allPoints.Add(sourcePos);

        foreach (var v in Link.Vertices)
        {
            allPoints.Add(v.Position);
        }

        var targetPos = Link.Target?.GetPosition(Link)
                     ?? (Link.Target as SinglePortAnchor)?.Port.MiddlePosition
                     ?? sourcePos;
        allPoints.Add(targetPos);

        int bestSegmentIndex = 0;
        double minDistance = double.MaxValue;

        for (int i = 0; i < allPoints.Count - 1; i++)
        {
            double dist = DistanceToSegment(clickPoint, allPoints[i], allPoints[i + 1]);
            if (dist < minDistance)
            {
                minDistance = dist;
                bestSegmentIndex = i;
            }
        }

        int insertIndex = Math.Clamp(bestSegmentIndex, 0, Link.Vertices.Count);
        Link.Vertices.Insert(insertIndex, new LinkVertexModel(Link, clickPoint));
        Link.Refresh();
    }

    private double DistanceToSegment(Point p, Point a, Point b)
    {
        double dx = b.X - a.X;
        double dy = b.Y - a.Y;
        double lengthSquared = dx * dx + dy * dy;

        if (lengthSquared == 0)
        {
            double diffX = p.X - a.X;
            double diffY = p.Y - a.Y;
            return Math.Sqrt(diffX * diffX + diffY * diffY);
        }

        double t = Math.Max(0, Math.Min(1, ((p.X - a.X) * dx + (p.Y - a.Y) * dy) / lengthSquared));
        double projX = a.X + t * dx;
        double projY = a.Y + t * dy;

        double deltaX = p.X - projX;
        double deltaY = p.Y - projY;

        return Math.Sqrt(deltaX * deltaX + deltaY * deltaY);
    }


}