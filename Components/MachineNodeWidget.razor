<!--
Pour que le diagramme sache qu'il doit utiliser MachineNodeWidget
chaque fois qu'il rencontre un MachineNodeModel, on l'enregistre dans le composant
d'enregistrement de Blazor.Diagrams.

Dans Pages/Home.razor 
     Diagram.RegisterComponent<MachineNodeModel, MachineNodeWidget>();
-->

@using MudBlazor
@using Blazor.Diagrams.Components.Renderers
@using Blazor.Diagrams.Core
@using CaptainArchitect.Models
@using CaptainArchitect.Services
@inject ResourceService ResourceService


<div class="machine-card @(Node.Selected ? "selected" : "") @(Node.IsPaused ? "is-paused" : "")"

    @oncontextmenu="OnRightClick" 
    @oncontextmenu:preventDefault="true">

    <!-- Bandeau bien visible quand la machine est arrêtée -->
    @if (Node.IsPaused)
    {
        <div class="pause-banner">
            <span>⏸ PAUSED</span>
        </div>
    }

    <!-- En-tête : Nom de la machine + Boutons Upgrade/Downgrade à gauche, Contrôles Multiplier + Bouton Pause + Croix à droite -->

    <div class="machine-header">
        <div class="d-flex align-center gap-1">

            <!-- Nom de la machine (au lieu du nom de la recette) -->
            <span class="machine-title @GetMachineTierClass()" title="@MachineDisplayName (@Node.Recipe.RecipeId)">
                @MachineDisplayName
            </span>

            <!-- Boutons Upgrade / Downgrade si plusieurs machines existent pour cette recette -->
            @if (Node.Recipe.MachineBindings != null && Node.Recipe.MachineBindings.Count > 1)
            {
                <div class="tier-controls">
                    <!-- Rétrograder (machine de palier inférieur) -->
                    <button class="btn-tier" 
                            disabled="@(!Node.CanDowngrade)" 
                            title="Rétrograder la machine" 
                            @onclick="DowngradeMachine">▼</button>

                    <!-- Améliorer (machine de palier supérieur) -->
                    <button class="btn-tier" 
                            disabled="@(!Node.CanUpgrade)" 
                            title="Améliorer la machine" 
                            @onclick="UpgradeMachine">▲</button>
                </div>
            }

        </div>

        <!-- Conteneur poussé tout à droite -->
        <div class="header-actions">
            <!-- 1. Multiplicateur de bâtiments -->
            <div class="multiplier-controls">
                <button class="btn-step" @onclick="DecreaseCount">-</button>
                <span class="multiplier-count">@Node.Multiplier.ToString("0.##")x</span>
                <button class="btn-step" @onclick="IncreaseCount">+</button>
            </div>


            <!-- BOUTON PAUSE / REPRISE -->
            <button class="btn-pause @(Node.IsPaused ? "active" : "")" 
                    title="@(Node.IsPaused ? "Reprendre la production" : "Mettre en pause")" 
                    @onclick="TogglePause"
                    @onclick:stopPropagation="true">
                @if (Node.IsPaused)
                {
                    <!-- Icône Reprendre (Play) -->
                    <span>▶</span>
                }
                else
                {
                    <!-- Icône Pause -->
                    <span>⏸</span>
                }
            </button>


            <!-- 2. Croix rouge immédiatement à sa droite Bouton supprimer -->
            <button class="btn-delete" title="Supprimer la machine" @onclick="DeleteNode">✕</button>
        </div>
    </div>

    <!-- Corps : Entrées à gauche, Icône Machine au centre, Sorties à droite -->
    <div class="machine-body">

        <!-- Colonne Entrées avec boutons flèches ▲ / ▼ -->
        <div class="port-column inputs">

            @for (int i = 0; i < Node.Recipe.Inputs.Count; i++)
            {
                var index = i; // Copie locale pour la closure des boutons
                var input = Node.Recipe.Inputs[index];
                var port = Node.Ports.ElementAtOrDefault(index) as ResourcePortModel;

                if (port != null)
                {
                    var theoreticalRate = Node.GetInputRatePerMin(input);
                    var actualRate = Node.GetActualInputRate(port.Id);
                    var hasLinks = port.Links.Count > 0;
                    var diff = actualRate - theoreticalRate;

                    // Statut couleur :
                    // Rouge si sous-alimenté (< -0.01), Vert si équilibré, Grisé si non relié
                    var statusClass = !hasLinks ? "rate-unlinked"
                                    : (diff < -0.01m) ? "rate-warning"
                                    : "rate-ok";

                    <!-- key="port.Id" force Blazor à déplacer le port avec son identifiant exact -->
                    <div class="port-row input-row" @key="port.Id">

                        <!-- Port rond de connexion -->
                        <PortRenderer Port="port" Class="diagram-port" />

                        <!-- Icône badge de la ressource -->
                        <ResourceBadge ProductId="@input.ProductId" Direction="PortDirection.Input" />

                        <!-- Petit groupe de flèches pour inverser les entrées (affiché s'il y a plus d'1 entrée) -->
                        @if (Node.Recipe.Inputs.Count > 1)
                        {
                            <div class="port-swap-controls">
                                <!-- Monter l'entrée (▲) -->
                                <button class="btn-port-swap" 
                                        disabled="@(!Node.CanMoveInputUp(index))" 
                                        title="Monter cette entrée"
                                        @onclick="() => MoveInputUp(index)"
                                        @onclick:stopPropagation="true">▲</button>

                                <!-- Descendre l'entrée (▼) -->
                                <button class="btn-port-swap" 
                                        disabled="@(!Node.CanMoveInputDown(index))" 
                                        title="Descendre cette entrée"
                                        @onclick="() => MoveInputDown(index)"
                                        @onclick:stopPropagation="true">▼</button>
                            </div>
                        }

                        <!-- Pile de débits (lignes 1, 2, 3) -->
                        <div class="rate-stack">
                            @* Ligne 1 : Débit théorique total + Débit de base si Multiplier > 1 *@

                            <span class="rate-theoretical" title="Theoretical flow rate required by the recipe">
                                @theoreticalRate.ToString("0.#")/m
                                @if (Node.Multiplier > 1m)
                                {
                                    <span class="rate-base">(@Node.GetBaseInputRatePerMin(input).ToString("0.#"))</span>
                                }
                            </span>

                            @if (hasLinks)
                            {
                                @* Ligne 2 : Débit actuel réel *@
                                <span class="rate-actual @statusClass" title="Actual quantity received from connected pipes">
                                    @actualRate.ToString("0.#")/m</span>

                                @* Ligne 3 : Manque ou Équilibre *@
                                <span class="rate-diff @statusClass" title="Gap to be filled">
                                    @if (diff < -0.01m)
                                    {
                                        <span>@diff.ToString("0.#")/m</span>
                                    }
                                    else
                                    {
                                        <span>0/m</span>
                                    }
                                </span>
                            }
                        </div>
                    </div>
                }

            }
        </div>


        <!-- Centre : Efficacité en pourcentage + Icône machine -->
        <div class="machine-center-icon">

            @* Calcul du pourcentage d'efficacité réelle (OperationalEfficiency allant de 0 à 1) *@
            @{
                var effPct = Math.Round(Node.OperationalEfficiency * 100m, 0);

                // Classe de couleur dynamique selon le rendement :
                // - Vert si 100% (tourne à plein régime)
                // - Rouge si < 100% (goulot d'étranglement ou sous-alimenté)
                // - Grisé si à l'arrêt complet (0%)
                var effClass = effPct >= 100m ? "eff-ok" 
                             : effPct > 0m ? "eff-warning" 
                             : "eff-zero";
            }

            <!-- Badge d'efficacité positionné AU-DESSUS de l'icône -->
            <span class="machine-efficiency-badge @effClass" 
                  title="Real Efficiency: @effPct% (based on the sourcing of inputs)">
                @effPct%
            </span>

            <!-- Icône du bâtiment -->
            <MudTooltip Text="@MachineTooltip" Arrow="true" Placement="Placement.Top">
                <div class="building-icon-wrapper">
                    <img src="@MachineImagePath" 
                         alt="@MachineTooltip" 
                         class="building-icon"
                         draggable="false"
                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                    <div class="building-fallback" style="display:none;">
                        <MudIcon Icon="@Icons.Material.Filled.Factory" Size="MudBlazor.Size.Medium" Color="Color.Default" />
                    </div>
                </div>
            </MudTooltip>

        </div>


        <!-- Colonne Sorties avec boutons flèches ▲ / ▼ -->
        <div class="port-column outputs">

            @for (int i = 0; i < Node.Recipe.Outputs.Count; i++)
            {
                var index = i; // Copie locale pour la closure des boutons
                var output = Node.Recipe.Outputs[index];

                //var port = Node.Ports[Node.Recipe.Inputs.Count + i] as ResourcePortModel;

                // Récupération sécurisée du port de sortie par son index relatif aux sorties
               @*  var port = Node.Ports.Where(p => p is ResourcePortModel rp && rp.Direction == PortDirection.Output)
                                     .ElementAtOrDefault(index) as ResourcePortModel; *@
                
                // On peut faire correspondre directement la ressource de la recette avec le port
                // correspondant à cette même ressource et dans la bonne direction (Output)
                var port = Node.Ports.OfType<ResourcePortModel>()
                                     .FirstOrDefault(p => p.Direction == PortDirection.Output && p.ProductId == output.ProductId);

                if (port != null)
                {
                    var theoreticalRate = Node.GetOutputRatePerMin(output);
                    var actualProduced = Node.GetActualProducedRatePerMin(output); // Production réelle (prend en compte le manque d'entrées)
                    var distributedRate = Node.GetDistributedOutputRate(port.Id);
                    var downstreamDemand = Node.GetDownstreamDemandRate(port.Id);
                    var hasLinks = port.Links.Count > 0;

                    // Bilan : ce qu'on produit réellement moins ce que demande l'aval
                    var balance = actualProduced - downstreamDemand;

                    // Calcul du pourcentage d'efficacité de cette sortie (0% à 100%)
                    // Si le débit théorique est nul, on évite la division par zéro
                    var effPercent = theoreticalRate > 0 
                        ? Math.Round((actualProduced / theoreticalRate) * 100m, 0) 
                        : 100m;

                    // Statut couleur :
                    // - Gris si non connecté
                    // - Rouge si déficit
                    // - Vert ou Bleu/Cyan si surplus ou équilibré
                    var statusClass = !hasLinks ? "rate-unlinked"
                                    : (balance < -0.01m) ? "rate-warning"
                                    : (balance > 0.01m) ? "rate-surplus"
                                    : "rate-ok";

                    <!-- key="port.Id" force Blazor à déplacer physiquement le port avec son identifiant exact -->
                    <div class="port-row output-row" @key="port.Id">

                        <!-- Pile de débits (alignée à droite) -->
                        <div class="rate-stack text-right">

                            @* Ligne 1 : Débit théorique total (Gris) + Débit de base unitaire si Multiplier > 1 *@
                            <span class="rate-theoretical" title="Nominal theoretical capacity">
                                @if (Node.Multiplier > 1m)
                                {
                                    <span class="rate-base">(@Node.GetBaseOutputRatePerMin(output).ToString("0.#")) </span>
                                }
                                @theoreticalRate.ToString("0.#")/m
                            </span>


                            @* Ligne 2 : Toujours affichée (affiche 0/m en gris si non connecté, ou le débit réel distribué) *@
                            <span class="rate-actual @statusClass" title="Flow distributed (Efficiency : @effPercent%)">
                                @*  @(hasLinks ? distributedRate.ToString("0.#") : "0")/m  *@
                                @((hasLinks ? distributedRate : actualProduced).ToString("0.#"))/m

                            </span>


                            @if (hasLinks)
                            {
                                @* Ligne 3 : Manque / Surplus (affiché uniquement lorsqu'un tuyau est branché) *@
                                <span class="rate-diff @statusClass" title="Available surplus">
                                    @if (balance > 0.01m)
                                    {
                                        <span>+@balance.ToString("0.#")/m</span>
                                    }
                                    else if (balance < -0.01m)
                                    {
                                        <span>@balance.ToString("0.#")/m</span>
                                    }
                                    else
                                    {
                                        <span>0/m</span>
                                    }
                                </span>
                            }
                        </div>

                        <!-- Groupe de flèches pour inverser les sorties (affiché s'il y a plus d'1 sortie) -->
                        @if (Node.Recipe.Outputs.Count > 1)
                        {
                            <div class="port-swap-controls">
                                <!-- Monter la sortie (▲) -->
                                <button class="btn-port-swap" 
                                        disabled="@(!Node.CanMoveOutputUp(index))" 
                                        title="Monter cette sortie" 
                                        @onclick="() => MoveOutputUp(index)" 
                                        @onclick:stopPropagation="true">▲</button>

                                <!-- Descendre la sortie (▼) -->
                                <button class="btn-port-swap" 
                                        disabled="@(!Node.CanMoveOutputDown(index))" 
                                        title="Descendre cette sortie" 
                                        @onclick="() => MoveOutputDown(index)" 
                                        @onclick:stopPropagation="true">▼</button>
                            </div>
                        }

                        <!-- Icône badge de la ressource en sortie -->
                        <ResourceBadge ProductId="@output.ProductId" Direction="PortDirection.Output" />

                        <!-- Port rond de connexion -->
                        <PortRenderer Port="port" Class="diagram-port" />

                    </div>
                }
            }
        </div>
    </div>
</div>

<style>
    /* 1. Largeur STRICTEMENT FIXE pour la carte de la machine */
    .machine-card {
        width: 350px !important; /* Largeur fixe garantie (ajuste à 340px ou 350px si besoin) */
        min-width: 350px !important;
        max-width: 350px !important;
        box-sizing: border-box;
        background: #2b2b2b;
        border: 2px solid #3f3f46;
        border-radius: 8px;
        color: #f4f4f5;
        font-family: sans-serif;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.4);
        user-select: none;
    }

    .machine-card.selected {
        border-color: #3b82f6;
    }

    .machine-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #1f1f23;
        padding: 6px 10px;
        border-top-left-radius: 6px;
        border-top-right-radius: 6px;
        border-bottom: 1px solid #3f3f46;
    }

    .machine-title {
        font-weight: 600;
        font-size: 0.82rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        max-width: 140px;
    }

    /* 2. Organisation du corps de la machine */
    .machine-body {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 0;
        box-sizing: border-box;
        width: 100%;
    }

    /* Style des boutons Upgrade / Downgrade */
    /* Conteneur des flèches : décalé vers la droite avec une marge gauche */
    .tier-controls {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        background: #18181b;
        border: 1px solid #3f3f46;
        border-radius: 4px;
        padding: 2px 3px;
        margin-left: 8px;
    }

    .btn-tier {
        background: transparent;
        color: #38bdf8;
        border: none;
        cursor: pointer;
        font-size: 0.80rem;
        line-height: 1;
        width: 18px;      
        height: 20px;     
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border-radius: 3px;
        transition: background 0.15s, color 0.15s;
    }

    .btn-tier:hover:not(:disabled) {
        background: #38bdf822;
        color: #7dd3fc;
    }

    .btn-tier:disabled {
        color: #52525b;
        cursor: not-allowed;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 8px; /* Espace net entre le sélecteur et la croix */
        margin-left: auto; /* Force l'alignement tout à droite */
    }

    .multiplier-controls {
        display: flex;
        align-items: center;
        gap: 6px;
        background: #27272a;
        padding: 2px 4px;
        border-radius: 4px;
        border: 1px solid #3f3f46;
    }

    .btn-step {
        background: #3f3f46;
        border: none;
        color: white;
        border-radius: 4px;
        width: 20px;
        height: 20px;
        line-height: 18px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
    }

    .btn-step:hover {
        background: #52525b;
    }

    .btn-delete {
        background: transparent;
        border: none;
        color: #ef4444;
        font-size: 1rem;
        font-weight: bold;
        cursor: pointer;
        width: 22px;
        height: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 4px;
        line-height: 1;
        padding: 0;
    }

    .btn-delete:hover {
        background: rgba(239, 68, 68, 0.2);
        color: #f87171;
    }

    .multiplier-count {
        font-size: 0.8rem;
        min-width: 32px;
        text-align: center;
        color: #60a5fa;
    }

    /* 3. Colonnes d'entrées et de sorties : LARGEUR STRICTE ET IDENTIQUE */
    .port-column {
        display: flex;
        flex-direction: column;
        gap: 8px;
        width: 130px !important; /* Largeur fixe identique à gauche et à droite */
        min-width: 130px !important;
        max-width: 130px !important;
        flex-shrink: 0; /* Interdiction formelle de rétrécir */
        box-sizing: border-box;
    }

    .port-column.inputs {
        padding-left: 0;
    }

    .port-column.outputs {
        padding-right: 0;
    }

    /* 4. Les lignes de ports */
    .port-row {
        display: flex;
        align-items: center;
        gap: 6px;
        width: 100%;
        box-sizing: border-box;
    }

    .input-row {
        padding-left: 0;
    }

    .output-row {
        justify-content: flex-end;
    }

    .diagram-port {
        width: 12px !important;
        height: 12px !important;
        min-width: 12px !important;
        min-height: 12px !important;
        flex-shrink: 0 !important; /* Empêche le conteneur flex d'écraser le rond */
        background: #3b82f6;
        border: 2px solid #ffffff;
        border-radius: 50%;
        cursor: crosshair;
        box-sizing: border-box;
    }

    /* Centre : empile verticalement le badge d'efficacité et l'icône */
    .machine-center-icon {
        display: flex;
        flex-direction: column; /* Empilement vertical */
        align-items: center;
        justify-content: center;
        gap: 3px;               /* Espace entre le badge et le haut de l'image */
        flex: 1;
        min-width: 60px;
        flex-shrink: 0;
    }

    /* Badge de pourcentage d'efficacité au-dessus de l'icône */
    .machine-efficiency-badge {
        font-size: 0.70rem;
        font-weight: 700;
        line-height: 1;
        padding: 1px 6px;
        border-radius: 4px;
        letter-spacing: 0.3px;
        user-select: none;
    }

    /* Couleurs selon l'état d'efficacité */
    .machine-efficiency-badge.eff-ok {
        color: #4ade80;                      /* Vert */
        background: rgba(74, 222, 128, 0.15); /* Léger halo vert */
    }

    .machine-efficiency-badge.eff-warning {
        color: #f87171;                      /* Rouge (goulot d'étranglement) */
        background: rgba(248, 113, 113, 0.15);
    }

    .machine-efficiency-badge.eff-zero {
        color: #9ca3af;                      /* Gris neutre */
        background: rgba(156, 163, 175, 0.15);
    }

    .building-icon-wrapper {
        width: 60px;  /* Augmenté (ex: de 44px à 60px) */
        height: 60px; /* Augmenté (ex: de 44px à 60px) */
        background: #202022;
        border: 1px solid #3f3f46;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 4px;
        user-select: none;          /*     */
        -webkit-user-drag: none;    /*     */
    }

    .building-icon {
        width: 100%;
        height: 100%;
        object-fit: contain;
        pointer-events: none;       /* Empêche l'image de capturer le clic */
        -webkit-user-drag: none;    /* Désactive le glisser natif sous Chrome/Edge/Safari */
        user-select: none;
    }

    .building-fallback {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: none;       /* Empêche l'icône de secours de capturer le clic */
    }

    /* 5. Conteneur de débit */
    .rate-stack {
        display: flex;
        flex-direction: column;
        justify-content: center;
        line-height: 1.15;
        white-space: nowrap !important;
        width: 68px; /* Assez large pour les chiffres à virgule ex: "(12) 36/m" */
        min-width: 68px;
        flex-shrink: 0;
        font-size: 0.72rem;
    }

    .text-right {
        text-align: right;
        align-items: flex-end;
    }

    /* Ligne 1 : Débit théorique (Gris) */
    .rate-theoretical {
        color: #9ca3af !important; /* Gris clair neutre */
        font-size: 0.70rem;
        white-space: nowrap !important; /* Empêche tout retour à la ligne automatique */
    }

    .rate-base {
        color: #6b7280;
        font-size: 0.72rem;
        font-weight: normal;
        opacity: 0.85;
    }

    /* Ligne 2 : Débit actuel réel */
    .rate-actual {
        font-size: 0.72rem;
        font-weight: normal;
        white-space: nowrap !important; /* Empêche tout retour à la ligne automatique */
    }

    /* Ligne 3 : Manque ou Équilibre / Surplus */
    .rate-diff {
        font-size: 0.72rem;
        font-weight: normal;
        white-space: nowrap !important; /* Empêche tout retour à la ligne automatique */
    }

    /* --- Codes Couleurs --- */

    /* Vert si équilibré 4ade80 */
    /* bleu/cyan : #38bdf8 */
    .rate-ok {
        color: #4ade80 !important;
    }

    /* Rouge si sous-alimenté / goulot */
    .rate-warning {
        color: #f87171 !important;

        /* Texte légèrement plus grand et plus gras pour ressortir */
        font-size: 0.76rem !important; 
        font-weight: 700 !important;
        
        /* Petit halo lumineux (glow) pour le rendre immédiatement repérable */
        text-shadow: 0 0 6px rgba(255, 0, 136, 0.35);
    }

    /* Si tu veux du vert pour le surplus : mets #4ade80, si tu préfères bleu/cyan : #38bdf8, ou orange : #fb923c */
    .rate-surplus {
        /* Vert néon éclatant très voyant sur fond sombre : #22c55e ou #00ff88 */
        color: #00ff88 !important; 
        
        /* Texte légèrement plus grand et plus gras pour ressortir */
        font-size: 0.76rem !important; 
        font-weight: 700 !important;
        
        /* Petit halo lumineux (glow) pour le rendre immédiatement repérable */
        text-shadow: 0 0 6px rgba(0, 255, 136, 0.35);
    }

    /* Déconnecté (sans liens) */
    .rate-unlinked {
        color: #38bdf8 !important;
    }

    /* Conteneur des petites flèches de réorganisation d'entrées */
    .port-swap-controls {
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1px;
        margin-right: 4px;
        user-select: none;
    }

    /* Boutons flèches ultra-compacts */
    .btn-port-swap {
        background: transparent;
        color: #94a3b8;
        border: none;
        cursor: pointer;
        font-size: 0.55rem;
        line-height: 1;
        width: 12px;
        height: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border-radius: 2px;
        transition: background 0.15s, color 0.15s;
    }

    .btn-port-swap:hover:not(:disabled) {
        background: rgba(56, 189, 248, 0.25);
        color: #38bdf8;
    }

    .btn-port-swap:disabled {
        color: #3f3f46;
        cursor: not-allowed;
        opacity: 0.3;
    }

    /* Couleurs par palier (Tier) pour le titre de la machine */
    .machine-title.tier-1 {
        color: #f4f4f5; /* Blanc cassé / neutre */
    }

