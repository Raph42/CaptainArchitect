@code {
    [CascadingParameter] public BlazorDiagram Diagram { get; set; } = default!;
    [Parameter] public MachineNodeModel Node { get; set; } = default!;


    // Identifiant de la machine sélectionnée
    private string MachineId => Node.CurrentMachineId;

    // Entité Machine correspondante dans le service
    private Machine? CurrentMachine => ResourceService.GetMachine(MachineId);

    // Titre affiché dans l'en-tête (Machine.Name)
    private string MachineDisplayName => CurrentMachine?.Name ?? MachineId;

    private string MachineImagePath
    {
        get
        {
            var path = !string.IsNullOrWhiteSpace(CurrentMachine?.Image)
                ? CurrentMachine.Image
                : $"images/buildings/{MachineId}.png";

            return path.TrimStart('/');
        }
    }

    private string MachineTooltip => CurrentMachine?.Name ?? MachineId;


    private void IncreaseCount()
    {
        Node.Multiplier += 1m;
        //Node.Refresh();
        FlowEngine.RecalculateFlows(Diagram);
    }


    private void DecreaseCount()
    {
        if (Node.Multiplier > 1m)
        {
            Node.Multiplier -= 1m;
            //Node.Refresh();
            FlowEngine.RecalculateFlows(Diagram);
        }
    }


    private void UpgradeMachine()
    {
        if (Node.Upgrade())
        {
            FlowEngine.RecalculateFlows(Diagram);
        }
    }


    private void DowngradeMachine()
    {
        if (Node.Downgrade())
        {
            FlowEngine.RecalculateFlows(Diagram);
        }
    }


    private void DeleteNode()
    {
        Diagram.Nodes.Remove(Node);
    }


    private void OnRightClick()
    {
        //DeleteNode();
    }


    // Déplacement d'une entrée vers le haut
    private async Task MoveInputUp(int index)
    {
        if (Node.CanMoveInputUp(index))
        {
            Node.SwapInputs(index, index - 1);
            FlowEngine.RecalculateFlows(Diagram);
            
            // Laisse un court instant au navigateur pour placer les éléments HTML à leur nouvel endroit
            await Task.Yield();
            
            // Notifie le diagramme pour recalculer et redessiner les courbes des liens
            Diagram.Refresh();
        }
    }


    // Déplacement d'une entrée vers le bas
    private async Task MoveInputDown(int index)
    {
        if (Node.CanMoveInputDown(index))
        {
            Node.SwapInputs(index, index + 1);
            FlowEngine.RecalculateFlows(Diagram);
            
            // Laisse un court instant au navigateur pour placer les éléments HTML à leur nouvel endroit
            await Task.Yield();
            
            // Notifie le diagramme pour recalculer et redessiner les courbes des liens
            Diagram.Refresh();
        }
    }


    // Déplacement d'une sortie vers le haut
    private async Task MoveOutputUp(int index)
    {
        if (Node.CanMoveOutputUp(index))
        {
            Node.SwapOutputs(index, index - 1);
            FlowEngine.RecalculateFlows(Diagram);
            
            // Laisse un cycle de rendu au navigateur pour repositionner les éléments HTML
            await Task.Yield();
            
            // Notifie le diagramme pour recalculer et redessiner les courbes des liens
            Diagram.Refresh();
        }
    }


    // Déplacement d'une sortie vers le bas
    private async Task MoveOutputDown(int index)
    {
        if (Node.CanMoveOutputDown(index))
        {
            Node.SwapOutputs(index, index + 1);
            FlowEngine.RecalculateFlows(Diagram);
            
            // Laisse un cycle de rendu au navigateur pour repositionner les éléments HTML
            await Task.Yield();
            
            // Notifie le diagramme pour recalculer et redessiner les courbes des liens
            Diagram.Refresh();
        }
    }


    /// <summary>
    /// Détermine la classe CSS de couleur en fonction du palier (Tier 1 à 5) de la machine.
    /// </summary>
    private string GetMachineTierClass()
    {
        int tier = DetectMachineTier();
        return $"tier-{tier}";
    }


    /// <summary>
    /// Détecte le palier selon le nom de la machine ou son index dans MachineBindings.
    /// </summary>
    private int DetectMachineTier()
    {
        var name = MachineDisplayName;

        // 1. Détection via chiffres romains / arabes en fin de nom (ex: "Assembly IV", "Mixer II", "T3")
        if (name.EndsWith(" V", StringComparison.OrdinalIgnoreCase) || name.EndsWith(" 5") || name.EndsWith("T5", StringComparison.OrdinalIgnoreCase))
            return 5;
        if (name.EndsWith(" IV", StringComparison.OrdinalIgnoreCase) || name.EndsWith(" 4") || name.EndsWith("T4", StringComparison.OrdinalIgnoreCase))
            return 4;
        if (name.EndsWith(" III", StringComparison.OrdinalIgnoreCase) || name.EndsWith(" 3") || name.EndsWith("T3", StringComparison.OrdinalIgnoreCase))
            return 3;
        if (name.EndsWith(" II", StringComparison.OrdinalIgnoreCase) || name.EndsWith(" 2") || name.EndsWith("T2", StringComparison.OrdinalIgnoreCase))
            return 2;

        // 2. Détection de secours : via l'index de machine dans la recette (ex: machine 0 = T1, machine 1 = T2...)
        if (Node.Recipe.MachineBindings != null && Node.Recipe.MachineBindings.Count > 1)
        {
            return Math.Clamp(Node.CurrentBindingIndex + 1, 1, 5);
        }

        // Tier 1 par défaut
        return 1;
    }


    // Bascule l'état de pause et recalcule immédiatement les flux
    private void TogglePause()
    {
        Node.IsPaused = !Node.IsPaused;
        FlowEngine.RecalculateFlows(Diagram);
    }


}